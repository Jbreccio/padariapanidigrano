/* ================= VATICAN NEWS ================= */
function parseRSS(xml) {
  const items=[];
  const itemMatches=xml.matchAll(/<item>([\s\S]*?)<\/item>/g);
  for (const match of itemMatches) {
    if (items.length>=12) break;
    const itemXml=match[1];
    const getTag=(tagName)=>{ const regex=new RegExp(`<${tagName}>([\\s\\S]*?)</${tagName}>`); const m=itemXml.match(regex); return m?cleanText(m[1]):''; };
    const title=getTag('title'); const link=getTag('link'); const description=getTag('description'); const pubDate=getTag('pubDate')||new Date().toISOString();
    if (title&&link) items.push({ id:`vatican_${Date.now()}_${items.length}`, title, link:link.trim(), description:description.substring(0,180)+'...', pubDate, author:"Vatican News", category:"Noticias" });
  }
  return items;
}

function categorizeNews(items) {
  return items.map(item=>{
    let category="Noticias";
    const lowerTitle=item.title.toLowerCase();
    const lowerLink=item.link.toLowerCase();
    if (lowerLink.includes('/papa/')||lowerTitle.includes('papa')) category="Papa Francisco";
    else if (lowerLink.includes('/cultura/')||lowerTitle.includes('cultura')) category="Cultura";
    else if (lowerLink.includes('/formacao/')||lowerTitle.includes('formacao')) category="Formacao";
    else if (lowerLink.includes('/igreja/')) category="Igreja";
    else if (lowerTitle.includes('jovens')) category="Juventude";
    else if (lowerTitle.includes('familia')) category="Familia";
    return {...item,category};
  });
}

function getFallbackNewsArray() {
  return [{ id:"fallback_1", title:"Vatican News - Ultimas Noticias", link:"https://www.vaticannews.va/pt.html", description:"Acesse o site oficial do Vatican News.", pubDate:new Date().toISOString(), author:"Vatican News", category:"Noticias" }];
}

/* ================= INSTAGRAM ================= */
async function getInstagramPosts(env) {
  try {
    const INSTAGRAM_TOKEN = env.INSTAGRAM_ACCESS_TOKEN;
    const INSTAGRAM_USER_ID = env.INSTAGRAM_BUSINESS_ACCOUNT_ID;
    if (!INSTAGRAM_TOKEN || !INSTAGRAM_USER_ID) return { data: [], paging: {} };
    const res = await fetch(`https://graph.facebook.com/v19.0/${INSTAGRAM_USER_ID}/media?fields=id,caption,media_url,permalink,thumbnail_url,timestamp,username,media_type&access_token=${INSTAGRAM_TOKEN}&limit=50`);
    if (!res.ok) { console.error("Erro na API do Instagram:", res.status, await res.text()); return { data: [], paging: {} }; }
    const data = await res.json();
    let posts = [];
    if (data.data && Array.isArray(data.data)) {
      const extractShortcode = (permalink) => { if (!permalink) return null; const match = permalink.match(/\/(?:p|reel|tv)\/([A-Za-z0-9_-]+)/); return match ? match[1] : null; };
      const seenIds = new Set(); const seenShortcodes = new Set(); const seenPermalinks = new Set();
      console.log(`Instagram RAW: ${data.data.length} posts recebidos da API`);
      data.data.forEach((p, i) => { const sc = extractShortcode(p.permalink); console.log(`  [${i}] id=${p.id} type=${p.media_type} shortcode=${sc} permalink=${p.permalink}`); });
      posts = data.data.filter(post => {
        if (seenIds.has(post.id)) return false; seenIds.add(post.id);
        if (post.permalink) { const pl = post.permalink.replace(/\/$/, '').toLowerCase(); if (seenPermalinks.has(pl)) { console.log(`Duplicata por permalink: ${post.id}`); return false; } seenPermalinks.add(pl); }
        const sc = extractShortcode(post.permalink);
        if (sc) { if (seenShortcodes.has(sc)) { console.log(`Duplicata por shortcode: ${post.id}`); return false; } seenShortcodes.add(sc); }
        if (!post.media_url && !post.thumbnail_url) return false;
        return true;
      }).slice(0, 6).map(post => ({ id: post.id, caption: post.caption ? cleanYouTubeTitle(post.caption) : "Post do Instagram", media_url: post.media_url || "", permalink: post.permalink || "", thumbnail_url: post.thumbnail_url || post.media_url || "", timestamp: post.timestamp || new Date().toISOString(), username: post.username || "santuario.fatima", media_type: post.media_type || "IMAGE", isVideo: post.media_type === "VIDEO" }));
    }
    console.log(`Instagram FINAL: ${posts.length} posts únicos retornados`);
    return { data: posts, paging: data.paging || {} };
  } catch (error) { console.error("Erro no Instagram:", error); return { data: [], paging: {} }; }
}

/* ================= LIMPEZA ================= */
async function cleanupOldCandles(env) {
  try {
    if (!env.DB) return;
    const sevenDaysAgo = new Date(Date.now() - 7 * 24 * 60 * 60 * 1000).toISOString();
    await env.DB.prepare(`UPDATE velas SET status = 0 WHERE data < ? AND status = 1`).bind(sevenDaysAgo).run();
  } catch (error) { console.error("Erro na limpeza de velas:", error); }
}

async function backupOldPrayers(env) {
  try {
    if (!env.DB||!env.BACKUP) return;
    const sixtyDaysAgo=new Date(Date.now()-60*24*60*60*1000).toISOString();
    const oldPrayers=await env.DB.prepare(`SELECT * FROM prayer WHERE created_at < ?`).bind(sixtyDaysAgo).all();
    if (oldPrayers.results.length>0) {
      await env.BACKUP.put(`backup:pedidos:${new Date().toISOString().split('T')[0]}`,JSON.stringify({count:oldPrayers.results.length,data:oldPrayers.results,backedUpAt:new Date().toISOString()}),{expirationTtl:180*24*60*60});
      await env.DB.prepare(`DELETE FROM prayer WHERE created_at < ?`).bind(sixtyDaysAgo).run();
    }
  } catch(error) { console.error("Erro ao limpar pedidos:",error); }
}

/* ================= ROTAS ADMIN ================= */
async function handleAdminDados(request, env) {
  try {
    let dados = await env.KV_FILES.get("santuario_dados", "json");
    if (!dados) {
      const ultimoRegistro = await env.DB.prepare(`SELECT dados FROM dados_sistema ORDER BY created_at DESC LIMIT 1`).first();
      if (ultimoRegistro) {
        try { dados = JSON.parse(ultimoRegistro.dados); await env.KV_FILES.put("santuario_dados", JSON.stringify(dados), { expirationTtl: 60*60*24 }); } catch(e) { console.error("Erro ao parsear dados do banco:", e); }
      }
    }
    const dadosPadrao = { carrossel: [], momentosLiturgicos: [], popups: [], recados: [], horariosMissas: HORARIOS_MISSAS_PADRAO };
    return jsonResponse({ success: true, dados: dados || dadosPadrao });
  } catch(error) { return jsonResponse({ success: false, error: "Erro interno ao carregar dados" }, 500); }
}

async function handleAdminSalvarDados(request, env) {
  try {
    const authHeader = request.headers.get("Authorization");
    if (!authHeader || !authHeader.startsWith("Bearer ")) return jsonResponse({ success: false, error: "Nao autorizado" }, 401);
    const token = authHeader.replace("Bearer ", "");
    let userData;
    try { userData = JSON.parse(atob(token)); } catch(e) { return jsonResponse({ success: false, error: "Token invalido" }, 401); }
    if (userData.exp && userData.exp < Date.now()) return jsonResponse({ success: false, error: "Token expirado. Faca login novamente." }, 401);
    const dados = await request.json();
    if (!dados || typeof dados !== 'object') return jsonResponse({ success: false, error: "Dados invalidos" }, 400);
    const dadosCompletos = {
      carrossel: dados.carrossel || [],
      momentosLiturgicos: ordenarMomentosWorker(dados.momentosLiturgicos || []),
      popups: dados.popups || [],
      recados: dados.recados || [],
      horariosMissas: dados.horariosMissas || HORARIOS_MISSAS_PADRAO
    };
    await env.KV_FILES.put("santuario_dados", JSON.stringify(dadosCompletos), { expirationTtl: 60*60*24*30 });
    try {
      if (env.DB) {
        await env.DB.prepare(`CREATE TABLE IF NOT EXISTS dados_sistema (id INTEGER PRIMARY KEY AUTOINCREMENT, dados TEXT NOT NULL, usuario_id INTEGER, created_at DATETIME DEFAULT CURRENT_TIMESTAMP)`).run();
        await env.DB.prepare(`INSERT INTO dados_sistema (dados, usuario_id, created_at) VALUES (?, ?, ?)`).bind(JSON.stringify(dadosCompletos), userData.id || null, new Date().toISOString()).run();
      }
    } catch(dbError) { console.error("Erro ao salvar no D1:", dbError); }
    return jsonResponse({ success: true, message: "Dados salvos com sucesso!" });
  } catch(error) { return jsonResponse({ success: false, error: "Erro interno ao salvar dados" }, 500); }
}

async function handleAdminPerfil(request, env) {
  try {
    const token=request.headers.get("Authorization")?.replace("Bearer ","");
    if (!token) return jsonResponse({success:false,error:"Nao autorizado"},401);
    let userData; try { userData=JSON.parse(atob(token)); } catch(e) { return jsonResponse({success:false,error:"Token invalido"},401); }
    if (userData.exp&&userData.exp<Date.now()) return jsonResponse({success:false,error:"Token expirado."},401);
    const user=await env.DB.prepare("SELECT id, nome, email, celular, role, twofa_enabled FROM users WHERE id = ?").bind(userData.id).first();
    if (!user) return jsonResponse({success:false,error:"Usuario nao encontrado"},404);
    return jsonResponse({success:true,user});
  } catch(error) { return jsonResponse({success:false,error:"Erro interno"},500); }
}

async function handleAdminAtualizarPerfil(request, env) {
  try {
    const token=request.headers.get("Authorization")?.replace("Bearer ","");
    if (!token) return jsonResponse({success:false,error:"Nao autorizado"},401);
    let userData; try { userData=JSON.parse(atob(token)); } catch(e) { return jsonResponse({success:false,error:"Token invalido"},401); }
    const body=await request.json();
    const {nome,celular}=body;
    await env.DB.prepare("UPDATE users SET nome = ?, celular = ?, updated_at = ? WHERE id = ?").bind(nome,celular,new Date().toISOString(),userData.id).run();
    return jsonResponse({success:true,message:"Perfil atualizado com sucesso!"});
  } catch(error) { return jsonResponse({success:false,error:"Erro interno"},500); }
}

async function handleAdminAlterarSenha(request, env) {
  try {
    const token=request.headers.get("Authorization")?.replace("Bearer ","");
    if (!token) return jsonResponse({success:false,error:"Nao autorizado"},401);
    let userData; try { userData=JSON.parse(atob(token)); } catch(e) { return jsonResponse({success:false,error:"Token invalido"},401); }
    if (userData.exp&&userData.exp<Date.now()) return jsonResponse({success:false,error:"Token expirado."},401);
    const body=await request.json();
    const {senha_atual,nova_senha}=body;
    const user=await env.DB.prepare("SELECT id, senha_hash FROM users WHERE id = ?").bind(userData.id).first();
    if (!user) return jsonResponse({success:false,error:"Usuario nao encontrado"},404);
    if (senha_atual!==user.senha_hash) return jsonResponse({success:false,error:"Senha atual incorreta"},401);
    await env.DB.prepare("UPDATE users SET senha_hash = ?, updated_at = ? WHERE id = ?").bind(nova_senha,new Date().toISOString(),userData.id).run();
    return jsonResponse({success:true,message:"Senha alterada com sucesso!"});
  } catch(error) { return jsonResponse({success:false,error:"Erro interno"},500); }
}

async function handlePublicHorariosMissas(request, env) {
  try {
    const dados = await env.KV_FILES.get("santuario_dados", "json");
    if (dados && dados.horariosMissas) return jsonResponse(dados.horariosMissas);
    return jsonResponse(HORARIOS_MISSAS_PADRAO);
  } catch (error) { console.error("Erro ao buscar horários de missas:", error); return jsonResponse(HORARIOS_MISSAS_PADRAO); }
}

/* ================= HANDLER PRINCIPAL ================= */
export default {
  async fetch(request, env, ctx) {
    const start=Date.now();
    const url=new URL(request.url);
    const pathname=url.pathname;
    const dataParam=url.searchParams.get("data");

    if (request.method==="OPTIONS") {
      return new Response(null,{status:204,headers:corsHeaders()});
    }

    try {
      // ========== ENDPOINT DE CONTRIBUIÇÃO DE VOZ ==========
      if (pathname==="/api/contribuir-voz" && request.method==="POST") {
        return await handleContribuirVoz(request, env);
      }

      // ========== ENDPOINT DE FAVORITOS ==========
      if (pathname==="/api/favoritos") {
        return await handleFavoritos(request, env);
      }

      // ========== ENDPOINT XTTS ==========
      if (pathname==="/api/buscar-ou-gerar-audio" && request.method==="POST") {
        return await handleBuscarOuGerarAudio(request, env);
      }

      // ========== DIOCESE NEWS ENDPOINT ==========
      if (pathname === "/api/diocese-news" && request.method === "GET") {
        return await handleDioceseNews(request, env);
      }

      // ========== BÍBLIA ENDPOINT ==========
      if (pathname==="/api/biblia" && request.method==="GET") {
        return await handleBiblia(request, env);
      }

      // ========== HEALTH ENDPOINT ==========
      if (pathname==="/api/health") {
        return jsonResponse({success:true,status:"healthy",timestamp:new Date().toISOString(),responseTime:Date.now()-start+"ms"});
      }

      // ========== AUTH ENDPOINTS ==========
      if (pathname==="/api/auth/login"&&request.method==="POST") {
        const {usuario,senha}=await request.json();
        if (!usuario||!senha) return jsonResponse({success:false,error:"Usuario e senha sao obrigatorios"},400);
        const result=await loginUser(usuario,senha,env,ctx);
        return jsonResponse(result,result.error?401:200);
      }
      if (pathname==="/api/auth/verify-2fa"&&request.method==="POST") {
        const {userId,codigo2FA}=await request.json();
        if (!userId||!codigo2FA) return jsonResponse({success:false,error:"userId e codigo 2FA sao obrigatorios"},400);
        const result=await verify2FAUser(userId,codigo2FA,env,ctx);
        return jsonResponse(result,result.error?401:200);
      }
      if (pathname==="/api/auth/verify-pin"&&request.method==="POST") {
        const {userId,pin}=await request.json();
        if (!userId||!pin) return jsonResponse({success:false,error:"userId e PIN sao obrigatorios"},400);
        const result=await verifyPINUser(userId,pin,env);
        return jsonResponse(result,result.error?401:200);
      }
      if (pathname==="/api/auth/register"&&request.method==="POST") {
        const {nome,email,senha,celular}=await request.json();
        if (!nome||!email||!senha) return jsonResponse({success:false,error:"Nome, email e senha sao obrigatorios"},400);
        const result=await registerUser({nome,email,senha,celular},env,ctx);
        return jsonResponse(result,result.error?400:200);
      }
      if (pathname==="/api/auth/esqueci-senha"&&request.method==="POST") {
        const {email}=await request.json();
        if (!email) return jsonResponse({success:false,error:"E-mail e obrigatorio"},400);
        const result=await solicitarRecuperacaoSenha(email,env,ctx);
        return jsonResponse(result,result.error?404:200);
      }
      if (pathname==="/api/auth/reset-senha"&&request.method==="POST") {
        const {token,novaSenha}=await request.json();
        if (!token||!novaSenha) return jsonResponse({success:false,error:"Token e nova senha sao obrigatorios"},400);
        const result=await redefinirSenha(token,novaSenha,env);
        return jsonResponse(result,result.error?400:200);
      }
      if (pathname==="/api/auth/criar-sessao" && request.method==="POST") return await handleCriarSessao(request, env);
      if (pathname==="/api/auth/validar-sessao" && request.method==="POST") return await handleValidarSessao(request, env);
      if (pathname==="/api/auth/verificar-autenticacao" && request.method==="GET") return await handleVerificarAutenticacao(request, env);

      // ========== WEBBLACK ENDPOINTS ==========
      if (pathname==="/api/auth/webblack/solicitar-acesso" && request.method==="POST") return await handleWebBlackSolicitarAcesso(request, env);
      if (pathname==="/api/auth/webblack/verificar-link" && request.method==="POST") return await handleWebBlackVerificarLink(request, env);
      if (pathname==="/api/auth/webblack/verificar-2fa" && request.method==="POST") return await handleWebBlackVerificar2FA(request, env);

      // ========== ADMIN ENDPOINTS ==========
      if (pathname==="/api/admin/dados"&&request.method==="GET") return await handleAdminDados(request,env);
      if (pathname==="/api/admin/dados"&&request.method==="POST") return await handleAdminSalvarDados(request,env);
      if (pathname==="/api/admin/perfil"&&request.method==="GET") return await handleAdminPerfil(request,env);
      if (pathname==="/api/admin/perfil"&&request.method==="PUT") return await handleAdminAtualizarPerfil(request,env);
      if (pathname==="/api/admin/alterar-senha"&&request.method==="PUT") return await handleAdminAlterarSenha(request,env);

      if (pathname==="/api/admin/youtube-live"&&request.method==="POST") return await handleAdminYoutubeLivePost(request,env);
      if (pathname==="/api/admin/youtube-live"&&request.method==="DELETE") return await handleAdminYoutubeLiveDelete(request,env);
      if (pathname==="/api/admin/youtube-live"&&request.method==="GET") return await handleAdminYoutubeLiveGet(request,env);

      if (pathname==="/api/dados-publicos/missas"&&request.method==="GET") return await handlePublicHorariosMissas(request,env);

      if (pathname==="/api/terco/hoje") return jsonResponse(getMisterioTerco());

      if (pathname==="/api/liturgia") {
        try { return jsonResponse(await buscarLiturgia(dataParam)); }
        catch(error) { return jsonResponse({success:false,error:"Erro ao carregar liturgia",message:error.message},500); }
      }

      if (pathname==="/api/vatican-news") {
        const cacheKey="vatican_news:latest";
        try {
          const cached=await env.VATICANNEWS_CACHE?.get(cacheKey,"json");
          if (cached) { if (Array.isArray(cached)) return jsonResponse(cached); if (cached.items&&Array.isArray(cached.items)) return jsonResponse(cached.items); }
          const res=await fetch("https://www.vaticannews.va/pt.rss.xml");
          const xml=await res.text();
          const finalItems=categorizeNews(parseRSS(xml)).slice(0,6);
          if (env.VATICANNEWS_CACHE) await env.VATICANNEWS_CACHE.put(cacheKey,JSON.stringify(finalItems),{expirationTtl:3600});
          return jsonResponse(finalItems);
        } catch(error) { return jsonResponse(getFallbackNewsArray(),200); }
      }

      if (pathname==="/api/youtube") {
        try {
          const result = await getYouTubeMainVideo(env);
          return jsonResponse({ videos: result.allVideos, mainVideo: result.mainVideo, cardVideos: result.cardVideos, liveStatus: result.liveStatus, timestamp: new Date().toISOString() });
        } catch(error) {
          const cleanFallback = CONFIG.FALLBACK_VIDEOS.map(v => ({ ...v, id: cleanVideoId(v.id) }));
          return jsonResponse({ videos: cleanFallback, mainVideo: cleanFallback[0], cardVideos: cleanFallback.slice(1), liveStatus: 'none', timestamp: new Date().toISOString() });
        }
      }

      if (pathname==="/api/youtube/live") {
        try {
          const {mainVideo, liveStatus} = await getYouTubeMainVideo(env);
          if (liveStatus === 'live' && mainVideo && mainVideo.isLiveNow) {
            return jsonResponse({ isLive: true, liveNow: true, videoId: mainVideo.id, title: mainVideo.title, viewers: "AO VIVO AGORA", videoUrl: mainVideo.videoUrl, currentLive: { id: mainVideo.id, title: mainVideo.title, thumbnail: mainVideo.thumbnail, link: mainVideo.videoUrl, isLiveNow: true, description: mainVideo.description || "Transmissao ao vivo do Santuario de Fatima", published: mainVideo.publishedAt }, videos: [] });
          }
          return jsonResponse({ isLive: false, liveNow: false, currentLive: null, videos: [], nextVideo: mainVideo ? { ...mainVideo, isLiveNow: false } : { ...CONFIG.FALLBACK_VIDEOS[0], id: cleanVideoId(CONFIG.FALLBACK_VIDEOS[0].id), isLiveNow: false } });
        } catch(error) {
          return jsonResponse({ isLive: false, liveNow: false, currentLive: null, videos: [], nextVideo: { ...CONFIG.FALLBACK_VIDEOS[0], id: cleanVideoId(CONFIG.FALLBACK_VIDEOS[0].id), isLiveNow: false } });
        }
      }

      if (pathname==="/api/instagram") {
        const result = await getInstagramPosts(env);
        return jsonResponse(result);
      }

      if (pathname==="/api/candle-lighting") {
        if (request.method==="POST") {
          try {
            const body=await request.json();
            const candleData={ id:Date.now().toString(), nome:body.name||body.nome||"Anonimo", familia:body.intention||"Familia", cidade:body.city||body.cidade||"", estado:body.state||body.estado||"", data:new Date().toISOString(), duracao:86400, status:1 };
            if (env.DB) {
              await env.DB.prepare(`CREATE TABLE IF NOT EXISTS velas (id TEXT PRIMARY KEY, nome TEXT NOT NULL, familia TEXT, cidade TEXT, estado TEXT, data TEXT, duracao INTEGER, status INTEGER DEFAULT 1)`).run();
              await env.DB.prepare(`INSERT INTO velas (id, nome, familia, cidade, estado, data, duracao, status) VALUES (?, ?, ?, ?, ?, ?, ?, ?)`).bind(candleData.id,candleData.nome,candleData.familia,candleData.cidade,candleData.estado,candleData.data,candleData.duracao,candleData.status).run();
            }
            if (body.email) ctx.waitUntil(sendCandleEmail(env,{name:candleData.nome,email:body.email,intention:candleData.familia,cidade:candleData.cidade,estado:candleData.estado}));
            ctx.waitUntil(cleanupOldCandles(env));
            return jsonResponse({success:true,message:"Vela acesa com sucesso!",candle:{id:candleData.id,name:candleData.nome,intention:candleData.familia,city:candleData.cidade,state:candleData.estado,createdAt:candleData.data}});
          } catch(error) { return jsonResponse({success:false,error:"Erro interno ao processar vela"},500); }
        } else if (request.method==="GET") {
          try {
            if (!env.DB) return jsonResponse([],200);
            await env.DB.prepare(`CREATE TABLE IF NOT EXISTS velas (id TEXT PRIMARY KEY, nome TEXT NOT NULL, familia TEXT, cidade TEXT, estado TEXT, data TEXT, duracao INTEGER, status INTEGER DEFAULT 1)`).run();
            const sevenDaysAgo=new Date(Date.now()-7*24*60*60*1000).toISOString();
            const result=await env.DB.prepare(`SELECT id, nome, familia, cidade, estado, data FROM velas WHERE data > ? AND status = 1 ORDER BY data DESC LIMIT 100`).bind(sevenDaysAgo).all();
            const candles=(result.results||[]).map(c=>({id:c.id,name:c.nome,intention:c.familia,city:c.cidade||"",state:c.estado||"",createdAt:c.data,timestamp:formatTimeAgo(c.data)}));
            return jsonResponse(candles);
          } catch(error) { return jsonResponse([],200); }
        }
      }

      else if (pathname === "/api/prayer") {
        if (request.method === "POST") {
          try {
            const body = await request.json();
            if (env.DB) {
              try {
                await env.DB.prepare(`CREATE TABLE IF NOT EXISTS prayer (id INTEGER PRIMARY KEY AUTOINCREMENT, nome TEXT NOT NULL, email TEXT, pedido TEXT NOT NULL, cidade TEXT, created_at DATETIME DEFAULT CURRENT_TIMESTAMP)`).run();
                await env.DB.prepare(`INSERT INTO prayer (nome, email, pedido, cidade, created_at) VALUES (?, ?, ?, ?, ?)`).bind(body.name||body.nome||"Anonimo",body.email||"",body.prayerRequest||body.pedido||"",body.cidade||body.city||"",new Date().toISOString()).run();
              } catch (dbError) {
                try { await env.DB.prepare(`INSERT INTO prayer (nome, email, pedido, created_at) VALUES (?, ?, ?, ?)`).bind(body.name||body.nome||"Anonimo",body.email||"",body.prayerRequest||body.pedido||"",new Date().toISOString()).run(); } catch (fallbackError) { console.error('Erro no fallback:', fallbackError); }
              }
            }
            if (body.email && env.RESEND_API_KEY) {
              ctx.waitUntil(sendPrayerConfirmationEmail(env, {name:body.name||body.nome||"Anonimo",email:body.email,prayerRequest:body.prayerRequest||body.pedido||"",cidade:body.cidade||body.city||""}));
              ctx.waitUntil(sendPrayerNotificationToSecretariat(env, {name:body.name||body.nome||"Anonimo",email:body.email,prayerRequest:body.prayerRequest||body.pedido||"",cidade:body.cidade||body.city||""}));
            }
            return jsonResponse({ success: true, message: "Pedido de oracao recebido com sucesso! Em breve voce recebera uma confirmacao por email." });
          } catch (error) { return jsonResponse({ success: false, message: "Erro ao processar seu pedido", error: error.message }, 500); }
        } else if (request.method === "GET") {
          try {
            if (!env.DB) return jsonResponse({success:true,count:0,prayers:[]});
            try {
              const result = await env.DB.prepare(`SELECT id, nome, email, pedido, cidade, created_at FROM prayer ORDER BY created_at DESC LIMIT 50`).all();
              return jsonResponse({success:true,count:result.results?.length||0,prayers:result.results||[]});
            } catch (selectError) {
              const result = await env.DB.prepare(`SELECT id, nome, email, pedido, created_at FROM prayer ORDER BY created_at DESC LIMIT 50`).all();
              return jsonResponse({success:true,count:result.results?.length||0,prayers:result.results||[]});
            }
          } catch (error) { return jsonResponse({ success: false, error: "Erro ao buscar pedidos" }, 500); }
        }
      }

      else if (pathname==="/api/contato/enviar"&&request.method==="POST") {
        try {
          const body=await request.json();
          if (!env.RESEND_API_KEY) return jsonResponse({success:false,error:"RESEND_API_KEY nao configurada"},500);
          ctx.waitUntil(sendContactConfirmationEmail(env,{nome:body.nome,email:body.email,assunto:body.assunto,mensagem:body.mensagem,telefone:body.telefone}));
          ctx.waitUntil(sendContactNotificationToSecretariat(env,{nome:body.nome,email:body.email,assunto:body.assunto,mensagem:body.mensagem,telefone:body.telefone}));
          return jsonResponse({success:true,message:"Mensagem enviada com sucesso!"});
        } catch(error) { return jsonResponse({success:false,message:"Erro ao enviar mensagem",error:error.message},500); }
      }

      else if (pathname==="/api/contato/pascom/enviar" && request.method==="POST") {
        try {
          const body = await request.json();
          if (!env.RESEND_API_KEY) return jsonResponse({ success: false, error: "RESEND_API_KEY não configurada" }, 500);
          ctx.waitUntil(sendPascomConfirmationEmail(env, body));
          ctx.waitUntil(sendPascomNotificationToTeam(env, body));
          return jsonResponse({ success: true, message: "Mensagem enviada com sucesso para a Pascom!" });
        } catch(error) {
          return jsonResponse({ success: false, message: "Erro ao enviar mensagem", error: error.message }, 500);
        }
      }

      else if (pathname==="/api/send-email"&&request.method==="POST") {
        try {
          const body=await request.json();
          if (!env.RESEND_API_KEY) return jsonResponse({success:false,error:"RESEND_API_KEY nao configurada"},500);
          const emailResponse=await fetch("https://api.resend.com/emails",{method:"POST",headers:{"Authorization":`Bearer ${env.RESEND_API_KEY}`,"Content-Type":"application/json"},body:JSON.stringify({from:"Santuario de Fatima <noreply@mail.santuariodefatima.com.br>",to:[body.to],subject:body.subject||"Teste do Santuario de Fatima",html:body.html||"<p>Teste de email</p>"})});
          const data=await emailResponse.json();
          if (emailResponse.ok) return jsonResponse({success:true,message:"Email enviado com sucesso!",id:data.id});
          return jsonResponse({success:false,error:data},500);
        } catch(error) { return jsonResponse({success:false,error:error.message},500); }
      }

      else if (pathname==="/"||pathname==="/api") {
        return jsonResponse({success:true,service:"Santuario de Fatima API",version:"17.0.0",status:"online",motor_tts:"xtts-huggingface",timestamp:new Date().toISOString()});
      }

      else if (pathname==="/api/dados"&&request.method==="GET") {
        try {
          const dados = await env.KV_FILES.get("santuario_dados","json");
          const dadosPadrao = { carrossel:[], momentosLiturgicos:[], popups:[], recados:[], horariosMissas:HORARIOS_MISSAS_PADRAO };
          return jsonResponse({ success:true, dados: dados||dadosPadrao });
        } catch(e) {
          return jsonResponse({ success:true, dados:{ carrossel:[], momentosLiturgicos:[], popups:[], recados:[], horariosMissas:HORARIOS_MISSAS_PADRAO } });
        }
      }

      else {
        return jsonResponse({success:false,error:"Endpoint nao encontrado",path:pathname},404);
      }

    } catch(err) {
      console.error("Erro interno:",err);
      return jsonResponse({success:false,error:"Erro interno do servidor"},500);
    }
  },

  async scheduled(event, env, ctx) {
    await cleanupOldCandles(env);
    await backupOldPrayers(env);
  }
};

