async function handleDioceseNews(request, env) {
  try {
    console.log('🌐 Buscando notícias da Diocese de Santo Amaro...');

    const response = await fetch('https://diocesedesantoamaro.org.br', {
      headers: {
        'User-Agent': 'Mozilla/5.0 (compatible; SantuarioBot/1.0)',
        'Accept': 'text/html,application/xhtml+xml'
      }
    });

    if (!response.ok) {
      throw new Error(`HTTP error! status: ${response.status}`);
    }

    const html = await response.text();
    
    const newsItems = extractNewsFromHTML(html);
    
    const finalNews = newsItems.length > 0 ? newsItems : getSimulatedNews();

    return jsonResponse({
      success: true,
      items: finalNews,
      total: finalNews.length,
      source: 'diocesedesantoamaro.org.br',
      timestamp: new Date().toISOString()
    });

  } catch (error) {
    console.error('❌ Erro no worker da Diocese:', error);
    
    return jsonResponse({
      success: false,
      error: error.message,
      items: getSimulatedNews(),
      source: 'simulated'
    });
  }
}

/* ================= BÍBLIA CATÓLICA ================= */
const BIBLIA_BASE_URL = 'https://raw.githubusercontent.com/thiagobodruk/biblia/master/json/';
const BIBLIA_ARQUIVOS = {
  'gn':'01_genesis.json','ex':'02_exodo.json','lv':'03_levitico.json',
  'nm':'04_numeros.json','dt':'05_deuteronomio.json','js':'06_josue.json',
  'jz':'07_juizes.json','rt':'08_rute.json','1sm':'09_1_samuel.json',
  '2sm':'10_2_samuel.json','1rs':'11_1_reis.json','2rs':'12_2_reis.json',
  '1cr':'13_1_cronicas.json','2cr':'14_2_cronicas.json','ed':'15_esdras.json',
  'ne':'16_neemias.json','et':'17_ester.json','jó':'18_jo.json',
  'sl':'19_salmos.json','pv':'20_proverbios.json','ec':'21_eclesiastes.json',
  'ct':'22_canticos.json','is':'23_isaias.json','jr':'24_jeremias.json',
  'lm':'25_lamentacoes.json','ez':'26_ezequiel.json','dn':'27_daniel.json',
  'os':'28_oseias.json','jl':'29_joel.json','am':'30_amos.json',
  'ob':'31_abdias.json','jn':'32_jonas.json','mq':'33_miqueias.json',
  'na':'34_naum.json','hc':'35_habacuque.json','sf':'36_sofonias.json',
  'ag':'37_ageu.json','zc':'38_zacarias.json','ml':'39_malaquias.json',
  'mt':'40_mateus.json','mc':'41_marcos.json','lc':'42_lucas.json',
  'jo':'43_joao.json','at':'44_atos.json','rm':'45_romanos.json',
  '1co':'46_1_corintios.json','2co':'47_2_corintios.json','gl':'48_galatas.json',
  'ef':'49_efesios.json','fp':'50_filipenses.json','cl':'51_colossenses.json',
  '1ts':'52_1_tessalonicenses.json','2ts':'53_2_tessalonicenses.json',
  '1tm':'54_1_timoteo.json','2tm':'55_2_timoteo.json','tt':'56_tito.json',
  'fm':'57_filemon.json','hb':'58_hebreus.json','tg':'59_tiago.json',
  '1pe':'60_1_pedro.json','2pe':'61_2_pedro.json','1jo':'62_1_joao.json',
  '2jo':'63_2_joao.json','3jo':'64_3_joao.json','jd':'65_judas.json',
  'ap':'66_apocalipse.json'
};

async function handleBiblia(request, env) {
  const url = new URL(request.url);
  const abbrev = url.searchParams.get('livro')?.toLowerCase();
  const cap = parseInt(url.searchParams.get('capitulo') || '1');
  if (!abbrev) return jsonResponse({ success: false, error: 'Parametro livro obrigatorio' }, 400);
  const arquivo = BIBLIA_ARQUIVOS[abbrev];
  if (!arquivo) return jsonResponse({ success: false, error: `Livro nao encontrado: ${abbrev}` }, 404);
  try {
    const cacheKey = `biblia:${abbrev}:${cap}`;
    if (env.KV_FILES) {
      const cached = await env.KV_FILES.get(cacheKey, 'json');
      if (cached) return jsonResponse({ ...cached, cached: true });
    }
    const res = await fetch(`${BIBLIA_BASE_URL}${arquivo}`, { headers: { 'User-Agent': 'SantuarioFatima/1.0' } });
    if (!res.ok) throw new Error(`GitHub ${res.status}`);
    const livro = await res.json();
    const chapters = livro.chapters || [];
    const capIdx = cap - 1;
    if (capIdx < 0 || capIdx >= chapters.length) {
      return jsonResponse({ success: false, error: `Capitulo ${cap} inexistente. Total: ${chapters.length}` }, 404);
    }
    const verses = chapters[capIdx].map((t, i) => ({ number: i + 1, text: t }));
    const result = { success: true, livro: livro.name || abbrev, abbrev, capitulo: cap, totalCapitulos: chapters.length, verses };
    if (env.KV_FILES) {
      await env.KV_FILES.put(cacheKey, JSON.stringify(result), { expirationTtl: 604800 });
    }
    return jsonResponse(result);
  } catch(e) {
    console.error('Erro biblia:', e);
    return jsonResponse({ success: false, error: 'Erro ao carregar capitulo. Tente novamente.' }, 500);
  }
}

/* ================= XTTS (HuggingFace) + R2 ================= */
async function handleBuscarOuGerarAudio(request, env) {
  try {
    if (request.method === "OPTIONS") {
      return new Response(null, { status: 204, headers: corsHeaders() });
    }

    if (request.method !== "POST") {
      return jsonResponse({ success: false, error: "Método não permitido" }, 405);
    }

    const body = await request.json();
    const { texto, livro, capitulo, versiculo, vozId } = body;

    if (!texto || !livro || !capitulo || !versiculo || !vozId) {
      return jsonResponse({
        success: false,
        error: 'Campos obrigatorios: texto, livro, capitulo, versiculo, vozId'
      }, 400);
    }

    const amosturaPath = VOZES_XTTS[vozId.toLowerCase()];
    if (!amosturaPath) {
      return jsonResponse({
        success: false,
        error: `Voz desconhecida: ${vozId}. Vozes disponíveis: ${Object.keys(VOZES_XTTS).join(', ')}`
      }, 400);
    }

    const r2Key  = `audio/${vozId}/${livro}/${capitulo}/${versiculo}.wav`;
    const pubUrl = `${R2_PUBLIC_URL}/${r2Key}`;

    if (env.R2_AUDIO) {
      try {
        const existing = await env.R2_AUDIO.head(r2Key);
        if (existing) {
          console.log(`✅ Cache R2 hit: ${r2Key}`);
          return jsonResponse({ success: true, url: pubUrl, cached: true });
        }
      } catch (_) {
        console.log(`📢 Não encontrado no R2: ${r2Key}`);
      }
    } else {
      console.warn("⚠️ R2_AUDIO não configurado no worker");
    }

    const amosturaUrl = `${R2_PUBLIC_URL}/${amosturaPath}`;

    const hfSpaceUrl = env.HF_SPACE_URL;
    if (!hfSpaceUrl) {
      console.error("❌ HF_SPACE_URL não configurada");
      return jsonResponse({
        success: false,
        error: 'HF_SPACE_URL não configurada no servidor.'
      }, 500);
    }

    console.log(`🎙️ Chamando XTTS: voz=${vozId} | ${livro} ${capitulo}:${versiculo}`);

    let xttsResponse;
    try {
      xttsResponse = await fetch(`${hfSpaceUrl}/gerar`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          texto: texto,
          amostra_url: amosturaUrl,
        }),
        signal: AbortSignal.timeout(120000),
      });
    } catch (fetchErr) {
      console.error('Erro ao chamar HF Space:', fetchErr);
      return jsonResponse({
        success: false,
        error: `Não foi possível conectar ao HuggingFace Space: ${fetchErr.message}`
      }, 502);
    }

    if (!xttsResponse.ok) {
      const errText = await xttsResponse.text();
      console.error('XTTS erro HTTP:', xttsResponse.status, errText);
      return jsonResponse({
        success: false,
        error: `HuggingFace Space retornou ${xttsResponse.status}: ${errText.substring(0, 200)}`
      }, 502);
    }

    const xttsData = await xttsResponse.json();

    if (!xttsData.audio_base64) {
      console.error('XTTS não retornou audio_base64:', xttsData);
      return jsonResponse({
        success: false,
        error: xttsData.error || 'HuggingFace Space não retornou áudio'
      }, 502);
    }

    const binaryStr = atob(xttsData.audio_base64);
    const audioBytes = new Uint8Array(binaryStr.length);
    for (let i = 0; i < binaryStr.length; i++) {
      audioBytes[i] = binaryStr.charCodeAt(i);
    }
    const audioBuffer = audioBytes.buffer;

    if (env.R2_AUDIO) {
      try {
        await env.R2_AUDIO.put(r2Key, audioBuffer, {
          httpMetadata: { contentType: 'audio/wav' },
          customMetadata: {
            generatedAt: new Date().toISOString(),
            vozId: vozId,
            livro: livro,
            capitulo: capitulo.toString(),
            versiculo: versiculo.toString(),
            geradoPor: 'xtts-hf',
          }
        });
        console.log(`💾 Salvo no R2: ${r2Key}`);
        return jsonResponse({ success: true, url: pubUrl, cached: false });
      } catch (r2Error) {
        console.error('Erro ao salvar no R2 (retornando áudio direto):', r2Error);
        return new Response(audioBuffer, {
          status: 200,
          headers: {
            'Content-Type': 'audio/wav',
            ...corsHeaders(),
          },
        });
      }
    }

    return new Response(audioBuffer, {
      status: 200,
      headers: {
        'Content-Type': 'audio/wav',
        ...corsHeaders(),
      },
    });

  } catch (error) {
    console.error('Erro handleBuscarOuGerarAudio:', error);
    return jsonResponse({
      success: false,
      error: 'Erro interno no servidor: ' + error.message
    }, 500);
  }
}

/* ================= FUNCAO DE AVISO DE HORARIO ================= */
function getHorarioSecretariaAviso() {
  const hoje = new Date();
  const diaSemana = hoje.getDay();
  const horaAtual = hoje.getHours();
  const isSegunda = diaSemana === 1;
  const isDomingo = diaSemana === 0;
  const feriados = ["01-01","25-01","21-04","01-05","09-07","07-09","12-10","02-11","15-11","20-11","25-12"];
  const hojeStr = `${String(hoje.getDate()).padStart(2,'0')}-${String(hoje.getMonth()+1).padStart(2,'0')}`;
  const isFeriado = feriados.includes(hojeStr);
  if (isSegunda || isDomingo || isFeriado) {
    return { ativo: true, mensagem: "A Secretaria Paroquial nao funciona as segundas-feiras, domingos e feriados. Os e-mails sao respondidos de terca a sabado." };
  }
  const isHorarioComercial = horaAtual >= 9 && horaAtual < 17;
  if (!isHorarioComercial) {
    return { ativo: true, mensagem: "Fora do horario de funcionamento (9h as 17h, terca a sabado). Sua mensagem sera respondida no proximo dia util." };
  }
  return { ativo: false };
}

/* ================= ORDENACAO MOMENTOS LITURGICOS ================= */
function extrairAnoWorker(periodo) {
  if (!periodo) return new Date().getFullYear();
  const match = periodo.match(/\b(19|20)\d{2}\b/);
  if (match) return parseInt(match[0]);
  return new Date().getFullYear();
}

function ordenarMomentosWorker(momentos) {
  if (!Array.isArray(momentos)) return momentos || [];
  return [...momentos].sort((a, b) => {
    const anoA = extrairAnoWorker(a.periodo);
    const anoB = extrairAnoWorker(b.periodo);
    if (anoA !== anoB) return anoB - anoA;
    const idA = parseInt(a.id) || 0;
    const idB = parseInt(b.id) || 0;
    return idB - idA;
  });
}

/* ================= AUTENTICACAO ================= */

async function loginUser(usuario, senha, env, ctx) {
  try {
    const user = await env.DB.prepare(
      "SELECT id, nome, email, senha_hash, twofa_enabled FROM users WHERE email = ? OR usuario = ?"
    ).bind(usuario, usuario).first();
    if (!user) return { success: false, error: "Usuario nao encontrado" };
    const senhaValida = senha === user.senha_hash;
    if (!senhaValida) return { success: false, error: "Senha incorreta" };
    if (user.twofa_enabled === 1) {
      const codigo2FA = Math.floor(100000 + Math.random() * 900000).toString();
      const expiraEm = Date.now() + 5 * 60 * 1000;
      await env.AUTH_KV.put(`2fa:${user.id}`, JSON.stringify({ codigo: codigo2FA, expira: expiraEm }), { expirationTtl: 300 });
      ctx.waitUntil(send2FAEmail(env, user.email, codigo2FA, user.nome));
      return { success: true, step: "2fa", userId: user.id, message: "Codigo 2FA enviado para seu email" };
    }
    const pinEmail = Math.floor(1000 + Math.random() * 9000).toString();
    const expiraEm = Date.now() + 5 * 60 * 1000;
    await env.AUTH_KV.put(`pin:${user.id}`, JSON.stringify({ pin: pinEmail, expira: expiraEm }), { expirationTtl: 300 });
    ctx.waitUntil(sendPINEmail(env, user.email, pinEmail, user.nome));
    return { success: true, step: "pin", userId: user.id, message: "PIN enviado para seu email" };
  } catch (error) { console.error("Erro em loginUser:", error); throw error; }
}

async function verify2FAUser(userId, codigo2FA, env, ctx) {
  try {
    const stored = await env.AUTH_KV.get(`2fa:${userId}`, "json");
    if (!stored) return { success: false, error: "Codigo 2FA nao encontrado ou expirado" };
    if (stored.codigo !== codigo2FA) return { success: false, error: "Codigo 2FA invalido" };
    if (stored.expira < Date.now()) return { success: false, error: "Codigo 2FA expirado" };
    const pinEmail = Math.floor(1000 + Math.random() * 9000).toString();
    const expiraEm = Date.now() + 5 * 60 * 1000;
    await env.AUTH_KV.put(`pin:${userId}`, JSON.stringify({ pin: pinEmail, expira: expiraEm }), { expirationTtl: 300 });
    const user = await env.DB.prepare("SELECT id, nome, email FROM users WHERE id = ?").bind(userId).first();
    ctx.waitUntil(sendPINEmail(env, user.email, pinEmail, user.nome));
    await env.AUTH_KV.delete(`2fa:${userId}`);
    return { success: true, step: "pin", userId: userId, message: "PIN enviado para seu email" };
  } catch (error) { console.error("Erro em verify2FAUser:", error); throw error; }
}

async function verifyPINUser(userId, pin, env) {
  try {
    const stored = await env.AUTH_KV.get(`pin:${userId}`, "json");
    if (!stored) return { success: false, error: "PIN nao encontrado ou expirado" };
    if (stored.pin !== pin) return { success: false, error: "PIN invalido" };
    if (stored.expira < Date.now()) return { success: false, error: "PIN expirado" };
    const user = await env.DB.prepare("SELECT id, nome, email, role FROM users WHERE id = ?").bind(userId).first();
    const token = btoa(JSON.stringify({ id: user.id, nome: user.nome, email: user.email, role: user.role, exp: Date.now() + 24 * 60 * 60 * 1000 }));
    await env.AUTH_KV.delete(`pin:${userId}`);
    
    const sessionId = crypto.randomUUID();
    await env.AUTH_KV.put(`session:${sessionId}`, JSON.stringify({ 
      userId: user.id, 
      email: user.email,
      nome: user.nome,
      authenticated: true,
      createdAt: Date.now(),
      expiresAt: Date.now() + 24 * 60 * 60 * 1000 
    }), { expirationTtl: 24 * 60 * 60 });
    
    return { success: true, token, sessionId, user: { id: user.id, nome: user.nome, email: user.email, role: user.role }, message: "Autenticado com sucesso!" };
  } catch (error) { console.error("Erro em verifyPINUser:", error); throw error; }
}

async function registerUser(userData, env, ctx) {
  try {
    const { nome, email, senha, celular } = userData;
    const existing = await env.DB.prepare("SELECT id FROM users WHERE email = ?").bind(email).first();
    if (existing) return { success: false, error: "Email ja cadastrado" };
    await env.DB.prepare("INSERT INTO users (usuario, nome, email, senha_hash, celular, role, twofa_enabled, created_at) VALUES (?, ?, ?, ?, ?, 'user', 0, ?)").bind(email, nome, email, senha, celular || null, new Date().toISOString()).run();
    ctx.waitUntil(sendWelcomeEmail(env, email, nome));
    return { success: true, message: "Usuario cadastrado com sucesso! Em breve voce recebera instrucoes para ativar a autenticacao em duas etapas." };
  } catch (error) { console.error("Erro em registerUser:", error); return { success: false, error: `Erro no registro: ${error.message}` }; }
}

/* ================= SESSOES ================= */

async function handleCriarSessao(request, env) {
  try {
    const { email, tipo } = await request.json();
    
    if (!email) return jsonResponse({ success: false, error: "Email obrigatório" }, 400);
    
    const sessionId = crypto.randomUUID();
    const expiresAt = Date.now() + 30 * 60 * 1000;
    
    await env.AUTH_KV.put(`webblack_session:${sessionId}`, JSON.stringify({
      email,
      tipo: tipo || 'webblack',
      createdAt: Date.now(),
      expiresAt,
      authenticated: false
    }), { expirationTtl: 30 * 60 });
    
    return jsonResponse({ 
      success: true, 
      sessionId,
      expiresAt,
      message: "Sessão criada com sucesso" 
    });
  } catch (error) {
    console.error("Erro ao criar sessão:", error);
    return jsonResponse({ success: false, error: "Erro interno" }, 500);
  }
}

async function handleValidarSessao(request, env) {
  try {
    const { sessionId } = await request.json();
    
    if (!sessionId) return jsonResponse({ success: false, error: "SessionId obrigatório" }, 400);
    
    const session = await env.AUTH_KV.get(`webblack_session:${sessionId}`, "json");
    
    if (!session) return jsonResponse({ success: false, error: "Sessão inválida ou expirada" }, 401);
    
    if (session.expiresAt < Date.now()) {
      await env.AUTH_KV.delete(`webblack_session:${sessionId}`);
      return jsonResponse({ success: false, error: "Sessão expirada" }, 401);
    }
    
    return jsonResponse({ 
      success: true, 
      session,
      message: "Sessão válida" 
    });
  } catch (error) {
    console.error("Erro ao validar sessão:", error);
    return jsonResponse({ success: false, error: "Erro interno" }, 500);
  }
}

async function handleVerificarAutenticacao(request, env) {
  try {
    const cookieHeader = request.headers.get("Cookie");
    let sessionId = null;
    
    if (cookieHeader) {
      const cookies = cookieHeader.split(';').map(c => c.trim());
      for (const cookie of cookies) {
        if (cookie.startsWith('session_id=')) {
          sessionId = cookie.substring(11);
          break;
        }
      }
    }
    
    if (!sessionId) {
      const authHeader = request.headers.get("Authorization");
      if (authHeader && authHeader.startsWith("Bearer ")) {
        const token = authHeader.replace("Bearer ", "");
        try {
          const tokenData = JSON.parse(atob(token));
          if (tokenData.exp && tokenData.exp > Date.now()) {
            return jsonResponse({ authenticated: true, user: tokenData });
          }
        } catch (e) {}
      }
      
      return jsonResponse({ authenticated: false }, 200);
    }
    
    const session = await env.AUTH_KV.get(`session:${sessionId}`, "json");
    
    if (!session || session.expiresAt < Date.now()) {
      return jsonResponse({ authenticated: false }, 200);
    }
    
    return jsonResponse({ 
      authenticated: true, 
      user: {
        id: session.userId,
        email: session.email,
        nome: session.nome
      }
    });
  } catch (error) {
    console.error("Erro ao verificar autenticação:", error);
    return jsonResponse({ authenticated: false }, 200);
  }
}

/* ================= RECUPERACAO DE SENHA ================= */

async function solicitarRecuperacaoSenha(email, env, ctx) {
  try {
    const user = await env.DB.prepare("SELECT id, nome, email FROM users WHERE email = ?").bind(email).first();
    if (!user) return { success: false, error: "E-mail nao encontrado" };
    const resetToken = Math.floor(100000 + Math.random() * 900000).toString();
    const expiraEm = Date.now() + 15 * 60 * 1000;
    await env.AUTH_KV.put(`reset:${user.id}`, JSON.stringify({ token: resetToken, expira: expiraEm }), { expirationTtl: 900 });
    ctx.waitUntil(sendResetSenhaEmail(env, user.email, user.nome, resetToken));
    return { success: true, token: btoa(JSON.stringify({ userId: user.id, tipo: "reset" })), message: "E-mail de recuperacao enviado com sucesso!" };
  } catch (error) { console.error("Erro em solicitarRecuperacaoSenha:", error); throw error; }
}

async function redefinirSenha(tokenEncoded, novaSenha, env) {
  try {
    const decoded = JSON.parse(atob(tokenEncoded));
    const { userId } = decoded;
    const stored = await env.AUTH_KV.get(`reset:${userId}`, "json");
    if (!stored) return { success: false, error: "Token expirado ou invalido" };
    if (stored.expira < Date.now()) return { success: false, error: "Token expirado" };
    await env.DB.prepare("UPDATE users SET senha_hash = ?, updated_at = ? WHERE id = ?").bind(novaSenha, new Date().toISOString(), userId).run();
    await env.AUTH_KV.delete(`reset:${userId}`);
    return { success: true, message: "Senha redefinida com sucesso! Faca login com sua nova senha." };
  } catch (error) { console.error("Erro em redefinirSenha:", error); throw error; }
}

