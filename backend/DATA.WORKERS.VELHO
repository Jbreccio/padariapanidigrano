const capituloCache = new Map<string, Versiculo[]>();

const limparTextoTTS = (texto: string): string =>
  texto
    .replace(/\bdr\.\s*/gi, 'doutor ')
    .replace(/\bsr\.\s*/gi, 'senhor ')
    .replace(/\bsra\.\s*/gi, 'senhora ')
    .replace(/\.\.\./g, ' ')
    .replace(/[.!?;:]/g, ' ')
    .replace(/,/g, ' ')
    .replace(/—|-{2,}/g, ' ')
    .replace(/["""''«»]/g, '')
    .replace(/\s{2,}/g, ' ')
    .trim();

const pausaMs = (ms: number): Promise<void> =>
  new Promise(resolve => setTimeout(resolve, ms));

function selecionarVozSistema(
  id: string,
  vozesSistema: SpeechSynthesisVoice[]
): SpeechSynthesisVoice | undefined {
  const pt = vozesSistema.filter(v =>
    v.lang === 'pt-BR' || v.lang === 'pt_BR' || v.lang.startsWith('pt')
  );

  if (id === 'google_pt_br_feminino') {
    return (
      pt.find(v => v.name.toLowerCase().includes('google')) ??
      pt.find(v => v.name.toLowerCase().includes('female')) ??
      pt[0]
    );
  }

  if (id === 'microsoft_pt_br_masculino') {
    return (
      pt.find(v => v.name.toLowerCase().includes('daniel')) ??
      pt.find(v => v.name.toLowerCase().includes('microsoft')) ??
      pt[1] ??
      pt[0]
    );
  }

  return pt[0];
}

// ============= COMPONENTE DO TERMO DE AUTORIZAÇÃO =============
interface TermoModalProps {
  isOpen: boolean;
  onClose: () => void;
  onAccept: (data: TermoData) => void;
}

const TermoModal: React.FC<TermoModalProps> = ({ isOpen, onClose, onAccept }) => {
  const [formData, setFormData] = useState<TermoData>({
    nome: '',
    cpf: '',
    email: '',
    responsavelLegal: '',
    cpfResponsavel: '',
    dataAceite: new Date().toISOString()
  });
  const [erros, setErros] = useState<Record<string, string>>({});
  const [aceito, setAceito] = useState(false);
  const [enviando, setEnviando] = useState(false);
  const [mensagemSucesso, setMensagemSucesso] = useState('');

  const validarCPF = (cpf: string): boolean => {
    const numeros = cpf.replace(/\D/g, '');
    if (numeros.length !== 11) return false;
    let soma = 0;
    let resto;
    for (let i = 1; i <= 9; i++) {
      soma += parseInt(numeros.substring(i - 1, i)) * (11 - i);
    }
    resto = (soma * 10) % 11;
    if (resto === 10 || resto === 11) resto = 0;
    if (resto !== parseInt(numeros.substring(9, 10))) return false;
    soma = 0;
    for (let i = 1; i <= 10; i++) {
      soma += parseInt(numeros.substring(i - 1, i)) * (12 - i);
    }
    resto = (soma * 10) % 11;
    if (resto === 10 || resto === 11) resto = 0;
    if (resto !== parseInt(numeros.substring(10, 11))) return false;
    return true;
  };

  const validarEmail = (email: string): boolean => {
    const regex = /^[^\s@]+@([^\s@]+\.)+[^\s@]+$/;
    return regex.test(email);
  };

  // Resetar formulário quando o modal abrir
  useEffect(() => {
    if (isOpen) {
      setFormData({
        nome: '',
        cpf: '',
        email: '',
        responsavelLegal: '',
        cpfResponsavel: '',
        dataAceite: new Date().toISOString()
      });
      setAceito(false);
      setErros({});
      setMensagemSucesso('');
    }
  }, [isOpen]);

  const handleClose = () => {
    setFormData({
      nome: '',
      cpf: '',
      email: '',
      responsavelLegal: '',
      cpfResponsavel: '',
      dataAceite: new Date().toISOString()
    });
    setAceito(false);
    setErros({});
    setMensagemSucesso('');
    onClose();
  };

  const handleSubmit = async (e: React.FormEvent) => {
    e.preventDefault();
    const novosErros: Record<string, string> = {};

    if (!formData.nome.trim()) novosErros.nome = 'Nome é obrigatório';
    if (!formData.cpf.trim()) novosErros.cpf = 'CPF é obrigatório';
    else if (!validarCPF(formData.cpf)) novosErros.cpf = 'CPF inválido';
    if (!formData.email.trim()) novosErros.email = 'E-mail é obrigatório';
    else if (!validarEmail(formData.email)) novosErros.email = 'E-mail inválido';
    if (!aceito) novosErros.aceite = 'Você precisa aceitar os termos';

    if (Object.keys(novosErros).length > 0) {
      setErros(novosErros);
      return;
    }

    setEnviando(true);
    setMensagemSucesso('');
    
    try {
      const payload = {
        nome: formData.nome,
        cpf: formData.cpf,
        email: formData.email,
        responsavelLegal: formData.responsavelLegal,
        cpfResponsavel: formData.cpfResponsavel,
        dataAceite: new Date().toISOString()
      };
      
      console.log('📤 Enviando termo:', payload);
      
      const response = await fetch(`${API_BASE_URL}/api/fiel/termo-voz`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(payload)
      });
      
      const data = await response.json();
      console.log('📥 Resposta:', data);
      
      if (data.success) {
        setMensagemSucesso('✅ Termo enviado com sucesso! Você receberá um email de confirmação.');
        onAccept(payload);
        setTimeout(() => {
          handleClose();
        }, 2000);
      } else {
        setErros({ submit: data.error || 'Erro ao enviar termo. Tente novamente.' });
      }
    } catch (error: any) {
      console.error('❌ Erro:', error);
      setErros({ submit: `Erro de conexão: ${error.message || 'Verifique sua internet.'}` });
    } finally {
      setEnviando(false);
    }
  };

  if (!isOpen) return null;

  return (
    <div className="fixed inset-0 z-[100] flex items-center justify-center p-4 bg-black/70 overflow-y-auto" onClick={handleClose}>
      <div className="relative w-full max-w-2xl rounded-2xl overflow-hidden shadow-2xl my-auto" onClick={(e) => e.stopPropagation()}>
        <div className="absolute inset-0 bg-gradient-to-br from-blue-800 to-purple-800" />
        <div className="relative bg-white rounded-2xl m-2 shadow-xl overflow-hidden">
          <div className="bg-gradient-to-r from-blue-700 to-purple-700 px-6 py-4 flex justify-between items-center">
            <h2 className="text-xl font-bold text-white flex items-center gap-2">
              <FileText size={20} className="text-yellow-300" />
              Termo de Autorização de Uso de Áudio
            </h2>
            <button onClick={handleClose} className="text-white/80 hover:text-white hover:bg-white/20 rounded-full p-1.5 transition-all">
              <X size={20} />
            </button>
          </div>

          <div className="p-6 max-h-[70vh] overflow-y-auto bg-white">
            <div className="bg-blue-50 p-4 rounded-lg mb-6 text-sm text-gray-700 border border-blue-200">
              <p className="font-bold mb-3 text-center text-blue-800 text-base">TERMO DE AUTORIZAÇÃO DE USO DE ÁUDIO</p>
              <p className="mb-3 text-gray-800">Eu, <span className="font-semibold text-blue-700">[NOME]</span>, portador(a) do CPF <span className="font-semibold text-blue-700">[CPF]</span>,</p>
              <p className="mb-3 text-gray-800">autorizo a gravação em áudio da minha voz, para que possa ser personalizada a Bíblia Online do Site - Santuário Nossa Senhora de Fátima - Santo Amaro - São Paulo-SP, para que no entendimento desta possa eu fiel, ouvir a Bíblia com a minha própria locução interativa, ficando ainda facultativo o uso de outras vozes - locutoras no menu da página.</p>
              <p className="mb-2 text-gray-800">Fica ainda autorizada, de livre e espontânea vontade, para os mesmos fins, a cessão de direitos da veiculação das vozes, não recebendo para tanto qualquer tipo de remuneração.</p>
            </div>

            {mensagemSucesso && (
              <div className="mb-4 p-3 bg-green-100 border border-green-300 rounded-lg text-green-700 text-sm">
                {mensagemSucesso}
              </div>
            )}

            <form onSubmit={handleSubmit} className="space-y-4">
              <div>
                <label className="block text-sm font-semibold text-gray-800 mb-1">Nome Completo *</label>
                <input
                  type="text"
                  value={formData.nome}
                  onChange={(e) => setFormData({ ...formData, nome: e.target.value })}
                  className={`w-full px-4 py-2.5 border rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-transparent bg-white text-gray-800 placeholder-gray-400 ${erros.nome ? 'border-red-500' : 'border-gray-300'}`}
                  placeholder="Digite seu nome completo"
                />
                {erros.nome && <p className="text-red-500 text-xs mt-1">{erros.nome}</p>}
              </div>

              <div>
                <label className="block text-sm font-semibold text-gray-800 mb-1">CPF *</label>
                <input
                  type="text"
                  value={formData.cpf}
                  onChange={(e) => setFormData({ ...formData, cpf: e.target.value.replace(/\D/g, '') })}
                  maxLength={11}
                  className={`w-full px-4 py-2.5 border rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-transparent bg-white text-gray-800 placeholder-gray-400 ${erros.cpf ? 'border-red-500' : 'border-gray-300'}`}
                  placeholder="000.000.000-00"
                />
                {erros.cpf && <p className="text-red-500 text-xs mt-1">{erros.cpf}</p>}
              </div>

              <div>
                <label className="block text-sm font-semibold text-gray-800 mb-1">E-mail *</label>
                <input
                  type="email"
                  value={formData.email}
                  onChange={(e) => setFormData({ ...formData, email: e.target.value })}
                  className={`w-full px-4 py-2.5 border rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-transparent bg-white text-gray-800 placeholder-gray-400 ${erros.email ? 'border-red-500' : 'border-gray-300'}`}
                  placeholder="seu@email.com"
                />
                {erros.email && <p className="text-red-500 text-xs mt-1">{erros.email}</p>}
              </div>

              <div>
                <label className="block text-sm font-semibold text-gray-800 mb-1">Responsável Legal (se menor de idade)</label>
                <input
                  type="text"
                  value={formData.responsavelLegal}
                  onChange={(e) => setFormData({ ...formData, responsavelLegal: e.target.value })}
                  className="w-full px-4 py-2.5 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-transparent bg-white text-gray-800 placeholder-gray-400"
                  placeholder="Nome do responsável"
                />
              </div>

              <div>
                <label className="block text-sm font-semibold text-gray-800 mb-1">CPF do Responsável</label>
                <input
                  type="text"
                  value={formData.cpfResponsavel}
                  onChange={(e) => setFormData({ ...formData, cpfResponsavel: e.target.value.replace(/\D/g, '') })}
                  maxLength={11}
                  className="w-full px-4 py-2.5 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-transparent bg-white text-gray-800 placeholder-gray-400"
                  placeholder="000.000.000-00"
                />
              </div>

              <div className="flex items-start gap-3 pt-2">
                <input
                  type="checkbox"
                  id="aceite"
                  checked={aceito}
                  onChange={(e) => setAceito(e.target.checked)}
                  className="mt-1 w-5 h-5 text-blue-600 rounded focus:ring-blue-500 border-gray-300"
                />
                <label htmlFor="aceite" className="text-sm text-gray-700 leading-relaxed">
                  Declaro que li e concordo com os termos deste documento, autorizando o uso da minha voz para personalização da Bíblia Online do Santuário de Fátima.
                </label>
              </div>
              {erros.aceite && <p className="text-red-500 text-xs">{erros.aceite}</p>}
              {erros.submit && <p className="text-red-500 text-sm text-center bg-red-50 p-2 rounded-lg">{erros.submit}</p>}

              <div className="flex gap-3 pt-4">
                <button
                  type="button"
                  onClick={handleClose}
                  disabled={enviando}
                  className="flex-1 py-2.5 border border-gray-300 rounded-lg hover:bg-gray-50 transition-colors text-gray-700 font-medium"
                >
                  Cancelar
                </button>
                <button
                  type="submit"
                  disabled={enviando}
                  className="flex-1 py-2.5 bg-blue-600 hover:bg-blue-700 text-white rounded-lg transition-colors flex items-center justify-center gap-2 disabled:opacity-50 font-medium"
                >
                  {enviando ? (
                    <>
                      <Loader2 size={18} className="animate-spin" />
                      Enviando...
                    </>
                  ) : (
                    <>
                      <Send size={18} />
                      Aceitar e Continuar
                    </>
                  )}
                </button>
              </div>
            </form>
          </div>
        </div>
      </div>
    </div>
  );
};

// ============= COMPONENTE DE GRAVAÇÃO (CORRIGIDO) =============
interface GravadorProps { versiculo: Versiculo; livro: Livro; capitulo: number; termoAceito?: boolean; onAbrirTermo?: () => void; }

function getMimeType(): string {
  const tipos = ['audio/webm;codecs=opus', 'audio/webm', 'audio/mp4', 'audio/mpeg', 'audio/ogg'];
  for (const tipo of tipos) { 
    if (MediaRecorder.isTypeSupported(tipo)) {
      console.log('✅ MIME type suportado:', tipo);
      return tipo;
    }
  }
  return 'audio/webm';
}

const Gravador = memo(function Gravador({ versiculo, livro, capitulo, termoAceito, onAbrirTermo }: GravadorProps) {
  const [estado, setEstado] = useState<'idle'|'gravando'|'pronto'|'salvando'|'salvo'>('idle');
  const [audioBlob, setAudioBlob] = useState<Blob|null>(null);
  const [audioUrl, setAudioUrl] = useState<string|null>(null);
  const [apelido, setApelido] = useState('');
  const [mostrarForm, setMostrarForm] = useState(false);
  const [erro, setErro] = useState('');
  const [tempoGravacao, setTempoGravacao] = useState(0);
  const [reproduzindo, setReproduzindo] = useState(false);
  const mediaRecorderRef = useRef<MediaRecorder|null>(null);
  const chunksRef = useRef<Blob[]>([]);
  const timerRef = useRef<ReturnType<typeof setInterval>|null>(null);
  const audioRef = useRef<HTMLAudioElement|null>(null);
  const mimeTypeRef = useRef<string>('');
  const streamRef = useRef<MediaStream | null>(null);

  useEffect(() => {
    return () => {
      if (audioUrl) URL.revokeObjectURL(audioUrl);
      if (timerRef.current) clearInterval(timerRef.current);
      if (audioRef.current) {
        audioRef.current.pause();
        audioRef.current = null;
      }
      if (streamRef.current) {
        streamRef.current.getTracks().forEach(track => track.stop());
      }
    };
  }, [audioUrl]);

  const iniciarGravacao = async () => {
    if (!termoAceito) {
      onAbrirTermo?.();
      return;
    }
    
    setErro('');
    try {
      console.log('🎤 Solicitando permissão do microfone...');
      const stream = await navigator.mediaDevices.getUserMedia({
        audio: { 
          echoCancellation: true, 
          noiseSuppression: true, 
          sampleRate: 44100,
          channelCount: 1
        }
      });
      
      streamRef.current = stream;
      chunksRef.current = [];
      mimeTypeRef.current = getMimeType();
      
      const options = mimeTypeRef.current ? { mimeType: mimeTypeRef.current } : {};
      const mr = new MediaRecorder(stream, options);
      mediaRecorderRef.current = mr;
      
      mr.ondataavailable = (e) => { 
        if (e.data && e.data.size > 0) {
          console.log(`📦 Dados recebidos: ${e.data.size} bytes`);
          chunksRef.current.push(e.data);
        }
      };
      
      mr.onstop = () => {
        console.log('🛑 Gravação parada, processando...');
        const blob = new Blob(chunksRef.current, { type: mimeTypeRef.current || 'audio/webm' });
        console.log(`💾 Blob criado: ${blob.size} bytes, tipo: ${blob.type}`);
        
        // Criar URL para reprodução local
        const url = URL.createObjectURL(blob);
        setAudioUrl(url);
        setAudioBlob(blob);
        setEstado('pronto');
        
        if (timerRef.current) {
          clearInterval(timerRef.current);
          timerRef.current = null;
        }
        
        // Parar todas as tracks do stream
        if (streamRef.current) {
          streamRef.current.getTracks().forEach(track => track.stop());
          streamRef.current = null;
        }
      };
      
      mr.start(1000);
      console.log('🔴 Gravação iniciada');
      setEstado('gravando');
      setTempoGravacao(0);
      
      timerRef.current = setInterval(() => {
        setTempoGravacao(t => t + 1);
      }, 1000);
      
    } catch (e: any) {
      console.error('❌ Erro ao acessar microfone:', e);
      const msg = e?.name === 'NotAllowedError' 
        ? 'Permissão negada. Permita o microfone nas configurações do navegador.'
        : e?.name === 'NotFoundError'   
        ? 'Microfone não encontrado neste dispositivo.'
        : `Erro: ${e.message || 'Tente novamente.'}`;
      setErro(msg);
      setEstado('idle');
    }
  };

  const pararGravacao = () => {
    if (mediaRecorderRef.current && mediaRecorderRef.current.state === 'recording') {
      console.log('⏹️ Parando gravação...');
      mediaRecorderRef.current.stop();
    }
  };

  const ouvirGravacao = () => {
    if (!audioUrl) return;
    
    if (audioRef.current && reproduzindo) {
      console.log('⏸️ Parando reprodução');
      audioRef.current.pause();
      audioRef.current = null;
      setReproduzindo(false);
      return;
    }
    
    console.log('🔊 Reproduzindo gravação');
    const a = new Audio(audioUrl);
    audioRef.current = a;
    setReproduzindo(true);
    
    a.onended = () => {
      console.log('✅ Reprodução finalizada');
      setReproduzindo(false);
      audioRef.current = null;
    };
    
    a.onerror = (err) => {
      console.error('❌ Erro na reprodução:', err);
      setReproduzindo(false);
      audioRef.current = null;
    };
    
    a.play().catch(err => {
      console.error('❌ Erro ao reproduzir:', err);
      setReproduzindo(false);
      audioRef.current = null;
    });
  };

  const descartar = () => {
    console.log('🗑️ Descartando gravação');
    if (audioRef.current) {
      audioRef.current.pause();
      audioRef.current = null;
    }
    if (audioUrl) {
      URL.revokeObjectURL(audioUrl);
    }
    setAudioBlob(null);
    setAudioUrl(null);
    setEstado('idle');
    setMostrarForm(false);
    setTempoGravacao(0);
    setErro('');
    setReproduzindo(false);
    chunksRef.current = [];
  };

  const salvar = async () => {
    if (!audioBlob) {
      console.error('❌ Nenhum áudio para salvar');
      return;
    }
    
    setEstado('salvando');
    setErro('');
    
    try {
      console.log('📤 Enviando gravação para o servidor...');
      console.log(`📊 Tamanho do áudio: ${audioBlob.size} bytes`);
      console.log(`📁 Tipo: ${audioBlob.type}`);
      
      // Converter blob para base64
      const reader = new FileReader();
      
      const base64Promise = new Promise<string>((resolve, reject) => {
        reader.onloadend = () => {
          const result = reader.result as string;
          const base64 = result.split(',')[1];
          resolve(base64);
        };
        reader.onerror = reject;
        reader.readAsDataURL(audioBlob);
      });
      
      const base64 = await base64Promise;
      
      const payload = {
        audio: base64,
        mimeType: audioBlob.type,
        livro: livro.abbrev,
        capitulo: capitulo,
        versiculo: versiculo.number,
        texto: versiculo.text,
        apelido: apelido.trim() || 'Anônimo',
      };
      
      console.log('📡 Enviando para:', `${API_BASE_URL}/api/fiel/contribuir-voz`);
      
      const response = await fetch(`${API_BASE_URL}/api/fiel/contribuir-voz`, {
        method: 'POST',
        headers: { 
          'Content-Type': 'application/json',
        },
        body: JSON.stringify(payload),
      });
      
      const data = await response.json();
      console.log('📨 Resposta do servidor:', data);
      
      if (data.success) {
        console.log('✅ Gravação salva com sucesso!');
        setEstado('salvo');
        setTimeout(() => descartar(), 3000);
      } else {
        console.error('❌ Erro do servidor:', data.error);
        setErro(data.error || 'Erro ao salvar gravação.');
        setEstado('pronto');
      }
    } catch (err: any) {
      console.error('❌ Erro de conexão:', err);
      setErro(`Erro de conexão: ${err.message || 'Verifique sua internet e tente novamente.'}`);
      setEstado('pronto');
    }
  };

  const fmt = (s: number) => {
    const mins = Math.floor(s / 60);
    const secs = s % 60;
    return `${mins.toString().padStart(2, '0')}:${secs.toString().padStart(2, '0')}`;
  };

  if (estado === 'salvo') return (
    <div className="flex items-center gap-2 px-3 py-2 bg-green-100 border border-green-300 rounded-xl text-green-700 text-sm font-bold">
      <Check size={14} /> Obrigado! Gravação enviada 🙏
    </div>
  );
  
  if (estado === 'idle') return (
    <button onClick={iniciarGravacao}
      className="flex items-center gap-1.5 px-3 py-2 bg-white/80 hover:bg-purple-100 active:bg-purple-200 border border-purple-300 rounded-xl text-purple-700 text-sm font-bold transition-all active:scale-95">
      <Mic size={14} /> Gravar minha voz
    </button>
  );
  
  if (estado === 'gravando') return (
    <div className="flex items-center gap-3 px-3 py-2 bg-red-50 border border-red-300 rounded-xl">
      <span className="w-2.5 h-2.5 bg-red-500 rounded-full animate-pulse flex-shrink-0" />
      <span className="text-red-700 text-sm font-bold font-mono">{fmt(tempoGravacao)}</span>
      <span className="text-red-600 text-xs flex-1">Gravando...</span>
      <button onClick={pararGravacao}
        className="px-3 py-1.5 bg-red-500 hover:bg-red-600 text-white text-sm font-bold rounded-lg">
        <Square size={12} /> Parar
      </button>
    </div>
  );
  
  return (
    <div className="flex flex-col gap-3 p-3 bg-purple-50 border border-purple-200 rounded-xl w-full">
      {erro && (
        <div className="text-red-600 text-xs bg-red-50 border border-red-200 rounded-lg px-2 py-1.5">
          ⚠️ {erro}
        </div>
      )}
      <div className="flex items-center gap-2 text-purple-600 text-xs">
        <Mic size={12} />
        <span>Gravação: {fmt(tempoGravacao)}</span>
        {audioBlob && (
          <span className="text-purple-400 text-xs ml-2">
            ({Math.round(audioBlob.size / 1024)} KB)
          </span>
        )}
      </div>
      <div className="flex items-center gap-2">
        <button 
          onClick={ouvirGravacao}
          disabled={!audioUrl}
          className={`flex-1 flex items-center justify-center gap-1.5 px-3 py-2 rounded-lg text-sm font-bold ${
            !audioUrl ? 'bg-gray-300 text-gray-500 cursor-not-allowed' :
            reproduzindo ? 'bg-yellow-500 text-white' : 'bg-blue-500 text-white hover:bg-blue-600'
          }`}>
          {reproduzindo ? <><Pause size={12} /> Parar</> : <><Play size={12} /> Ouvir</>}
        </button>
        <button 
          onClick={() => setMostrarForm(true)} 
          disabled={estado === 'salvando' || !audioBlob}
          className="flex-1 flex items-center justify-center gap-1.5 px-3 py-2 bg-green-500 hover:bg-green-600 disabled:bg-gray-400 text-white text-sm font-bold rounded-lg disabled:opacity-50">
          {estado === 'salvando' ? <><Loader2 size={12} className="animate-spin" /> Enviando...</> : <><Check size={12} /> Salvar</>}
        </button>
        <button 
          onClick={descartar} 
          disabled={estado === 'salvando'}
          className="px-3 py-2 bg-red-500 hover:bg-red-600 disabled:bg-gray-400 text-white rounded-lg disabled:opacity-50">
          <Trash2 size={12} />
        </button>
      </div>
      {mostrarForm && estado !== 'salvando' && (
        <div className="flex flex-col gap-2 pt-1 border-t border-purple-200">
          <p className="text-purple-600 text-xs">Seu nome (opcional):</p>
          <div className="flex gap-2">
            <input 
              type="text" 
              placeholder="Ex: João da Silva" 
              value={apelido} 
              onChange={e => setApelido(e.target.value)} 
              maxLength={50}
              className="flex-1 text-sm px-3 py-2 border border-purple-300 rounded-lg bg-white text-gray-700 focus:outline-none focus:ring-2 focus:ring-purple-400" 
            />
            <button 
              onClick={salvar} 
              disabled={!audioBlob}
              className="px-4 py-2 bg-green-600 hover:bg-green-700 disabled:bg-gray-400 text-white text-sm font-bold rounded-lg whitespace-nowrap disabled:opacity-50">
              <Check size={12} /> Enviar
            </button>
          </div>
        </div>
      )}
    </div>
  );
});

// ============= COMPONENTE PRINCIPAL =============
const Biblia = memo(function Biblia() {
  const [livro, setLivro] = useState<Livro|null>(null);
  const [capitulo, setCapitulo] = useState(1);
  const [versiculos, setVersiculos] = useState<Versiculo[]>([]);
  const [carregando, setCarregando] = useState(false);
  const [erro, setErro] = useState('');
  const [ativo, setAtivo] = useState<number|null>(null);
  const [lendo, setLendo] = useState(false);
  const [pausado, setPausado] = useState(false);
  const [velocidade, setVelocidade] = useState(1.0);
  const [vozSelecionada, setVozSelecionada] = useState<Voz>(VOZES_XTTS[0]);
  const [vozesSistema, setVozesSistema] = useState<SpeechSynthesisVoice[]>([]);
  const [vozIdSistema, setVozIdSistema] = useState('google_pt_br_feminino');
  const [modoGravacao, setModoGravacao] = useState(false);
  const [cardAntigoAtivo, setCardAntigoAtivo] = useState(false);
  const [cardNovoAtivo, setCardNovoAtivo] = useState(false);
  const [cardCapitulosAtivo, setCardCapitulosAtivo] = useState(false);
  const [livroSelecionado, setLivroSelecionado] = useState<Livro|null>(null);
  const [popupLeitura, setPopupLeitura] = useState(false);
  const [favoritos, setFavoritos] = useState<Favorito[]>([]);
  const [favoritoSalvo, setFavoritoSalvo] = useState<Set<string>>(new Set());
  const [mensagemFlash, setMensagemFlash] = useState('');
  const [termoAceito, setTermoAceito] = useState(false);
  const [mostrarTermo, setMostrarTermo] = useState(false);

  const versiculosRef = useRef<Versiculo[]>([]);
  const lendoRef = useRef(false);
  const indiceRef = useRef(0);
  const loopRodandoRef = useRef(false);
  const audioAtualRef = useRef<HTMLAudioElement | null>(null);
  const abortControllerRef = useRef<AbortController | null>(null);
  const lerVersiculoDebounceRef = useRef<ReturnType<typeof setTimeout> | null>(null);
  const sessaoRef = useRef(0);

  // Carregar termo aceito do localStorage (apenas se houver usuário logado)
  useEffect(() => {
    const userStr = localStorage.getItem('fiel_user');
    if (userStr) {
      try {
        const user = JSON.parse(userStr);
        if (user.email) {
          const savedTermo = localStorage.getItem(`biblia_termo_aceito_${user.email}`);
          if (savedTermo === 'true') {
            setTermoAceito(true);
          }
        }
      } catch (e) {}
    }
  }, []);

  const handleAceitarTermo = (data: TermoData) => {
    // Verificar se o usuário está logado
    const userStr = localStorage.getItem('fiel_user');
    let userEmail = null;
    
    if (userStr) {
      try {
        const user = JSON.parse(userStr);
        userEmail = user.email;
      } catch (e) {}
    }
    
    // Só salva no localStorage se o usuário estiver logado
    if (userEmail) {
      localStorage.setItem(`biblia_termo_aceito_${userEmail}`, 'true');
    }
    
    setTermoAceito(true);
    setMensagemFlash('✅ Termo de autorização assinado! Você já pode gravar sua voz.');
    setTimeout(() => setMensagemFlash(''), 4000);
  };

  // Enviar versículo para o Painel do Fiel
  const enviarVersiculoParaPainel = (versiculo: Versiculo) => {
    if (!livro) return;
    
    const versiculoData = {
      livro: livro.name,
      capitulo: capitulo,
      versiculo: versiculo.number,
      texto: versiculo.text,
      referencia: `${livro.name} ${capitulo}:${versiculo.number}`
    };
    
    window.dispatchEvent(new CustomEvent('versiculo-favoritado', { detail: versiculoData }));
    setMensagemFlash(`✨ "${livro.name} ${capitulo}:${versiculo.number}" adicionado aos favoritos!`);
    setTimeout(() => setMensagemFlash(''), 3000);
    
    const userStr = localStorage.getItem('fiel_user');
    if (userStr) {
      try {
        const user = JSON.parse(userStr);
        if (user.id) {
          fetch(`${API_BASE_URL}/api/fiel/versiculos`, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json', 'Authorization': `Bearer ${localStorage.getItem('fiel_token')}` },
            body: JSON.stringify({ userId: user.id, versiculo: versiculoData })
          }).catch(() => {});
        }
      } catch (e) {}
    }
  };

  // Carregar favoritos
  useEffect(() => {
    const savedFavoritos = localStorage.getItem('biblia_favoritos');
    if (savedFavoritos) {
      const parsed = JSON.parse(savedFavoritos);
      setFavoritos(parsed);
      const favoritoSet = new Set(parsed.map((f: Favorito) => `${f.livroAbbrev}_${f.capitulo}_${f.versiculo}`));
      setFavoritoSalvo(favoritoSet);
    }
  }, []);

  const salvarFavoritos = (novosFavoritos: Favorito[]) => {
    localStorage.setItem('biblia_favoritos', JSON.stringify(novosFavoritos));
    setFavoritos(novosFavoritos);
    const favoritoSet = new Set(novosFavoritos.map(f => `${f.livroAbbrev}_${f.capitulo}_${f.versiculo}`));
    setFavoritoSalvo(favoritoSet);
  };

  const adicionarFavorito = (versiculo: Versiculo) => {
    if (!livro) return;
    const chave = `${livro.abbrev}_${capitulo}_${versiculo.number}`;
    if (favoritoSalvo.has(chave)) {
      const novosFavoritos = favoritos.filter(f => !(f.livroAbbrev === livro.abbrev && f.capitulo === capitulo && f.versiculo === versiculo.number));
      salvarFavoritos(novosFavoritos);
      setMensagemFlash(`🗑️ "${livro.name} ${capitulo}:${versiculo.number}" removido!`);
      setTimeout(() => setMensagemFlash(''), 2000);
    } else {
      const novoFavorito: Favorito = {
        id: `${Date.now()}_${Math.random()}`,
        livro: livro.name,
        livroAbbrev: livro.abbrev,
        capitulo: capitulo,
        versiculo: versiculo.number,
        texto: versiculo.text,
        data: new Date().toISOString()
      };
      salvarFavoritos([novoFavorito, ...favoritos]);
      enviarVersiculoParaPainel(versiculo);
    }
  };

  const isFavorito = (versiculo: Versiculo): boolean => {
    if (!livro) return false;
    return favoritoSalvo.has(`${livro.abbrev}_${capitulo}_${versiculo.number}`);
  };

  // Vozes do sistema
  useEffect(() => {
    if ('speechSynthesis' in window) {
      const load = () => {
        const todas = window.speechSynthesis.getVoices();
        const pt = todas.filter(v => v.lang === 'pt-BR' || v.lang === 'pt_BR' || v.lang.startsWith('pt'));
        setVozesSistema(pt.length > 0 ? pt : todas);
      };
      load();
      window.speechSynthesis.onvoiceschanged = load;
    }
  }, []);

  useEffect(() => {
    return () => {
      sessaoRef.current++;
      lendoRef.current = false;
      loopRodandoRef.current = false;
      abortControllerRef.current?.abort();
      if (audioAtualRef.current) {
        audioAtualRef.current.pause();
        audioAtualRef.current.src = '';
        audioAtualRef.current = null;
      }
      if (!Capacitor.isNativePlatform()) window.speechSynthesis?.cancel();
      else TextToSpeech.stop().catch(() => {});
    };
  }, []);

  const tocarAudio = useCallback((url: string, rate = 1.0, timeoutMs = 30000): Promise<void> => {
    return new Promise((resolve, reject) => {
      if (audioAtualRef.current) {
        audioAtualRef.current.pause();
        audioAtualRef.current.src = '';
        audioAtualRef.current = null;
      }
      const audio = new Audio(url);
      audio.playbackRate = rate;
      audioAtualRef.current = audio;
      const timer = setTimeout(() => {
        audio.pause(); audio.src = ''; audioAtualRef.current = null;
        reject(new Error('Timeout'));
      }, timeoutMs);
      audio.onended = () => { clearTimeout(timer); audioAtualRef.current = null; resolve(); };
      audio.onerror = () => { clearTimeout(timer); audioAtualRef.current = null; reject(new Error('Erro ao tocar')); };
      audio.play().catch(e => { clearTimeout(timer); audioAtualRef.current = null; reject(e); });
    });
  }, []);

  const falarSistema = useCallback((numero: number, textoVersiculo: string, sessao: number): Promise<boolean> => {
    return new Promise((resolve) => {
      if (sessaoRef.current !== sessao) { resolve(false); return; }
      const textoLimpo = limparTextoTTS(textoVersiculo);
      const vozEscolhida = vozSelecionada.tipo === 'sistema'
        ? selecionarVozSistema(vozIdSistema, vozesSistema)
        : selecionarVozSistema('google_pt_br_feminino', vozesSistema);

      const falar = (txt: string, onFim: () => void) => {
        if (sessaoRef.current !== sessao) { resolve(false); return; }
        if (Capacitor.isNativePlatform()) {
          TextToSpeech.speak({ text: txt, lang: 'pt-BR', rate: velocidade, pitch: 1.0, volume: 1.0 })
            .then(onFim).catch(onFim);
          return;
        }
        if ('speechSynthesis' in window) {
          window.speechSynthesis.cancel();
          const u = new SpeechSynthesisUtterance(txt);
          u.lang = 'pt-BR';
          u.rate = velocidade;
          if (vozEscolhida) u.voice = vozEscolhida;
          u.onend = onFim;
          u.onerror = onFim;
          window.speechSynthesis.speak(u);
        } else { onFim(); }
      };

      falar(String(numero), () => {
        if (sessaoRef.current !== sessao) { resolve(false); return; }
        setTimeout(() => {
          if (sessaoRef.current !== sessao) { resolve(false); return; }
          falar(textoLimpo, () => resolve(sessaoRef.current === sessao));
        }, 700);
      });
    });
  }, [velocidade, vozesSistema, vozSelecionada, vozIdSistema]);

  const falarTexto = useCallback(async (numero: number, textoVersiculo: string, sessao: number): Promise<boolean> => {
    if (sessaoRef.current !== sessao) return false;
    if (vozSelecionada.tipo === 'sistema') {
      return falarSistema(numero, textoVersiculo, sessao);
    }
    if (vozSelecionada.tipo === 'xtts' && livro) {
      const urlR2 = `${R2_PUBLIC_URL}/audio/${vozSelecionada.id}/${livro.abbrev}/${capitulo}/${numero}.wav`;
      const controller = new AbortController();
      abortControllerRef.current = controller;
      try {
        await tocarAudio(urlR2, velocidade, 30000);
        return sessaoRef.current === sessao;
      } catch (error: any) {
        if (sessaoRef.current !== sessao || error.name === 'AbortError') return false;
        return falarSistema(numero, textoVersiculo, sessao);
      } finally {
        abortControllerRef.current = null;
      }
    }
    return falarSistema(numero, textoVersiculo, sessao);
  }, [vozSelecionada, livro, capitulo, velocidade, tocarAudio, falarSistema]);

  const pararLeitura = useCallback(() => {
    sessaoRef.current++;
    lendoRef.current = false;
    loopRodandoRef.current = false;
    abortControllerRef.current?.abort();
    abortControllerRef.current = null;
    if (audioAtualRef.current) {
      audioAtualRef.current.pause();
      audioAtualRef.current.src = '';
      audioAtualRef.current = null;
    }
    if (!Capacitor.isNativePlatform()) window.speechSynthesis?.cancel();
    else TextToSpeech.stop().catch(() => {});
    setLendo(false); setPausado(false); setAtivo(null);
  }, []);

  const lerProximo = useCallback(async (sessao: number) => {
    if (loopRodandoRef.current) return;
    loopRodandoRef.current = true;
    try {
      while (lendoRef.current && sessaoRef.current === sessao) {
        const lista = versiculosRef.current;
        const idx = indiceRef.current;
        if (idx >= lista.length) { setLendo(false); setAtivo(null); lendoRef.current = false; break; }
        const v = lista[idx];
        setAtivo(v.number);
        document.getElementById(`v-${v.number}`)?.scrollIntoView({ behavior: 'smooth', block: 'center' });
        await pausaMs(50);
        if (!lendoRef.current || sessaoRef.current !== sessao) break;
        if (vozSelecionada?.tipo === 'xtts' && livro && idx + 1 < lista.length) {
          const prox = lista[idx + 1];
          const urlProx = `${R2_PUBLIC_URL}/audio/${vozSelecionada.id}/${livro.abbrev}/${capitulo}/${prox.number}.wav`;
          const link = document.createElement('link');
          link.rel = 'prefetch'; link.href = urlProx; link.as = 'audio';
          document.head.appendChild(link);
          setTimeout(() => link.remove(), 30000);
        }
        const sucesso = await falarTexto(v.number, v.text, sessao);
        if (!lendoRef.current || sessaoRef.current !== sessao) break;
        if (!sucesso) { setLendo(false); setAtivo(null); lendoRef.current = false; break; }
        indiceRef.current++;
      }
    } finally {
      loopRodandoRef.current = false;
    }
  }, [falarTexto, vozSelecionada, livro, capitulo]);

  const carregarCapitulo = useCallback(async () => {
    if (!livro) return;
    setCarregando(true); setErro('');
    pararLeitura();
    try {
      const cacheKey = `${livro.pasta}_${capitulo}`;
      if (capituloCache.has(cacheKey)) {
        const lista = capituloCache.get(cacheKey)!;
        setVersiculos(lista); versiculosRef.current = lista; return;
      }
      const res = await fetch(`${LOCAL_BASE_URL}/${livro.pasta}/${capitulo}.json`);
      if (!res.ok) throw new Error(`Erro ${res.status}`);
      const data = await res.json();
      let lista: Versiculo[] = [];
      if (data.versiculos && Array.isArray(data.versiculos)) {
        lista = data.versiculos.map((v: any) => ({ number: v.number, text: v.text }));
      } else if (Array.isArray(data)) {
        lista = data.map((text: string, i: number) => ({ number: i + 1, text }));
      }
      capituloCache.set(cacheKey, lista);
      setVersiculos(lista); versiculosRef.current = lista;
    } catch(e: any) { setErro(e.message); setVersiculos([]); }
    finally { setCarregando(false); }
  }, [livro, capitulo, pararLeitura]);

  useEffect(() => { if (livro) carregarCapitulo(); }, [livro, capitulo, carregarCapitulo]);

  const iniciarLeitura = useCallback((lista?: Versiculo[], indiceInicial = 0) => {
    const vss = lista ?? versiculos;
    if (vss.length === 0) return;
    if (!Capacitor.isNativePlatform()) window.speechSynthesis?.cancel();
    versiculosRef.current = vss;
    indiceRef.current = indiceInicial;
    lendoRef.current = true;
    loopRodandoRef.current = false;
    setLendo(true); setPausado(false);
    const sessaoAtual = sessaoRef.current;
    setTimeout(() => lerProximo(sessaoAtual), 100);
  }, [versiculos, lerProximo]);

  const pausarLeitura = useCallback(() => {
    if (!Capacitor.isNativePlatform()) window.speechSynthesis?.pause();
    else if (audioAtualRef.current) audioAtualRef.current.pause();
    setPausado(true);
  }, []);

  const continuarLeitura = useCallback(() => {
    if (!Capacitor.isNativePlatform()) window.speechSynthesis?.resume();
    else if (lendoRef.current) {
      loopRodandoRef.current = false;
      const sessaoAtual = sessaoRef.current;
      setTimeout(() => lerProximo(sessaoAtual), 50);
    }
    setPausado(false);
  }, [lerProximo]);

  const lerVersiculo = useCallback((v: Versiculo) => {
    if (modoGravacao) return;
    if (lerVersiculoDebounceRef.current) clearTimeout(lerVersiculoDebounceRef.current);
    pararLeitura();
    lerVersiculoDebounceRef.current = setTimeout(() => {
      const idx = versiculos.findIndex(item => item.number === v.number);
      if (idx === -1) return;
      versiculosRef.current = versiculos;
      indiceRef.current = idx;
      lendoRef.current = true;
      loopRodandoRef.current = false;
      setAtivo(v.number); setLendo(true); setPausado(false);
      const sessaoAtual = sessaoRef.current;
      lerProximo(sessaoAtual);
    }, 400);
  }, [modoGravacao, versiculos, pararLeitura, lerProximo]);

  const selecionarLivro = (l: Livro) => { setLivroSelecionado(l); setCardCapitulosAtivo(true); };

  const selecionarCapitulo = useCallback((cap: number) => {
    if (!livroSelecionado) return;
    pararLeitura();
    setLivro(livroSelecionado);
    setCapitulo(cap);
    setCardCapitulosAtivo(false);
    setPopupLeitura(true);
    if (!modoGravacao) {
      setTimeout(() => { if (versiculosRef.current.length > 0) iniciarLeitura(versiculosRef.current, 0); }, 800);
    }
  }, [livroSelecionado, modoGravacao, pararLeitura, iniciarLeitura]);

  const voltarParaLivros = () => { setCardCapitulosAtivo(false); setLivroSelecionado(null); };
  const fecharTudoEParar = () => { pararLeitura(); setCardAntigoAtivo(false); setCardNovoAtivo(false); setCardCapitulosAtivo(false); setPopupLeitura(false); setLivroSelecionado(null); };
  const getSelectValue = () => vozSelecionada.tipo === 'xtts' ? vozSelecionada.id : vozIdSistema;

  return (
    <div className="min-h-screen flex flex-col bg-blue-50">
      {/* Mensagem Flash */}
      {mensagemFlash && (
        <div className="fixed top-24 left-1/2 transform -translate-x-1/2 z-50 bg-green-500 text-white px-4 py-2 rounded-full shadow-lg text-sm animate-fade-in">
          {mensagemFlash}
        </div>
      )}

      {/* Termo Modal */}
      <TermoModal isOpen={mostrarTermo} onClose={() => setMostrarTermo(false)} onAccept={handleAceitarTermo} />

      <section className="relative w-full bg-gray-900 mt-08">
        <div className="relative h-[400px] sm:h-[400px] md:h-[500px] lg:h-[600px] overflow-hidden">
          <img src="/liturgianovo.png" alt="Bíblia Sagrada" className="absolute inset-0 w-full h-full object-cover object-center" onError={(e) => { e.currentTarget.src = '/fachada2.png'; }} />
          <div className="absolute inset-0 bg-gradient-to-t from-black/70 via-black/50 to-transparent" />
          <div className="relative z-10 h-full flex flex-col items-center justify-center">
            <div className="text-center px-4 max-w-4xl mx-auto">
              <h1 className="text-4xl sm:text-5xl md:text-6xl lg:text-7xl font-bold text-white drop-shadow-lg mb-4">Bíblia Online</h1>
              <p className="text-lg sm:text-xl md:text-2xl text-white/90 max-w-3xl mx-auto px-4 drop-shadow-md">A Palavra de Deus sempre ao seu alcance</p>
            </div>
          </div>
        </div>
        <div className="absolute bottom-0 left-0 right-0 h-1 bg-gradient-to-r from-blue-500 via-green-500 to-blue-500" />
      </section>

      <main className="flex-grow max-w-7xl mx-auto w-full px-3 sm:px-6 py-8 md:py-12 bg-blue-50">
        <div className="flex flex-col items-center gap-6">
          <h2 className="text-2xl md:text-3xl font-bold text-gray-800 text-center mb-4">Escolha o Testamento</h2>
          <div className="grid grid-cols-1 md:grid-cols-2 gap-6 w-full max-w-4xl relative">
            {/* ANTIGO TESTAMENTO - mantido igual */}
            <div className={`relative h-96 overflow-hidden rounded-2xl shadow-2xl transition-all duration-300 group cursor-pointer ${!cardAntigoAtivo && !cardNovoAtivo ? 'hover:scale-105 hover:shadow-xl hover:border-2 hover:border-yellow-400' : ''}`} onClick={() => { if (!cardAntigoAtivo && !cardNovoAtivo) { setCardAntigoAtivo(true); setCardNovoAtivo(false); } }}>
              <div className={`absolute inset-0 transition-all duration-500 ease-in-out ${cardAntigoAtivo ? 'opacity-0 pointer-events-none' : 'opacity-100'}`}>
                <img src="/VelhoTestamento.png" alt="Antigo Testamento" className="w-full h-full object-cover" onError={(e) => { e.currentTarget.style.display='none'; }} />
                <div className="absolute inset-0 bg-gradient-to-t from-black/90 via-black/50 to-transparent" />
                <div className="absolute inset-0 flex flex-col items-center justify-end pb-8 px-4">
                  <p className="text-yellow-300 text-xs font-bold uppercase tracking-widest mb-2">📜 46 Livros</p>
                  <h3 className="text-2xl sm:text-3xl font-bold text-white drop-shadow-lg text-center mb-2">Antigo Testamento</h3>
                  <p className="text-white/80 text-sm mb-3 text-center">Da Criação aos Profetas</p>
                  <div className="px-6 py-2.5 bg-yellow-500 hover:bg-yellow-400 text-gray-900 font-bold rounded-full text-sm transition-colors flex items-center gap-2">Ver livros <ChevronRightIcon size={16} /></div>
                </div>
              </div>
              <div className={`absolute inset-0 transition-all duration-500 ease-in-out overflow-hidden ${cardAntigoAtivo ? 'translate-x-0 opacity-100 z-20' : '-translate-x-full opacity-0 z-0'}`}>
                <div className="absolute inset-0" style={{ backgroundImage:`url('/textobiblico.png')`, backgroundSize:'cover', backgroundPosition:'center' }} />
                <div className="relative h-full flex flex-col">
                  <div className="sticky top-0 bg-gradient-to-r from-yellow-700 to-yellow-600 text-white p-4 rounded-b-lg shadow-lg flex justify-between items-center">
                    <div className="flex items-center gap-2"><BookOpen size={20} /><span className="font-bold">Antigo Testamento</span></div>
                    <button onClick={(e) => { e.stopPropagation(); fecharTudoEParar(); }} className="hover:bg-yellow-800 p-1.5 rounded-lg transition-colors"><X size={18} /></button>
                  </div>
                  <div className="flex-1 overflow-y-auto p-3 space-y-1 bg-black/20 backdrop-blur-[2px]">
                    {ANTIGO.map((l, index) => (
                      <button key={l.abbrev} onClick={(e) => { e.stopPropagation(); selecionarLivro(l); }} className="w-full text-left p-3 bg-white/90 hover:bg-yellow-100 rounded-lg border-l-4 border-yellow-500 shadow-sm hover:shadow-md transition-all flex justify-between items-center group">
                        <div className="flex items-center gap-2">
                          <span className="text-xs font-bold text-yellow-600 w-6 h-6 flex items-center justify-center bg-yellow-100 rounded-full group-hover:bg-yellow-200">{String(index+1).padStart(2,'0')}</span>
                          <span className="font-medium text-gray-800">{l.name}</span>
                        </div>
                        <span className="text-xs bg-yellow-200 text-yellow-800 px-2 py-1 rounded-full font-bold">{l.chapters}</span>
                      </button>
                    ))}
                  </div>
                </div>
              </div>
            </div>

            {/* NOVO TESTAMENTO - mantido igual */}
            <div className={`relative h-96 overflow-hidden rounded-2xl shadow-2xl transition-all duration-300 group cursor-pointer ${!cardAntigoAtivo && !cardNovoAtivo ? 'hover:scale-105 hover:shadow-xl hover:border-2 hover:border-blue-400' : ''}`} onClick={() => { if (!cardAntigoAtivo && !cardNovoAtivo) { setCardNovoAtivo(true); setCardAntigoAtivo(false); } }}>
              <div className={`absolute inset-0 transition-all duration-500 ease-in-out ${cardNovoAtivo ? 'opacity-0 pointer-events-none' : 'opacity-100'}`}>
                <img src="/NovoTestamento.png" alt="Novo Testamento" className="w-full h-full object-cover" onError={(e) => { e.currentTarget.style.display='none'; }} />
                <div className="absolute inset-0 bg-gradient-to-t from-black/90 via-black/50 to-transparent" />
                <div className="absolute inset-0 flex flex-col items-center justify-end pb-8 px-4">
                  <p className="text-blue-300 text-xs font-bold uppercase tracking-widest mb-2">✝️ 27 Livros</p>
                  <h3 className="text-2xl sm:text-3xl font-bold text-white drop-shadow-lg text-center mb-2">Novo Testamento</h3>
                  <p className="text-white/80 text-sm mb-3 text-center">Evangelhos e Cartas Apostólicas</p>
                  <div className="px-6 py-2.5 bg-blue-500 hover:bg-blue-400 text-white font-bold rounded-full text-sm transition-colors flex items-center gap-2">Ver livros <ChevronRightIcon size={16} /></div>
                </div>
              </div>
              <div className={`absolute inset-0 transition-all duration-500 ease-in-out overflow-hidden ${cardNovoAtivo ? 'translate-x-0 opacity-100 z-20' : 'translate-x-full opacity-0 z-0'}`}>
                <div className="absolute inset-0" style={{ backgroundImage:`url('/textobiblico.png')`, backgroundSize:'cover', backgroundPosition:'center' }} />
                <div className="relative h-full flex flex-col">
                  <div className="sticky top-0 bg-gradient-to-r from-blue-700 to-blue-600 text-white p-4 rounded-b-lg shadow-lg flex justify-between items-center">
                    <div className="flex items-center gap-2"><BookOpen size={20} /><span className="font-bold">Novo Testamento</span></div>
                    <button onClick={(e) => { e.stopPropagation(); fecharTudoEParar(); }} className="hover:bg-blue-800 p-1.5 rounded-lg transition-colors"><X size={18} /></button>
                  </div>
                  <div className="flex-1 overflow-y-auto p-3 space-y-1 bg-black/20 backdrop-blur-[2px]">
                    {NOVO.map((l, index) => (
                      <button key={l.abbrev} onClick={(e) => { e.stopPropagation(); selecionarLivro(l); }} className="w-full text-left p-3 bg-white/90 hover:bg-blue-100 rounded-lg border-l-4 border-blue-500 shadow-sm hover:shadow-md transition-all flex justify-between items-center group">
                        <div className="flex items-center gap-2">
                          <span className="text-xs font-bold text-blue-600 w-6 h-6 flex items-center justify-center bg-blue-100 rounded-full group-hover:bg-blue-200">{String(index+1).padStart(2,'0')}</span>
                          <span className="font-medium text-gray-800">{l.name}</span>
                        </div>
                        <span className="text-xs bg-blue-200 text-blue-800 px-2 py-1 rounded-full font-bold">{l.chapters}</span>
                      </button>
                    ))}
                  </div>
                </div>
              </div>
            </div>
          </div>

          {/* SELEÇÃO DE CAPÍTULOS */}
          {cardCapitulosAtivo && livroSelecionado && (
            <div className="fixed inset-0 z-40 flex items-start justify-center pt-20 pb-8 px-4 bg-black/60 overflow-y-auto" onClick={fecharTudoEParar}>
              <div className="relative w-full max-w-4xl rounded-2xl overflow-hidden shadow-2xl border-2 border-blue-400 my-auto" onClick={(e) => e.stopPropagation()}>
                <div className="absolute inset-0" style={{ backgroundImage:`url('/textobiblico.png')`, backgroundSize:'cover', backgroundPosition:'center' }} />
                <div className="relative bg-gradient-to-r from-blue-700 to-blue-600 p-4 sm:p-6">
                  <div className="flex items-center justify-between">
                    <div className="flex items-center gap-3">
                      <BookOpen className="text-blue-200" size={24} />
                      <div><h3 className="text-xl font-bold text-white">{livroSelecionado.name}</h3><p className="text-blue-200 text-sm">Escolha o capítulo</p></div>
                    </div>
                    <button onClick={fecharTudoEParar} className="text-white/80 hover:text-white bg-white/10 hover:bg-white/20 rounded-lg p-2 transition-all"><X size={20} /></button>
                  </div>
                </div>
                <div className="relative bg-black/20 backdrop-blur-[2px] p-3 border-b border-white/20">
                  <button onClick={voltarParaLivros} className="flex items-center gap-2 text-white hover:text-blue-200 font-medium transition-colors drop-shadow-lg"><ChevronLeft size={18} /> Voltar para lista de livros</button>
                </div>
                <div className="relative bg-black/20 backdrop-blur-[2px] p-6 overflow-y-auto max-h-[50vh]">
                  <div className="grid grid-cols-4 sm:grid-cols-6 md:grid-cols-8 lg:grid-cols-10 gap-3">
                    {Array.from({length: livroSelecionado.chapters}, (_, i) => i+1).map((cap) => (
                      <button key={cap} onClick={() => selecionarCapitulo(cap)} className="aspect-square flex items-center justify-center bg-white/90 hover:bg-blue-600 hover:text-white rounded-lg border-2 border-white/50 font-bold text-blue-900 transition-all hover:scale-110 hover:shadow-md">{cap}</button>
                    ))}
                  </div>
                </div>
              </div>
            </div>
          )}

          {/* POPUP DE LEITURA */}
          {popupLeitura && livro && (
            <div className="fixed inset-0 z-50 flex items-start justify-center pt-20 pb-8 px-4 bg-black/70 overflow-y-auto" onClick={fecharTudoEParar}>
              <div className="relative w-full max-w-4xl rounded-2xl overflow-hidden shadow-2xl border-2 border-blue-400 my-auto" onClick={(e) => e.stopPropagation()}>
                <div className="absolute inset-0" style={{ backgroundImage:`url('/textobiblico.png')`, backgroundSize:'cover', backgroundPosition:'center' }} />

                {/* Cabeçalho */}
                <div className="relative bg-gradient-to-r from-[#0d2247] to-[#1a3a6e] p-4 sm:p-6">
                  <div className="flex items-center justify-between">
                    <div className="flex items-center gap-3">
                      <BookOpen className="text-blue-300" size={24} />
                      <div><h3 className="text-xl font-bold text-white">{livro.name}</h3><p className="text-blue-200 text-sm">Capítulo {capitulo}</p></div>
                    </div>
                    <div className="flex items-center gap-2">
                      <button onClick={() => { setModoGravacao(m => !m); if (!modoGravacao) pararLeitura(); }} className={`flex items-center gap-1.5 px-3 py-1.5 rounded-lg text-xs font-bold transition-all ${modoGravacao ? 'bg-yellow-600 text-white shadow-lg shadow-yellow-500/40' : 'bg-white/10 hover:bg-purple-500/30 text-white/80 hover:text-white'}`}>
                        {modoGravacao ? <MicOff size={14} /> : <Mic size={14} />}
                        {modoGravacao ? 'Sair' : 'Contribuir'}
                      </button>
                      <button onClick={fecharTudoEParar} className="text-white/80 hover:text-white bg-white/10 hover:bg-white/20 rounded-lg p-2 transition-all"><X size={20} /></button>
                    </div>
                  </div>

                  {/* AVISO VERMELHO */}
                  {modoGravacao && !termoAceito && (
                    <div className="mt-3 px-4 py-3 bg-red-600/90 border border-red-500 rounded-lg text-white text-sm flex items-center justify-between shadow-lg">
                      <div className="flex items-center gap-2">
                        <AlertTriangle size={20} className="text-yellow-300" />
                        <span className="font-medium">Para gravar sua voz, você precisa aceitar o Termo de Autorização</span>
                      </div>
                      <button 
                        onClick={() => setMostrarTermo(true)} 
                        className="px-4 py-1.5 bg-white text-red-600 hover:bg-gray-100 rounded-lg text-xs font-bold transition-colors shadow-md"
                      >
                        Aceitar Termo Agora
                      </button>
                    </div>
                  )}

                  {modoGravacao && termoAceito && (
                    <div className="mt-3 px-3 py-2 bg-purple-500/30 border border-purple-400/50 rounded-lg text-purple-100 text-xs">
                      🎙️ <strong>Modo contribuição</strong> — clique em <strong>Gravar minha voz</strong> ao lado de qualquer versículo!
                    </div>
                  )}

                  <div className="flex items-center gap-2 mt-4">
                    <button onClick={() => { pararLeitura(); setCapitulo(c => Math.max(1, c-1)); }} disabled={capitulo <= 1} className="p-1.5 bg-white/10 hover:bg-white/20 text-white rounded disabled:opacity-30"><ChevronLeft size={18} /></button>
                    <span className="text-white text-sm font-semibold flex-1 text-center">Capítulo {capitulo} de {livro.chapters}</span>
                    <button onClick={() => { pararLeitura(); setCapitulo(c => Math.min(livro.chapters, c+1)); }} disabled={capitulo >= livro.chapters} className="p-1.5 bg-white/10 hover:bg-white/20 text-white rounded disabled:opacity-30"><ChevronRight size={18} /></button>
                  </div>
                </div>

                {/* Controles de voz */}
                {!modoGravacao && (
                  <div className="relative bg-black/20 backdrop-blur-[2px] px-4 py-3 border-b border-white/20 flex flex-wrap items-center gap-2">
                    <Volume2 size={16} className="text-white drop-shadow-lg" />
                    <span className="text-sm font-bold text-white drop-shadow-lg">Voz:</span>
                    <select value={getSelectValue()} onChange={(e) => { const id = e.target.value; pararLeitura(); const vozXtts = VOZES_XTTS.find(v => v.id === id); if (vozXtts) setVozSelecionada(vozXtts); else { setVozIdSistema(id); setVozSelecionada({ id, nome: id, tipo: 'sistema' }); } }} className="bg-white/90 text-gray-800 text-sm rounded-lg px-2 py-1 border border-white/50 min-w-[240px]">
                      {VOZES_XTTS.length > 0 && (<optgroup label="── Vozes IA (XTTS) ──">{VOZES_XTTS.map(v => (<option key={v.id} value={v.id}>{v.nome}</option>))}</optgroup>)}
                      <optgroup label="── Vozes do Sistema ──">
                        <option value="google_pt_br_feminino">Google - Português do Brasil</option>
                        <option value="microsoft_pt_br_masculino">Microsoft Daniel - Português</option>
                        <option value="sistema_dinamico">Voz padrão do dispositivo</option>
                      </optgroup>
                    </select>
                    {vozSelecionada.tipo === 'xtts' && vozSelecionada.id === 'ayres' && (<span className="text-xs bg-purple-500/80 text-white px-2 py-0.5 rounded-full">IA · Fatima</span>)}
                    {vozSelecionada.tipo === 'xtts' && vozSelecionada.id === 'minhavoz' && termoAceito && (<span className="text-xs bg-green-500/80 text-white px-2 py-0.5 rounded-full animate-pulse">🎙️ Minha Voz - Personalizada</span>)}
                    {vozSelecionada.tipo === 'xtts' && vozSelecionada.id === 'minhavoz' && !termoAceito && (<span className="text-xs bg-gray-500/80 text-white px-2 py-0.5 rounded-full">🔒 Minha Voz (Aceite o termo)</span>)}
                    {vozSelecionada.tipo === 'sistema' && (<span className="text-xs bg-blue-500/80 text-white px-2 py-0.5 rounded-full">Sistema</span>)}

                    <div className="flex items-center gap-2 ml-2">
                      {!lendo ? (<button onClick={() => iniciarLeitura()} disabled={versiculos.length === 0 || carregando} className={`flex items-center gap-1.5 px-3 py-1.5 rounded-lg text-sm transition-colors shadow-lg ${versiculos.length === 0 || carregando ? 'bg-gray-400 cursor-not-allowed opacity-50' : 'bg-blue-600 hover:bg-blue-700 text-white'}`}><Play size={13} /> Ler capítulo</button>) : (<>{!pausado ? <button onClick={pausarLeitura} className="flex items-center gap-1.5 bg-yellow-500 hover:bg-yellow-600 text-white px-3 py-1.5 rounded-lg text-sm"><Pause size={13} /> Pausar</button> : <button onClick={continuarLeitura} className="flex items-center gap-1.5 bg-green-600 hover:bg-green-700 text-white px-3 py-1.5 rounded-lg"><Play size={13} /> Continuar</button>}<button onClick={pararLeitura} className="flex items-center gap-1.5 bg-red-500 hover:bg-red-600 text-white px-3 py-1.5 rounded-lg"><VolumeX size={13} /> Parar</button></>)}
                    </div>

                    <div className="flex items-center gap-1 ml-auto flex-wrap">
                      {[{v:0.7, label:'Lento', cls:'bg-green-100/90 text-green-800'},{v:1.0, label:'Normal', cls:'bg-blue-100/90 text-blue-800'},{v:1.3, label:'Rápido', cls:'bg-orange-100/90 text-orange-800'},{v:1.6, label:'Veloz', cls:'bg-red-100/90 text-red-800'}].map(({v, label, cls}) => (<button key={v} onClick={() => setVelocidade(v)} className={`px-2 py-0.5 rounded border text-xs font-bold transition-all ${cls} ${velocidade === v ? 'ring-2 ring-blue-500 ring-offset-1 scale-105' : 'opacity-70 hover:opacity-100'}`}>{label}</button>))}
                    </div>
                  </div>
                )}

                {/* Versículos */}
                <div className="relative bg-black/20 backdrop-blur-[2px] p-4 sm:p-6 overflow-y-auto max-h-[50vh]">
                  {erro && <div className="mb-4 p-3 bg-red-50/90 border border-red-300 rounded-lg text-red-700 text-sm">⚠️ {erro}</div>}
                  {carregando ? (<div className="flex flex-col items-center justify-center h-48 gap-3"><div className="animate-spin rounded-full h-10 w-10 border-b-2 border-white" /><p className="text-white drop-shadow-lg text-sm">Carregando versículos...</p></div>) : versiculos.length === 0 && !erro ? (<div className="flex flex-col items-center justify-center h-48 gap-3"><p className="text-white/70 text-sm">Selecione um capítulo para começar</p></div>) : (
                    <div className="space-y-2">
                      {versiculos.map(v => (
                        <div key={v.number} id={`v-${v.number}`} className={`flex flex-col gap-2 p-3 rounded-lg transition-all duration-200 ${ativo === v.number ? 'bg-blue-100/90 border-l-4 border-blue-600 shadow-sm' : 'bg-white/80 border-l-4 border-transparent'}`}>
                          <div className={`flex gap-3 items-start ${modoGravacao ? '' : 'cursor-pointer group'}`} onClick={() => !modoGravacao && lerVersiculo(v)}>
                            <div className="flex items-center gap-2">
                              <span className={`flex-shrink-0 w-7 h-7 rounded-full flex items-center justify-center text-xs font-bold transition-all ${ativo === v.number ? 'bg-blue-600 text-white' : 'bg-blue-100 text-blue-700 group-hover:bg-blue-600 group-hover:text-white'}`}>{v.number}</span>
                              <button onClick={(e) => { e.stopPropagation(); adicionarFavorito(v); }} className={`p-1 rounded-full transition-all ${isFavorito(v) ? 'text-yellow-500 hover:text-yellow-600' : 'text-gray-400 hover:text-yellow-500'}`} title={isFavorito(v) ? 'Remover dos favoritos' : 'Adicionar aos favoritos'}><Star size={16} fill={isFavorito(v) ? 'currentColor' : 'none'} /></button>
                            </div>
                            <p className={`text-base leading-relaxed pt-0.5 flex-1 ${ativo === v.number ? 'text-blue-900 font-medium' : 'text-gray-800'}`}>{v.text}</p>
                          </div>
                          {modoGravacao && (
                            <div className="pl-14">
                              <Gravador versiculo={v} livro={livro} capitulo={capitulo} termoAceito={termoAceito} onAbrirTermo={() => setMostrarTermo(true)} />
                            </div>
                          )}
                        </div>
                      ))}
                    </div>
                  )}
                </div>
              </div>
            </div>
          )}
        </div>
      </main>
      <Footer />
    </div>
  );
});

export default Biblia;