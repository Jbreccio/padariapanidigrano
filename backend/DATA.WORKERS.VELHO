    <div class="fatima-quote">"Rezai o terço todos os dias para alcançar a paz para o mundo e o fim da guerra"</div>
    <p style="color:#666;font-size:14px;margin-top:30px;">⚠️ Este link expira em 5 minutos e é de uso pessoal.</p>
  </div>
  ${getEmailFooter()}
</div>
</body>
</html>`;
    await fetch("https://api.resend.com/emails", {
      method: "POST",
      headers: { "Authorization": `Bearer ${env.RESEND_API_KEY}`, "Content-Type": "application/json" },
      body: JSON.stringify({ from: "Santuario de Fatima <noreply@mail.santuariodefatima.com.br>", to: [email], subject: "🔐 Link de Acesso - Santuario de Fatima", html })
    });
  } catch (error) { console.error("Erro ao enviar email WebBlack:", error); }
}

/* ================= LITURGIA ================= */
async function buscarLiturgia(dataParam = null) {
  const baseUrl = "https://www.paulus.com.br/portal/liturgia-diaria/";
  let diaNumero, diaSemanaTexto;
  if (dataParam) {
    const [dia, mes, ano] = dataParam.split('/').map(Number);
    const dataObj = new Date(ano, mes - 1, dia);
    diaNumero = dataObj.getDate();
    const diasSemana = ['domingo','segunda-feira','terca-feira','quarta-feira','quinta-feira','sexta-feira','sabado'];
    diaSemanaTexto = diasSemana[dataObj.getDay()];
  } else {
    const hoje = new Date();
    diaNumero = hoje.getDate();
    const diasSemana = ['domingo','segunda-feira','terca-feira','quarta-feira','quinta-feira','sexta-feira','sabado'];
    diaSemanaTexto = diasSemana[hoje.getDay()];
  }
  const response = await fetch(baseUrl, { headers: { "User-Agent": "Mozilla/5.0" } });
  if (!response.ok) throw new Error("Erro ao acessar pagina principal");
  const html = await response.text();
  let postUrl = null;
  const regexDia = new RegExp(`href="(https:\\/\\/www\\.paulus\\.com\\.br\\/portal\\/liturgia-diaria\\/${diaNumero}-${diaSemanaTexto}-[^"]+)"`, "i");
  const linkMatch = html.match(regexDia);
  if (linkMatch) {
    postUrl = linkMatch[1];
  } else {
    const fallbackMatch = html.match(/href="(https:\/\/www\.paulus\.com\.br\/portal\/liturgia-diaria\/(?!page)[^"]+)"/i);
    if (!fallbackMatch) throw new Error("Link da liturgia nao encontrado");
    postUrl = fallbackMatch[1];
  }
  const postResponse = await fetch(postUrl, { headers: { "User-Agent": "Mozilla/5.0" } });
  if (!postResponse.ok) throw new Error("Erro ao acessar pagina da liturgia");
  const postHtml = await postResponse.text();
  const conteudoMatch = postHtml.match(/<div[^>]*id=["']texto["'][^>]*>([\s\S]*?)<\/div>\s*<div[^>]*id=["']navegador["']/i);
  if (!conteudoMatch) throw new Error("Conteudo principal nao encontrado");
  let texto = conteudoMatch[1]
    .replace(/<script[\s\S]*?<\/script>/gi,"").replace(/<style[\s\S]*?<\/style>/gi,"")
    .replace(/var addthis_config[\s\S]*/gi,"").replace(/\.redes-sociais[\s\S]*/gi,"")
    .replace(/<br\s*\/?>/gi,"\n").replace(/<\/p>/gi,"\n\n").replace(/<[^>]+>/g,"")
    .replace(/\n{3,}/g,"\n\n").replace(/&nbsp;/g,' ').replace(/&amp;/g,'&').replace(/\r/g,"").trim();
  let corLiturgica = 'verde';
  const corMatchHtml = postHtml.match(/\(\s*(roxo|violeta|branco|vermelho|rosa|verde)\b/i);
  if (corMatchHtml) {
    const v = corMatchHtml[1].toLowerCase();
    if (v === 'roxo' || v === 'violeta') corLiturgica = 'roxo';
    else if (v === 'branco') corLiturgica = 'branco';
    else if (v === 'vermelho') corLiturgica = 'vermelho';
    else if (v === 'rosa') corLiturgica = 'rosa';
  } else {
    const corNoTexto = texto.match(/\(\s*(roxo|violeta|branco|vermelho|rosa|verde)\b/i);
    if (corNoTexto) {
      const v = corNoTexto[1].toLowerCase();
      if (v === 'roxo' || v === 'violeta') corLiturgica = 'roxo';
      else if (v === 'branco') corLiturgica = 'branco';
      else if (v === 'vermelho') corLiturgica = 'vermelho';
      else if (v === 'rosa') corLiturgica = 'rosa';
    }
  }
  let tituloLiturgico='', antifona='', introducao='';
  const idxPrimLeitura = texto.search(/(Primeira\s+Leitura|1a\s+Leitura|Leitura\s+I)\b/i);
  if (idxPrimLeitura > 0) {
    let blocoInicio = texto.substring(0, idxPrimLeitura).trim();
    blocoInicio = blocoInicio.replace(/\([^)]*(?:of[ií]cio|salt[eé]rio|pref[aá]cio|creio|roxo|violeta|branco|vermelho|rosa|verde)[^)]*\)\n?/gi,'').trim();
    const linhas = blocoInicio.split('\n').map(l=>l.trim()).filter(Boolean);
    if (linhas.length > 0) {
      const l0 = linhas[0];
      if ((l0===l0.toUpperCase()&&l0.length>3&&!/^\(/.test(l0))||/^\d[o]?\s+[A-Z]/.test(l0)) { tituloLiturgico=l0; linhas.shift(); }
    }
    const restante=[];
    let achouAntifona=false;
    for (const l of linhas) {
      if (!achouAntifona&&/\([^)]*\d[^)]*\)\s*\.?\s*$/.test(l)) { antifona=l; achouAntifona=true; }
      else restante.push(l);
    }
    if (!achouAntifona&&restante.length>0&&restante[0].length<300) antifona=restante.shift();
    introducao=restante.join('\n').trim();
  }
  function extrairSecao(regexInicio, regexFim) {
    const inicioMatch = texto.match(regexInicio);
    if (!inicioMatch) return null;
    const textoDepoisInicio = texto.substring(inicioMatch.index);
    const fimMatch = textoDepoisInicio.match(regexFim);
    if (!fimMatch) return textoDepoisInicio.trim();
    return textoDepoisInicio.substring(0, fimMatch.index).trim();
  }
  const primeiraLeitura = extrairSecao(/(Primeira\s+Leitura|1a\s+Leitura|Leitura\s+I)\b/i,/(Segunda\s+Leitura|Salmo\s+Responsorial|Salmo\b)/i);
  const segundaLeitura = extrairSecao(/(Segunda\s+Leitura|2a\s+Leitura)\b/i,/(Salmo\s+Responsorial|Salmo\b|Evangelho\b)/i);
  let salmoLimpo = extrairSecao(/(Salmo\s+Responsorial|Salmo\b)/i,/(Segunda\s+Leitura|2a\s+Leitura|Evangelho\b)/i)||"Salmo nao disponivel";
  const segundaLeituraTexto = segundaLeitura||null;
  if (segundaLeituraTexto&&salmoLimpo.includes(segundaLeituraTexto.substring(0,40))) {
    salmoLimpo=salmoLimpo.replace(segundaLeituraTexto,'').replace(/\n{3,}/g,'\n\n').trim();
  }
  const evangelho = extrairSecao(/\bEvangelho\b/i,/Palavra\s+d[ao]\s+(?:salva[cç][aã]o|Senhor)|\bReflex(?:ao|ão|a)?\s*:/i) || "Evangelho nao disponivel";
  let reflexao = '';
  const palavraFinalMatch = texto.match(/Palavra\s+d[ao]\s+(?:salva[cç][aã]o|Senhor)/i);
  if (palavraFinalMatch) {
    const textoAposPalavra = texto.substring(palavraFinalMatch.index + palavraFinalMatch[0].length).trim();
    const mRef = textoAposPalavra.match(/Reflex(?:ao|ão|a)?\s*:\s*/i);
    if (mRef) { reflexao = textoAposPalavra.substring(textoAposPalavra.indexOf(mRef[0]) + mRef[0].length).trim(); }
  }
  if (!reflexao) {
    const idxEvangelho = texto.search(/\bEvangelho\b/i);
    if (idxEvangelho !== -1) {
      const textoAposEvangelho = texto.substring(idxEvangelho);
      const mRef2 = textoAposEvangelho.match(/Reflex(?:ao|ão|a)?\s*:\s*/i);
      if (mRef2) { reflexao = textoAposEvangelho.substring(textoAposEvangelho.indexOf(mRef2[0]) + mRef2[0].length).trim(); }
    }
  }
  if (!reflexao) {
    const mDiaDia = texto.match(/(?:Dia a [Dd]ia|Meditação|Comentário).*?(?:\n|$)([\s\S]{100,})/i);
    if (mDiaDia) reflexao = mDiaDia[1].trim();
  }
  if (reflexao) reflexao = reflexao.replace(/\(Dia a dia[^)]*\)\s*$/i, '').trim();
  let semana='';
  if (/semana|quaresma|tempo|cinzas|pascal|natal|advento|domingo|feira/i.test(tituloLiturgico)) semana=tituloLiturgico;
  return {
    success: true, fonte: "Paulus Editora", url: postUrl,
    data: dataParam||new Date().toLocaleDateString('pt-BR'),
    leituras: { primeiraLeitura: primeiraLeitura||"Leitura nao disponivel", segundaLeitura: segundaLeituraTexto, salmo: salmoLimpo, evangelho, tituloLiturgico, antifona, introducao, reflexao: reflexao||null, cor: corLiturgica, infoLiturgica: `${corLiturgica} - oficio do dia`, semana }
  };
}

/* ================= TERCO ================= */
function getMisterioTerco() {
  try {
    const day = new Date().getDay();
    const mapa = {
      0:{tipo:"gloriosos",titulo:"Misterios Gloriosos",descricao:"A Ressurreicao de Jesus",cor:"branco"},
      1:{tipo:"gozosos",titulo:"Misterios Gozosos",descricao:"A Anunciacao do Anjo",cor:"azul"},
      2:{tipo:"dolorosos",titulo:"Misterios Dolorosos",descricao:"A Agonia de Jesus",cor:"roxo"},
      3:{tipo:"gloriosos",titulo:"Misterios Gloriosos",descricao:"A Ascensao de Jesus",cor:"branco"},
      4:{tipo:"luminosos",titulo:"Misterios Luminosos",descricao:"O Batismo de Jesus",cor:"branco"},
      5:{tipo:"dolorosos",titulo:"Misterios Dolorosos",descricao:"A Crucificacao",cor:"roxo"},
      6:{tipo:"gozosos",titulo:"Misterios Gozosos",descricao:"A Visitacao",cor:"azul"}
    };
    const misterio = mapa[day]||mapa[2];
    const audioUrls = {
      gloriosos:"https://pub-89ce38aa8fb446c3b6b8d93e2d6fa452.r2.dev/terco-gloriosos.mp3",
      gozosos:"https://pub-89ce38aa8fb446c3b6b8d93e2d6fa452.r2.dev/terco-gozosos.mp3",
      dolorosos:"https://pub-89ce38aa8fb446c3b6b8d93e2d6fa452.r2.dev/terco-dolorosos.mp3",
      luminosos:"https://pub-89ce38aa8fb446c3b6b8d93e2d6fa452.r2.dev/terco-luminosos.mp3"
    };
    const imagens = { gloriosos:"/misterios/gloriosos.jpg", gozosos:"/misterios/gozosos.jpg", dolorosos:"/misterios/dolorosos.jpg", luminosos:"/misterios/luminosos.jpg" };
    const diasSemana=["Domingo","Segunda-feira","Terca-feira","Quarta-feira","Quinta-feira","Sexta-feira","Sabado"];
    const horarios=[{hora:7,nome:"Manha",descricao:"Terco da Aurora"},{hora:15,nome:"Misericordia",descricao:"Hora da Misericordia"},{hora:21,nome:"Noite",descricao:"Terco do Descanso"},{hora:3,nome:"Madrugada",descricao:"Terco da Vigilia"}];
    const horaAtual=new Date().getHours();
    const proximoHorario=horarios.find(h=>h.hora>horaAtual)||horarios[0];
    return { success:true, dia:day, diaSemana:diasSemana[day], misterio:misterio.tipo, titulo:misterio.titulo, descricao:misterio.descricao, corLiturgica:misterio.cor, audioUrl:audioUrls[misterio.tipo], imagem:imagens[misterio.tipo], estrutura:{paiNosso:6,aveMaria:50,gloria:5,totalContas:56,tempoMedio:"25 minutos"}, horarios, proximoHorario, dataReferencia:new Date().toISOString().split('T')[0], timestamp:new Date().toISOString() };
  } catch(error) {
    return { success:true, dia:2, diaSemana:"Terca-feira", misterio:"dolorosos", titulo:"Misterios Dolorosos", descricao:"A Agonia de Jesus", corLiturgica:"roxo", audioUrl:"https://pub-89ce38aa8fb446c3b6b8d93e2d6fa452.r2.dev/terco-dolorosos.mp3", imagem:"/misterios/dolorosos.jpg", estrutura:{paiNosso:6,aveMaria:50,gloria:5,totalContas:56,tempoMedio:"25 minutos"}, horarios:[{hora:7,nome:"Manha",descricao:"Terco da Aurora"},{hora:15,nome:"Misericordia",descricao:"Hora da Misericordia"},{hora:21,nome:"Noite",descricao:"Terco do Descanso"},{hora:3,nome:"Madrugada",descricao:"Terco da Vigilia"}], proximoHorario:{hora:15,nome:"Misericordia",descricao:"Hora da Misericordia"}, dataReferencia:new Date().toISOString().split('T')[0], timestamp:new Date().toISOString() };
  }
}

/* ================= YOUTUBE ================= */
function cleanYouTubeTitle(title) {
  if (!title) return title;
  return title.replace(/&quot;/g,'"').replace(/&#39;/g,"'").replace(/&amp;/g,'&').replace(/&lt;/g,'<').replace(/&gt;/g,'>').replace(/&nbsp;/g,' ').replace(/&aacute;/g,'a').replace(/&eacute;/g,'e').replace(/&iacute;/g,'i').replace(/&oacute;/g,'o').replace(/&uacute;/g,'u').replace(/&atilde;/g,'a').replace(/&otilde;/g,'o').replace(/&ccedil;/g,'c').replace(/&acirc;/g,'a').replace(/&ecirc;/g,'e').replace(/&ocirc;/g,'o').trim();
}

function cleanVideoId(id) {
  if (!id) return id;
  return id.split('&')[0].trim();
}

