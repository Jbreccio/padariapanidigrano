async function fielVerifyPinRoute(request, env) {
  try {
    const { userId, pin } = await request.json();
    if (!userId || !pin) {
      return jsonResponse({ success: false, error: "Dados incompletos" }, 400);
    }
    const stored = await env.AUTH_KV.get(`fiel_pin:${userId}`, "json");
    if (!stored || stored.pin !== pin || stored.expira < Date.now()) {
      return jsonResponse({ success: false, error: "PIN inv\xE1lido ou expirado" }, 401);
    }
    const user = await env.DB.prepare("SELECT id, nome, email FROM fieis WHERE id = ?").bind(userId).first();
    await env.AUTH_KV.delete(`fiel_pin:${userId}`);
    return jsonResponse({ success: true, userId: user.id, email: user.email, nome: user.nome });
  } catch (error) {
    console.error("Erro em verify-pin:", error);
    return jsonResponse({ success: false, error: "Erro ao verificar PIN" }, 500);
  }
}
