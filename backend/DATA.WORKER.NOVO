const uploadParaR2 = async (file: File, tipo: string): Promise<string> => {
  const token = getAuthToken();
  const formData = new FormData();
  formData.append('imagem', file);
  formData.append('tipo', tipo);
  
  const response = await fetch(`${WORKER_URL}/r2/upload`, {
    method: 'POST',
    headers: { 'Authorization': `Bearer ${token}` },
    body: formData
  });
  
  const data = await response.json();
  if (!data.success) throw new Error(data.error || 'Falha no upload');
  return data.url;
};

const uploadArquivoParaR2 = async (file: File, categoria: string): Promise<string> => {
  const token = getAuthToken();
  const formData = new FormData();
  formData.append('arquivo', file);
  formData.append('categoria', categoria);
  
  const response = await fetch(`${WORKER_URL}/r2/upload-arquivo`, {
    method: 'POST',
    headers: { 'Authorization': `Bearer ${token}` },
    body: formData
  });
  
  const data = await response.json();
  if (!data.success) throw new Error(data.error || 'Falha no upload');
  return data.url;
};

const getAuthToken = (): string | null => {
  const token = localStorage.getItem('admin_token');
  console.log('🔑 getAuthToken - admin_token:', token ? '✅ Existe' : '❌ NÃO existe');
  return token;
};

const getUserData = () => {
  try {
    const userStr = localStorage.getItem('admin_user');
    console.log('👤 getUserData - admin_user:', userStr ? '✅ Existe' : '❌ NÃO existe');
    if (!userStr) return null;
    return JSON.parse(userStr);
  } catch (e) {
    console.error('❌ Erro ao parsear admin_user:', e);
    localStorage.removeItem('admin_user');
    return null;
  }
};

const extrairAno = (periodo: string): number => {
  const match = periodo.match(/\b(19|20)\d{2}\b/);
  if (match) return parseInt(match[0]);
  return new Date().getFullYear();
};

const ordenarMomentosLiturgicos = (momentos: EventoLiturgico[]): EventoLiturgico[] => {
  return [...momentos].sort((a, b) => {
    const dataA = a.dataCriacao ? new Date(a.dataCriacao).getTime() : 0;
    const dataB = b.dataCriacao ? new Date(b.dataCriacao).getTime() : 0;
    if (dataA !== dataB) return dataB - dataA;
    const anoA = extrairAno(a.periodo);
    const anoB = extrairAno(b.periodo);
    if (anoA !== anoB) return anoB - anoA;
    const idA = parseInt(a.id) || 0;
    const idB = parseInt(b.id) || 0;
    return idB - idA;
  });
};

