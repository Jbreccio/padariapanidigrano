async function fielLoginRoute(request, env, ctx) {
  try {
    const { email, senha } = await request.json();
    if (!email || !senha) {
      return jsonResponse({ success: false, error: "Email e senha s\xE3o obrigat\xF3rios" }, 400);
    }
    let user = await env.DB.prepare(
      "SELECT id, nome, email, senha_hash, twofa_enabled, status FROM fieis WHERE email = ? AND status = 'active'"
    ).bind(email).first();
    let isAdminUser = false;
    if (!user) {
      const adminUser = await env.DB.prepare(
        "SELECT id, nome, email, senha_hash FROM users WHERE email = ? OR usuario = ?"
      ).bind(email, email).first();
      if (adminUser) {
        if (senha !== adminUser.senha_hash) {
          return jsonResponse({ success: false, error: "Senha incorreta" }, 401);
        }
        const result = await env.DB.prepare(
          "INSERT INTO fieis (nome, email, senha_hash, twofa_enabled, created_at, status) VALUES (?, ?, ?, 1, ?, 'active')"
        ).bind(adminUser.nome, adminUser.email, adminUser.senha_hash, (/* @__PURE__ */ new Date()).toISOString()).run();
        user = await env.DB.prepare(
          "SELECT id, nome, email, twofa_enabled FROM fieis WHERE id = ?"
        ).bind(result.meta.last_row_id).first();
        isAdminUser = true;
        console.log(`\u2705 Admin ${email} migrado para fieis`);
      }
    }
    if (!user) {
      return jsonResponse({ success: false, error: "Email n\xE3o encontrado" }, 401);
    }
    if (!isAdminUser && senha !== user.senha_hash) {
      return jsonResponse({ success: false, error: "Senha incorreta" }, 401);
    }
    await env.DB.prepare("UPDATE fieis SET last_login_at = ? WHERE id = ?").bind((/* @__PURE__ */ new Date()).toISOString(), user.id).run();
    if (user.twofa_enabled === 1) {
      const codigo2FA = Math.floor(1e5 + Math.random() * 9e5).toString();
      await env.AUTH_KV.put(`fiel_2fa:${user.id}`, JSON.stringify({ codigo: codigo2FA, expira: Date.now() + 3e5 }), { expirationTtl: 300 });
      ctx.waitUntil(send2FAEmailFiel(env, user.email, codigo2FA, user.nome));
      return jsonResponse({ success: true, step: "2fa", userId: user.id, email: user.email, nome: user.nome });
    }
    const pin = Math.floor(1e3 + Math.random() * 9e3).toString();
    await env.AUTH_KV.put(`fiel_pin:${user.id}`, JSON.stringify({ pin, expira: Date.now() + 3e5 }), { expirationTtl: 300 });
    ctx.waitUntil(sendPINEmailFiel(env, user.email, pin, user.nome));
    return jsonResponse({ success: true, step: "pin", userId: user.id, email: user.email, nome: user.nome });
  } catch (error) {
    console.error("Erro em login:", error);
    return jsonResponse({ success: false, error: "Erro ao fazer login" }, 500);
  }
}
