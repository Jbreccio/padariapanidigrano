// src/routes/fiel/termo.js
async function registrarTermo(request, env, ctx) {
  const auth = await requireFiel(request, env);
  if (auth instanceof Response) return auth;
  try {
    const body = await request.json();
    const { email, aceito, dados } = body;
    const emailFinal = email || auth.email;
    const nomeFinal = auth.nome || auth.name || emailFinal;
    if (!emailFinal) return errorResponse("E-mail \xE9 obrigat\xF3rio", 400);
    if (aceito === void 0 || aceito === null) {
      return errorResponse('Campo "aceito" \xE9 obrigat\xF3rio', 400);
    }
    const db = env.DB;
    const now = (/* @__PURE__ */ new Date()).toISOString();
    const ip = request.headers.get("CF-Connecting-IP") ?? null;
    const termoData = JSON.stringify({
      aceito: !!aceito,
      data: now,
      ip,
      userAgent: request.headers.get("User-Agent")?.substring(0, 200) ?? null,
      dadosExtras: dados ?? null
    });
    const existing = await db.prepare("SELECT email FROM fiel_dados WHERE email = ?").bind(emailFinal).first();
    if (existing) {
      await db.prepare(`
          UPDATE fiel_dados
          SET termo_aceito = ?, termo_data = ?, updated_at = ?
          WHERE email = ?
        `).bind(aceito ? 1 : 0, termoData, now, emailFinal).run();
    } else {
      await db.prepare(`
          INSERT INTO fiel_dados
            (email, musicas, versiculos, oracoes, fotos, termo_aceito, termo_data, created_at, updated_at)
          VALUES (?, '[]', '[]', '[]', '[]', ?, ?, ?, ?)
        `).bind(emailFinal, aceito ? 1 : 0, termoData, now, now).run();
    }
    if (ctx) {
      ctx.waitUntil(
        sendTermoConfirmationEmail(env, { nome: nomeFinal, email: emailFinal, aceito: !!aceito })
      );
      ctx.waitUntil(
        sendTermoNotificationToSecretariat(env, { nome: nomeFinal, email: emailFinal, aceito: !!aceito, ip })
      );
    } else {
      await sendTermoConfirmationEmail(env, { nome: nomeFinal, email: emailFinal, aceito: !!aceito });
      await sendTermoNotificationToSecretariat(env, { nome: nomeFinal, email: emailFinal, aceito: !!aceito, ip });
    }
    return jsonResponse({
      success: true,
      message: aceito ? "Termo aceito e registrado com sucesso!" : "Termo recusado registrado.",
      termoAceito: !!aceito,
      data: now
    });
  } catch (error) {
    console.error("Erro ao registrar termo:", error);
    return errorResponse("Erro ao registrar termo: " + error.message, 500);
  }
}
__name(registrarTermo, "registrarTermo");

// src/routes/fiel/voz.js
async function contribuirVoz(request, env) {
  try {
    const formData = await request.formData();
    const email = formData.get("email");
    const arquivo = formData.get("arquivo");
    if (!email) return errorResponse("E-mail \xE9 obrigat\xF3rio", 400);
    if (!arquivo) return errorResponse("Arquivo de voz \xE9 obrigat\xF3rio", 400);
    const tiposPermitidos = ["audio/wav", "audio/mpeg", "audio/mp3", "audio/ogg", "audio/webm"];
    if (!tiposPermitidos.includes(arquivo.type)) {
      return errorResponse("Formato de \xE1udio n\xE3o suportado. Use WAV, MP3 ou OGG.", 400);
    }
    const MAX_BYTES = 10 * 1024 * 1024;
    const buffer = await arquivo.arrayBuffer();
    if (buffer.byteLength > MAX_BYTES) {
      return errorResponse("Arquivo muito grande. M\xE1ximo 10 MB.", 400);
    }
    const ext = arquivo.name.split(".").pop() ?? "wav";
    const chave = `vozes-contribuicao/${email.replace("@", "_at_")}_${Date.now()}.${ext}`;
    await env.R2_AUDIO.put(chave, buffer, {
      httpMetadata: { contentType: arquivo.type },
      customMetadata: { email, dataEnvio: (/* @__PURE__ */ new Date()).toISOString() }
    });
    const db = env.DB;
    const now = (/* @__PURE__ */ new Date()).toISOString();
    await db.prepare(`
      INSERT INTO fiel_vozes (email, chave_r2, status, created_at)
      VALUES (?, ?, 'pendente', ?)
    `).bind(email, chave, now).run().catch(() => {
    });
    return jsonResponse({ success: true, message: "Voz enviada com sucesso! Obrigado pela contribui\xE7\xE3o." });
  } catch (error) {
    console.error("Erro ao contribuir com voz:", error);
    return errorResponse("Erro ao enviar voz", 500);
  }
}
__name(contribuirVoz, "contribuirVoz");

