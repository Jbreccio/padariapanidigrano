// src/middleware/auth.js
function decodificarToken(token) {
  try {
    const payload = JSON.parse(atob(token));
    if (payload.exp && payload.exp < Date.now()) {
      return { erro: "Token expirado" };
    }
    return payload;
  } catch {
    return { erro: "Token inv\xE1lido" };
  }
}
__name(decodificarToken, "decodificarToken");
function extrairToken(request) {
  const auth = request.headers.get("Authorization") || "";
  if (auth.startsWith("Bearer ")) return auth.slice(7).trim();
  return null;
}
__name(extrairToken, "extrairToken");
async function requireFiel(request, env) {
  const token = extrairToken(request);
  if (!token) {
    return new Response(JSON.stringify({ success: false, error: "Token n\xE3o fornecido" }), {
      status: 401,
      headers: { "Content-Type": "application/json" }
    });
  }
  const payload = decodificarToken(token);
  if (payload.erro) {
    return new Response(JSON.stringify({ success: false, error: payload.erro }), {
      status: 401,
      headers: { "Content-Type": "application/json" }
    });
  }
  if (!payload.id && !payload.email) {
    return new Response(JSON.stringify({ success: false, error: "Token malformado" }), {
      status: 401,
      headers: { "Content-Type": "application/json" }
    });
  }
  return payload;
}
__name(requireFiel, "requireFiel");

