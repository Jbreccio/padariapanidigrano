async function fielVerificarRoute(request, env) {
  try {
    const authHeader = request.headers.get("Authorization");
    if (!authHeader || !authHeader.startsWith("Bearer ")) {
      return jsonResponse({ success: false, error: "Token n\xE3o fornecido" }, 401);
    }
    const token = authHeader.replace("Bearer ", "");
    const userData = JSON.parse(atob(token));
    if (userData.exp < Date.now()) {
      return jsonResponse({ success: false, error: "Token expirado" }, 401);
    }
    const user = await env.DB.prepare("SELECT id, nome, email FROM fieis WHERE id = ?").bind(userData.id).first();
    if (!user) return jsonResponse({ success: false, error: "Usu\xE1rio n\xE3o encontrado" }, 401);
    return jsonResponse({ success: true, user });
  } catch (error) {
    return jsonResponse({ success: false, error: "Token inv\xE1lido" }, 401);
  }
}
