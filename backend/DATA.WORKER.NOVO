async function fielRegisterRoute(request, env, ctx) {
  try {
    const { nome, email, senha } = await request.json();
    if (!nome || !email || !senha) {
      return jsonResponse({ success: false, error: "Nome, email e senha s\xE3o obrigat\xF3rios" }, 400);
    }
    const existingUser = await env.DB.prepare(
      "SELECT id FROM fieis WHERE email = ?"
    ).bind(email).first();
    if (existingUser) {
      return jsonResponse({ success: false, error: "E-mail j\xE1 cadastrado" }, 400);
    }
    await env.DB.prepare(`
      CREATE TABLE IF NOT EXISTS fieis (
        id INTEGER PRIMARY KEY AUTOINCREMENT,
        nome TEXT NOT NULL,
        apelido TEXT,
        email TEXT NOT NULL UNIQUE,
        senha_hash TEXT NOT NULL,
        celular TEXT,
        twofa_enabled INTEGER DEFAULT 0,
        twofa_secret TEXT,
        created_at DATETIME DEFAULT CURRENT_TIMESTAMP,
        updated_at DATETIME DEFAULT CURRENT_TIMESTAMP,
        last_login_at DATETIME,
        last_login_ip TEXT,
        status TEXT DEFAULT 'active',
        email_verified INTEGER DEFAULT 0,
        email_verified_at DATETIME
      )
    `).run();
    const result = await env.DB.prepare(
      "INSERT INTO fieis (nome, email, senha_hash, created_at, status) VALUES (?, ?, ?, ?, 'active')"
    ).bind(nome, email, senha, (/* @__PURE__ */ new Date()).toISOString()).run();
    const userId = result.meta.last_row_id;
    ctx.waitUntil(sendWelcomeEmailFiel(env, email, nome));
    return jsonResponse({ success: true, message: "Cadastro realizado!", userId });
  } catch (error) {
    console.error("Erro em register:", error);
    return jsonResponse({ success: false, error: "Erro ao cadastrar" }, 500);
  }
}
