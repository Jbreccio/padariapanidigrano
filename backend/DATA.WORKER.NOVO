const FAIXA_BG: Record<string, string> = {
  verde:    'bg-green-700',
  branco:   'bg-gray-100',
  vermelho: 'bg-red-700',
  roxo:     'bg-purple-800',
  rosa:     'bg-pink-500',
};

const FAIXA_TEXT: Record<string, string> = {
  verde:    'text-white',
  branco:   'text-gray-800',
  vermelho: 'text-white',
  roxo:     'text-white',
  rosa:     'text-white',
};

const FAIXA_SUBTITLE: Record<string, string> = {
  verde:    'text-green-200',
  branco:   'text-gray-500',
  vermelho: 'text-red-200',
  roxo:     'text-purple-200',
