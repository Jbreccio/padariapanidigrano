  const [lastSyncTime, setLastSyncTime] = useState<string>(new Date().toLocaleTimeString());
  const [sidebarOpen, setSidebarOpen] = useState(true);
  const [showEditProfileModal, setShowEditProfileModal] = useState(false);
  const [showChangePasswordModal, setShowChangePasswordModal] = useState(false);
  const [editProfileForm, setEditProfileForm] = useState({ nome: '', email: '' });
  const [passwordForm, setPasswordForm] = useState({ current: '', new: '', confirm: '' });
  const [showCurrentPassword, setShowCurrentPassword] = useState(false);
  const [showNewPassword, setShowNewPassword] = useState(false);
  const [showConfirmPassword, setShowConfirmPassword] = useState(false);
  const [syncing, setSyncing] = useState(false);
  const [userProfile, setUserProfile] = useState<UserProfile>({ nome: '', email: '', cargo: 'Administrador', avatar: undefined });
  const [youtubeLiveData, setYoutubeLiveData] = useState<YoutubeLiveData|null>(null);
  const [youtubeLiveUrl, setYoutubeLiveUrl] = useState('');
  const [youtubeLiveLoading, setYoutubeLiveLoading] = useState(false);
  const [editingLiveUrl, setEditingLiveUrl] = useState('');
  const [isEditingLive, setIsEditingLive] = useState(false);
  const [horariosMissas, setHorariosMissas] = useState<DiaMissas[]>([]);
  const [fotosCarrossel, setFotosCarrossel] = useState<CarrosselItem[]>(
    DADOS_FIXOS_CARROSSEL.map((item, idx) => ({ ...item, ordem: idx, ativo: true }))
  );
  const [eventosLiturgicos, setEventosLiturgicos] = useState<EventoLiturgico[]>(ordenarMomentosLiturgicos(MOMENTOS_INICIAIS));
  const [popups, setPopups] = useState<PopupItem[]>(POPUPS_FIXOS);
  const [recados, setRecados] = useState<RecadoItem[]>([]);
  const [arquivosDownload, setArquivosDownload] = useState<ArquivoDownload[]>(ARQUIVOS_DOWNLOAD_INICIAIS);
  const [novoRecado, setNovoRecado] = useState({ titulo: '', conteudo: '', avisoimportante: false });
  const [novoEventoLiturgico, setNovoEventoLiturgico] = useState<Omit<EventoLiturgico,'id'>>({ 
    periodo: '', 
    cor: 'roxo', 
    tituloFaixa: '', 
    imagens: [], 
    ativo: true,
    googleDriveLink: '',
    mostrarBotaoDrive: false
  });
  const [tempoExibicaoRecados, setTempoExibicaoRecados] = useState(5);
  
  const [editingDriveId, setEditingDriveId] = useState<string | null>(null);
  const [editDriveLink, setEditDriveLink] = useState('');
  const [editDriveMostrar, setEditDriveMostrar] = useState(false);
  
  const [editingRecadoId, setEditingRecadoId] = useState<string | null>(null);
  const [editRecadoForm, setEditRecadoForm] = useState({ titulo: '', conteudo: '' });

  const [editingArquivoId, setEditingArquivoId] = useState<string | null>(null);
  const [editArquivoForm, setEditArquivoForm] = useState({ tituloExibicao: '', descricao: '' });
  const [uploadingArquivo, setUploadingArquivo] = useState(false);

  // ============================================
  // 📸 INSTAGRAM TOKEN STATES
  // ============================================
  const [instagramStatus, setInstagramStatus] = useState<InstagramTokenStatus | null>(null);
  const [renovandoToken, setRenovandoToken] = useState(false);
  const [diasRestantesContagem, setDiasRestantesContagem] = useState<number | null>(null);
  const [tokenMessage, setTokenMessage] = useState<{ type: 'success' | 'error', text: string } | null>(null);

  const [perfilAdmin, setPerfilAdmin] = useState<PerfilAdmin>({
    nome: '',
    email: '',
    avatar: undefined,
    corFundo: '#0d2a5c',
    imagemFundo: undefined,
    tema: 'escuro'
  });
  const [mostrarSeletorFundo, setMostrarSeletorFundo] = useState(false);
  const [fundoTipo, setFundoTipo] = useState<'cor' | 'imagem'>('cor');

  // DATA BASE: 22 de abril de 2026 (data em que o token foi ativado)
  const TOKEN_ACTIVATION_DATE = new Date(2026, 3, 22); // Mês é 0-indexado (3 = Abril)
  const TOKEN_EXPIRY_DAYS = 60;

  // Função para calcular dias restantes até expiração
  const calcularDiasRestantes = (): number => {
    const hoje = new Date();
    const dataExpiracao = new Date(TOKEN_ACTIVATION_DATE);
    dataExpiracao.setDate(dataExpiracao.getDate() + TOKEN_EXPIRY_DAYS);
    
    const diffTime = dataExpiracao.getTime() - hoje.getTime();
    const diffDays = Math.ceil(diffTime / (1000 * 60 * 60 * 24));
    
    return diffDays;
  };

  // Função para buscar status do token no backend
  const buscarStatusToken = async () => {
    try {
      const token = getAuthToken();
      const response = await fetch(`${WORKER_URL}/admin/instagram-token-status`, {
        headers: { 'Authorization': `Bearer ${token}` }
      });
      const data = await response.json();
      if (data.success) {
        setInstagramStatus(data.status);
        // Atualiza a contagem regressiva
        setDiasRestantesContagem(calcularDiasRestantes());
      }
    } catch (error) {
      console.error('Erro ao buscar status do token:', error);
    }
  };

  // Função para renovar token manualmente
  const handleRenovarToken = async () => {
    setRenovandoToken(true);
    setTokenMessage(null);
    try {
      const token = getAuthToken();
      const response = await fetch(`${WORKER_URL}/admin/refresh-instagram-token`, {
        method: 'POST',
        headers: {
          'Authorization': `Bearer ${token}`,
          'Content-Type': 'application/json'
        }
      });
      const data = await response.json();
      
      if (data.success) {
        setTokenMessage({ type: 'success', text: `✅ ${data.message} Expira em: ${data.expiraEm}` });
        // Aguarda 1 segundo e atualiza o status
        setTimeout(() => {
          buscarStatusToken();
        }, 1000);
      } else {
        setTokenMessage({ type: 'error', text: `❌ ${data.error}` });
      }
    } catch (error) {
      setTokenMessage({ type: 'error', text: '❌ Erro ao renovar token. Verifique sua conexão.' });
    } finally {
      setRenovandoToken(false);
      // Limpa a mensagem após 5 segundos
      setTimeout(() => setTokenMessage(null), 5000);
    }
  };

  const handleOpenDriveEdit = (momento: EventoLiturgico) => {
    setEditingDriveId(momento.id);
    setEditDriveLink(momento.googleDriveLink || '');
    setEditDriveMostrar(momento.mostrarBotaoDrive || false);
  };

  const handleSaveDriveEdit = (id: string) => {
    setEventosLiturgicos(prev => ordenarMomentosLiturgicos(prev.map(m => 
      m.id === id 
        ? { ...m, googleDriveLink: editDriveLink, mostrarBotaoDrive: editDriveMostrar }
        : m
    )));
    setEditingDriveId(null);
    setEditDriveLink('');
    setEditDriveMostrar(false);
  };

  const handleCancelDriveEdit = () => {
    setEditingDriveId(null);
    setEditDriveLink('');
    setEditDriveMostrar(false);
  };

  const handleEditLive = () => {
    if (youtubeLiveData) {
      setEditingLiveUrl(youtubeLiveData.link);
      setIsEditingLive(true);
    }
  };

  const handleSaveLiveEdit = async () => {
    if (!editingLiveUrl) {
      alert('❌ Cole o link da live do YouTube!');
      return;
    }
    setYoutubeLiveLoading(true);
    try {
      const token = getAuthToken();
      const response = await fetch(`${WORKER_URL}/admin/youtube-live`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', 'Authorization': `Bearer ${token}` },
        body: JSON.stringify({ liveUrl: editingLiveUrl })
      });
      const data = await response.json();
      if (data.success) {
        setYoutubeLiveData(data.live);
        setEditingLiveUrl('');
        setIsEditingLive(false);
        alert('✅ Live atualizada com sucesso!');
      } else {
        alert(`❌ Erro: ${data.error}`);
      }
    } catch {
      alert('❌ Erro ao atualizar live');
    } finally {
      setYoutubeLiveLoading(false);
    }
  };

  const handleCancelLiveEdit = () => {
    setIsEditingLive(false);
    setEditingLiveUrl('');
  };

  const handleSalvarFundo = () => {
    const config = {
      corFundo: perfilAdmin.corFundo,
      imagemFundo: perfilAdmin.imagemFundo,
      tema: perfilAdmin.tema
    };
    localStorage.setItem('perfil_admin_config', JSON.stringify(config));
    setMostrarSeletorFundo(false);
    alert('✅ Fundo salvo com sucesso!');
  };

  const handleUploadImagemFundo = async (e: React.ChangeEvent<HTMLInputElement>) => {
    const file = e.target.files?.[0];
    if (file) {
      try {
        const url = await uploadParaR2(file, 'fundo_admin');
        setPerfilAdmin({ ...perfilAdmin, imagemFundo: url, corFundo: undefined });
        alert('✅ Imagem de fundo enviada com sucesso!');
      } catch (error) {
        alert('❌ Erro ao fazer upload da imagem de fundo');
      }
    }
  };

  // ✅ PRIMEIRO useEffect - Verificar autenticação
  useEffect(() => {
    console.log('🚀 PainelAdmin montado - verificando autenticação');
    console.log('📦 localStorage no momento da montagem:');
    console.log('  - admin_token:', localStorage.getItem('admin_token') ? '✅ Sim' : '❌ Não');
    console.log('  - admin_user:', localStorage.getItem('admin_user') ? '✅ Sim' : '❌ Não');
    
    const checkAuth = async () => {
      console.log('🔍 Verificando autenticação no PainelAdmin...');
      
      const token = getAuthToken();
      console.log('📦 Token encontrado:', token ? `${token.substring(0, 50)}...` : 'null');
      
      if (!token) { 
        console.log('❌ Sem admin_token, redirecionando para /sanctum');
        navigate('/sanctum'); 
        return; 
      }
      
      try {
        const user = getUserData();
        console.log('👤 User data:', user);
        
        if (!user) { 
          console.log('❌ Sem admin_user, redirecionando para /sanctum');
          navigate('/sanctum'); 
          return; 
        }
        
        // Verificar se o token é válido no backend
        console.log('🔐 Verificando token no backend...');
        const response = await fetch(`${WORKER_URL}/admin/verificar`, {
          headers: { 'Authorization': `Bearer ${token}` }
        });
        const data = await response.json();
        
        if (!data.success) {
          console.log('❌ Token inválido no backend, limpando localStorage');
          localStorage.removeItem('admin_token');
          localStorage.removeItem('admin_user');
          navigate('/sanctum');
          return;
        }
        
        console.log('✅ Autenticado com sucesso!');
        setIsAuthenticated(true);
        
      } catch (err) {
        console.error('❌ Erro na autenticação:', err);
        navigate('/sanctum');
      } finally {
        setLoading(false);
      }
    };
    
    checkAuth();
  }, [navigate]);

  // ✅ SEGUNDO useEffect - Carregar dados
  useEffect(() => {
    if (!isAuthenticated) return;
    const carregarDados = async () => {
      try {
        const token = getAuthToken();
        const response = await fetch(`${WORKER_URL}/admin/dados`, { headers: { 'Authorization': `Bearer ${token}` } });
        const data = await response.json();
        if (data.success && data.dados) {
          const d = data.dados;
          if (Array.isArray(d.carrossel) && d.carrossel.length) setFotosCarrossel(d.carrossel);
          if (Array.isArray(d.momentosLiturgicos) && d.momentosLiturgicos.length) setEventosLiturgicos(ordenarMomentosLiturgicos(d.momentosLiturgicos));
          if (Array.isArray(d.popups) && d.popups.length) setPopups(d.popups);
          if (Array.isArray(d.recados)) setRecados(d.recados);
          if (Array.isArray(d.arquivosDownload) && d.arquivosDownload.length) setArquivosDownload(d.arquivosDownload);
          if (Array.isArray(d.horariosMissas) && d.horariosMissas.length) setHorariosMissas(d.horariosMissas);
          else setHorariosMissas(inicializarHorariosPadrao());
          setLastSyncTime(new Date().toLocaleTimeString());
        }
      } catch (e) { console.warn('⚠️ Sem dados no servidor.', e); }
    };
    carregarDados();
    // Buscar status do token Instagram
    buscarStatusToken();
    // Iniciar contagem regressiva
    setDiasRestantesContagem(calcularDiasRestantes());
    // Atualizar contagem a cada dia
    const interval = setInterval(() => {
      setDiasRestantesContagem(calcularDiasRestantes());
    }, 86400000); // 24 horas
    return () => clearInterval(interval);
  }, [isAuthenticated]);

  // ✅ TERCEIRO useEffect - YouTube Live
  useEffect(() => {
    if (isAuthenticated) carregarLiveData();
  }, [isAuthenticated]);

  // ✅ QUARTO useEffect - Online/Offline
  useEffect(() => {
    const on = () => setIsOnline(true);
    const off = () => setIsOnline(false);
    window.addEventListener('online', on);
    window.addEventListener('offline', off);
    return () => { window.removeEventListener('online', on); window.removeEventListener('offline', off); };
  }, []);

  const carregarLiveData = async () => {
    try {
      const token = getAuthToken();
      const response = await fetch(`${WORKER_URL}/admin/youtube-live`, { headers: { 'Authorization': `Bearer ${token}` } });
      const data = await response.json();
      if (data.success && data.live) setYoutubeLiveData(data.live);
    } catch (error) { console.error('Erro ao carregar live:', error); }
  };

  const handleSalvarLive = async () => {
    if (!youtubeLiveUrl) { alert('❌ Cole o link da live do YouTube!'); return; }
    setYoutubeLiveLoading(true);
    try {
      const token = getAuthToken();
      const response = await fetch(`${WORKER_URL}/admin/youtube-live`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', 'Authorization': `Bearer ${token}` },
        body: JSON.stringify({ liveUrl: youtubeLiveUrl })
      });
      const data = await response.json();
      if (data.success) { setYoutubeLiveData(data.live); setYoutubeLiveUrl(''); alert('✅ Live ativada com sucesso!'); }
      else alert(`❌ Erro: ${data.error}`);
    } catch { alert('❌ Erro ao salvar live'); }
    finally { setYoutubeLiveLoading(false); }
  };

  const handleRemoverLive = async () => {
    if (!confirm('Remover a live atual?')) return;
    try {
      const token = getAuthToken();
      const response = await fetch(`${WORKER_URL}/admin/youtube-live`, { method: 'DELETE', headers: { 'Authorization': `Bearer ${token}` } });
      const data = await response.json();
      if (data.success) { setYoutubeLiveData(null); alert('✅ Live removida!'); }
    } catch { alert('❌ Erro ao remover live'); }
  };

  const handleAdicionarHorario = (diaId: string) => {
    console.log('📅 Adicionando horário para o dia com ID:', diaId);
    
    setHorariosMissas(prev => {
      const novosHorarios = prev.map(dia => {
        if (dia.id === diaId) {
          const novaMissa = {
            id: Date.now().toString(),
            hora: "00h00",
            tipo: "",
            youtube: false
          };
          console.log('➕ Adicionando missa:', novaMissa);
          return { ...dia, missas: [...dia.missas, novaMissa] };
        }
        return dia;
      });
      
      console.log('📅 Novos horários:', novosHorarios);
      return novosHorarios;
    });
  };

  const handleEditarHorario = (diaId: string, missaId: string, campo: keyof HorarioMissa, valor: any) => {
    console.log('✏️ Editando:', { diaId, missaId, campo, valor });
    
    setHorariosMissas(prev => prev.map(dia => 
      dia.id === diaId ? {
        ...dia,
        missas: dia.missas.map(m => 
          m.id === missaId ? { ...m, [campo]: valor } : m
        )
      } : dia
    ));
  };

  const handleRemoverHorario = (diaId: string, missaId: string) => {
    if (!confirm("Remover este horário?")) return;
    
    console.log('🗑️ Removendo horário:', { diaId, missaId });
    
    setHorariosMissas(prev => prev.map(dia => 
      dia.id === diaId ? {
        ...dia,
        missas: dia.missas.filter(m => m.id !== missaId)
      } : dia
    ));
  };

  const handleToggleAtivoDia = (diaId: string) => {
    setHorariosMissas(prev => prev.map(dia => dia.id === diaId ? { ...dia, ativo: !dia.ativo } : dia));
  };

  const handleResetHorarios = () => {
    if (!confirm("Restaurar horários padrão?")) return;
    setHorariosMissas(inicializarHorariosPadrao());
  };

  const salvarEPublicar = async () => {
    setSaveStatus('saving');
    setSaveError('');
    
    const token = getAuthToken();
    if (!token) {
      alert('Sessão expirada.');
      navigate('/sanctum');
      return;
    }
    
    const momentosOrdenados = ordenarMomentosLiturgicos(eventosLiturgicos);
    const dados = {
      carrossel: fotosCarrossel,
      momentosLiturgicos: momentosOrdenados,
      popups,
      recados,
      horariosMissas,
      arquivosDownload
    };
    
    try {
      const response = await fetch(`${WORKER_URL}/admin/dados`, {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json',
          'Authorization': `Bearer ${token}`
        },
        body: JSON.stringify(dados)
      });
      
      const result = await response.json();
      
      if (result.success) {
        setEventosLiturgicos(momentosOrdenados);
        setLastSyncTime(new Date().toLocaleTimeString());
        setSaveStatus('published');
        
        window.dispatchEvent(new CustomEvent('dadosAtualizados'));
        
        setTimeout(() => setSaveStatus('idle'), 3000);
      } else if (response.status === 401) {
        alert('Sessão expirada.');
        navigate('/sanctum');
      } else {
        setSaveError(`❌ ${result.error || `Erro HTTP ${response.status}`}`);
        setSaveStatus('error');
        setTimeout(() => setSaveStatus('idle'), 6000);
      }
    } catch (error) {
      console.error('Erro ao salvar:', error);
      setSaveError('❌ Erro de conexão');
      setSaveStatus('error');
      setTimeout(() => setSaveStatus('idle'), 4000);
    }
  };

  const handleLogout = () => {
    try {
      const token = getAuthToken();
      fetch(`${WORKER_URL}/auth/logout`, { method: 'POST', headers: { 'Content-Type': 'application/json', 'Authorization': `Bearer ${token}` }, body: JSON.stringify({ userEmail: userProfile.email, userName: userProfile.nome }) }).catch(() => {});
    } catch (_) {}
    ['admin_token','admin_user','admin_email','userRole','auth_expiry'].forEach(k => localStorage.removeItem(k));
    navigate('/sanctum');
  };

  const sincronizarComServidor = async () => {
    setSyncing(true);
    try {
      const token = getAuthToken();
      const response = await fetch(`${WORKER_URL}/admin/dados`, { headers: { 'Authorization': `Bearer ${token}` } });
      const data = await response.json();
      if (data.success && data.dados) {
        const d = data.dados;
        if (d.carrossel?.length) setFotosCarrossel(d.carrossel);
        if (Array.isArray(d.momentosLiturgicos)) setEventosLiturgicos(ordenarMomentosLiturgicos(d.momentosLiturgicos));
        if (d.popups?.length) setPopups(d.popups);
        if (d.recados?.length) setRecados(d.recados);
        if (d.arquivosDownload?.length) setArquivosDownload(d.arquivosDownload);
        if (d.horariosMissas?.length) setHorariosMissas(d.horariosMissas);
        setLastSyncTime(new Date().toLocaleTimeString());
        alert('✅ Dados sincronizados!');
      }
    } catch { alert('❌ Erro ao sincronizar'); }
    finally { setSyncing(false); }
  };

  const handleAvatarUpload = async (e: React.ChangeEvent<HTMLInputElement>) => {
    const file = e.target.files?.[0];
    if (file) {
      try {
        const url = await uploadParaR2(file, 'avatar');
        const avatarKey = `user_avatar_${userProfile.email || userProfile.nome}`;
        localStorage.setItem(avatarKey, url);
        if (userProfile.email && userProfile.nome) localStorage.removeItem(`user_avatar_${userProfile.nome}`);
        setUserProfile({ ...userProfile, avatar: url });
        setPerfilAdmin({ ...perfilAdmin, avatar: url });
      } catch (error) {
        alert('❌ Erro ao fazer upload do avatar');
      }
    }
  };

  const handleSaveProfile = () => {
    if (userProfile.avatar) {
      const newAvatarKey = `user_avatar_${editProfileForm.email || editProfileForm.nome}`;
      localStorage.setItem(newAvatarKey, userProfile.avatar);
      localStorage.removeItem(`user_avatar_${userProfile.nome}`);
      if (userProfile.email !== editProfileForm.email) localStorage.removeItem(`user_avatar_${userProfile.email}`);
    }
    setUserProfile({ ...userProfile, nome: editProfileForm.nome, email: editProfileForm.email });
    setPerfilAdmin({ ...perfilAdmin, nome: editProfileForm.nome, email: editProfileForm.email });
    localStorage.setItem('admin_user', JSON.stringify({ nome: editProfileForm.nome, email: editProfileForm.email, role: 'admin' }));
    setShowEditProfileModal(false);
    alert('✅ Perfil atualizado!');
  };

  const handleChangePassword = async () => {
    if (!passwordForm.current || !passwordForm.new || !passwordForm.confirm) { alert('❌ Preencha todos os campos!'); return; }
    if (passwordForm.new !== passwordForm.confirm) { alert('❌ As senhas não coincidem!'); return; }
    if (passwordForm.new.length < 6) { alert('❌ Mínimo 6 caracteres!'); return; }
    try {
      const token = getAuthToken();
      const response = await fetch(`${WORKER_URL}/admin/alterar-senha`, {
        method: 'PUT',
        headers: { 'Content-Type': 'application/json', 'Authorization': `Bearer ${token}` },
        body: JSON.stringify({ senha_atual: passwordForm.current, nova_senha: passwordForm.new })
      });
      const result = await response.json();
      if (result.success) { setShowChangePasswordModal(false); setPasswordForm({ current: '', new: '', confirm: '' }); alert('✅ Senha alterada!'); }
      else alert(`❌ ${result.error || 'Erro ao alterar senha'}`);
    } catch { alert('❌ Erro de conexão'); }
  };

  const handleUploadCarrossel = async (e: React.ChangeEvent<HTMLInputElement>) => {
    const files = e.target.files; 
    if (!files) return;
    
    try {
      const novas = await Promise.all(Array.from(files).map(async (file, i) => ({
        id: Date.now() + i + '', 
        imagem: await uploadParaR2(file, 'carrossel'),
        titulo: `Nova Imagem ${fotosCarrossel.length + i + 1}`, 
        ordem: fotosCarrossel.length + i, 
        ativo: true
      })));
      setFotosCarrossel([...fotosCarrossel, ...novas]);
      alert(`✅ ${novas.length} imagem(ns) adicionada(s) ao R2!`);
    } catch (error) {
      alert('❌ Erro ao fazer upload para o R2');
    }
  };

  const handleDeleteCarrossel = (id: string) => { if (confirm('Excluir?')) setFotosCarrossel(fotosCarrossel.filter(i => i.id !== id)); };
  const handleToggleAtivoCarrossel = (id: string) => setFotosCarrossel(fotosCarrossel.map(i => i.id === id ? { ...i, ativo: !i.ativo } : i));
  const handleReorderCarrossel = (fromIndex: number, toIndex: number) => {
    const newItems = [...fotosCarrossel];
    const [removed] = newItems.splice(fromIndex, 1);
    newItems.splice(toIndex, 0, removed);
    setFotosCarrossel(newItems.map((item, idx) => ({ ...item, ordem: idx })));
  };

  const handleAddMomento = () => {
    if (!novoEventoLiturgico.tituloFaixa.trim()) { alert('Preencha o título!'); return; }
    const tituloFaixaUpper = novoEventoLiturgico.tituloFaixa.toUpperCase();
    const novo: EventoLiturgico = {
      id: Date.now() + '',
      ...novoEventoLiturgico,
      tituloFaixa: tituloFaixaUpper,
      periodo: novoEventoLiturgico.periodo || tituloFaixaUpper,
      googleDriveLink: novoEventoLiturgico.googleDriveLink || '',
      mostrarBotaoDrive: novoEventoLiturgico.mostrarBotaoDrive || false,
      dataCriacao: new Date().toISOString(),
    };
    setEventosLiturgicos(ordenarMomentosLiturgicos([...eventosLiturgicos, novo]));
    setNovoEventoLiturgico({ 
      periodo: '', 
      cor: 'roxo', 
      tituloFaixa: '', 
      imagens: [], 
      ativo: true,
      googleDriveLink: '',
      mostrarBotaoDrive: false
    });
    alert('✅ Momento adicionado! Clique em "Salvar e Publicar".');
  };

  const handleDeleteMomento = (id: string) => {
    if (confirm('Excluir este momento?')) setEventosLiturgicos(ordenarMomentosLiturgicos(eventosLiturgicos.filter(m => m.id !== id)));
  };

  const handleToggleAtivoMomento = (id: string) => {
    setEventosLiturgicos(ordenarMomentosLiturgicos(eventosLiturgicos.map(m => m.id === id ? { ...m, ativo: !m.ativo } : m)));
  };

  const handleSalvarEdicaoMomento = () => {
    if (!editingMomentoId) return;
    const tituloFaixaUpper = editMomentoForm.tituloFaixa.toUpperCase();
    setEventosLiturgicos(ordenarMomentosLiturgicos(eventosLiturgicos.map(m => m.id === editingMomentoId
      ? { ...m, periodo: editMomentoForm.periodo, tituloFaixa: tituloFaixaUpper, cor: editMomentoForm.cor }
      : m)));
    setEditingMomentoId(null);
  };

  const handleAddImagemMomento = async (id: string, e: React.ChangeEvent<HTMLInputElement>) => {
    const files = e.target.files; 
    if (!files) return;
    
    try {
      const urls = await Promise.all(Array.from(files).map(f => uploadParaR2(f, `momentos/${id}`)));
      setEventosLiturgicos(ordenarMomentosLiturgicos(eventosLiturgicos.map(m => 
        m.id === id ? { ...m, imagens: [...m.imagens, ...urls] } : m
      )));
      alert(`✅ ${urls.length} imagem(ns) adicionada(s) ao R2!`);
    } catch (error) {
      alert('❌ Erro ao fazer upload para o R2');
    }
  };

  const handleDeleteImagemMomento = (eventoId: string, imagemIndex: number) => {
    setEventosLiturgicos(ordenarMomentosLiturgicos(eventosLiturgicos.map(m => m.id === eventoId
      ? { ...m, imagens: m.imagens.filter((_, idx) => idx !== imagemIndex) }
      : m)));
  };

  const handleUploadPopups = async (e: React.ChangeEvent<HTMLInputElement>) => {
    const files = e.target.files; 
    if (!files) return;
    
    try {
      const novos = await Promise.all(Array.from(files).map(async (file, i) => ({
        id: Date.now() + i + '', 
        imagem: await uploadParaR2(file, 'popup'),
        tempoExibicao: 10, 
        ativo: true, 
        ordem: popups.length + i
      })));
      setPopups([...popups, ...novos]);
      alert(`✅ ${novos.length} popup(s) adicionado(s) ao R2!`);
    } catch (error) {
      alert('❌ Erro ao fazer upload para o R2');
    }
  };
  
  const handleDeletePopup = (id: string) => { if (confirm('Excluir?')) setPopups(popups.filter(p => p.id !== id)); };
  const handleToggleAtivoPopup = (id: string) => setPopups(popups.map(p => p.id === id ? { ...p, ativo: !p.ativo } : p));
  const handleTempoExibicao = (id: string, tempo: number) => setPopups(popups.map(p => p.id === id ? { ...p, tempoExibicao: tempo } : p));
  const handleReorderPopup = (id: string, direction: 'up'|'down') => {
    const index = popups.findIndex(p => p.id === id);
    if ((direction === 'up' && index === 0) || (direction === 'down' && index === popups.length - 1)) return;
    const newPopups = [...popups];
    const newIndex = direction === 'up' ? index - 1 : index + 1;
    [newPopups[index], newPopups[newIndex]] = [newPopups[newIndex], newPopups[index]];
    setPopups(newPopups.map((item, idx) => ({ ...item, ordem: idx })));
  };
  const handleSavePopupEdit = (id: string, field: keyof PopupItem, value: any) => setPopups(popups.map(p => p.id === id ? { ...p, [field]: value } : p));

  const handleAddRecado = () => {
    if (!novoRecado.titulo || !novoRecado.conteudo) { alert('Preencha título e conteúdo!'); return; }
    setRecados([...recados, { ...novoRecado, id: Date.now() + '', dataCriacao: new Date().toLocaleDateString('pt-BR'), ativo: true, tempoExibicao: tempoExibicaoRecados }]);
    setNovoRecado({ titulo: '', conteudo: '', avisoimportante: false });
  };
  
  const handleStartEditRecado = (recado: RecadoItem) => {
    setEditingRecadoId(recado.id);
    setEditRecadoForm({ titulo: recado.titulo, conteudo: recado.conteudo });
  };

  const handleSaveEditRecado = () => {
    if (!editingRecadoId) return;
    setRecados(recados.map(r => 
      r.id === editingRecadoId 
        ? { ...r, titulo: editRecadoForm.titulo, conteudo: editRecadoForm.conteudo }
        : r
    ));
    setEditingRecadoId(null);
    setEditRecadoForm({ titulo: '', conteudo: '' });
    alert('✅ Recado editado! Lembre-se de clicar em "Salvar e Publicar".');
  };

  const handleCancelEditRecado = () => {
    setEditingRecadoId(null);
    setEditRecadoForm({ titulo: '', conteudo: '' });
  };

  const handleDeleteRecado = (id: string) => { if (confirm('Excluir?')) setRecados(recados.filter(r => r.id !== id)); };
  const handleToggleAtivoRecado = (id: string) => setRecados(recados.map(r => r.id === id ? { ...r, ativo: !r.ativo } : r));
  const handleToggleAvisoImportanteRecado = (id: string) => setRecados(recados.map(r => r.id === id ? { ...r, avisoimportante: !r.avisoimportante } : r));
  const handleTempoExibicaoRecado = (id: string, tempo: number) => setRecados(recados.map(r => r.id === id ? { ...r, tempoExibicao: tempo } : r));

  const handleUploadArquivo = async (e: React.ChangeEvent<HTMLInputElement>, categoria: ArquivoDownload['categoria']) => {
    const files = e.target.files;
    if (!files || files.length === 0) return;
    
    setUploadingArquivo(true);
    try {
      const novosArquivos = await Promise.all(Array.from(files).map(async (file, i) => {
        const url = await uploadArquivoParaR2(file, categoria);
        return {
          id: Date.now() + i + '',
          nome: file.name,
          url: url,
          categoria: categoria,
          tituloExibicao: file.name.replace(/\.[^/.]+$/, '').replace(/_/g, ' '),
          descricao: '',
          ativo: true,
          dataUpload: new Date().toISOString()
        };
      }));
      setArquivosDownload([...arquivosDownload, ...novosArquivos]);
      alert(`✅ ${novosArquivos.length} arquivo(s) adicionado(s) com sucesso!`);
    } catch (error) {
      console.error('Erro no upload:', error);
      alert('❌ Erro ao fazer upload do arquivo');
    } finally {
      setUploadingArquivo(false);
    }
  };

  const handleDeleteArquivo = (id: string) => {
    if (confirm('Excluir este arquivo permanentemente?')) {
      setArquivosDownload(arquivosDownload.filter(a => a.id !== id));
      alert('✅ Arquivo removido! Lembre-se de clicar em "Salvar e Publicar".');
    }
  };

  const handleToggleAtivoArquivo = (id: string) => {
    setArquivosDownload(arquivosDownload.map(a => 
      a.id === id ? { ...a, ativo: !a.ativo } : a
    ));
  };

  const handleStartEditArquivo = (arquivo: ArquivoDownload) => {
    setEditingArquivoId(arquivo.id);
    setEditArquivoForm({ 
      tituloExibicao: arquivo.tituloExibicao, 
      descricao: arquivo.descricao || '' 
    });
  };

  const handleSaveEditArquivo = () => {
    if (!editingArquivoId) return;
    setArquivosDownload(arquivosDownload.map(a => 
      a.id === editingArquivoId 
        ? { ...a, tituloExibicao: editArquivoForm.tituloExibicao, descricao: editArquivoForm.descricao }
        : a
    ));
    setEditingArquivoId(null);
    setEditArquivoForm({ tituloExibicao: '', descricao: '' });
    alert('✅ Arquivo atualizado! Lembre-se de clicar em "Salvar e Publicar".');
  };

  const handleCancelEditArquivo = () => {
    setEditingArquivoId(null);
    setEditArquivoForm({ tituloExibicao: '', descricao: '' });
  };

  const categoriasDownload = [
    { id: 'pastoral_dizimo', nome: 'Pastoral do Dízimo', icone: Download, cor: 'from-teal-500 to-teal-600' },
    { id: 'secretaria_batismo', nome: 'Secretaria - Batismo', icone: FileText, cor: 'from-blue-500 to-blue-600' },
    { id: 'secretaria_catequese', nome: 'Secretaria - Catequese', icone: FileText, cor: 'from-green-500 to-green-600' },
  ];

  const corClass = (cor: string) => {
    if (cor === 'verde') return 'bg-green-600';
    if (cor === 'branco') return 'bg-gray-200 border border-gray-300';
    if (cor === 'vermelho') return 'bg-red-600';
    if (cor === 'roxo') return 'bg-purple-600';
    return 'bg-pink-500';
  };

  const corBadgeClass = (cor: string) => {
    if (cor === 'verde') return 'bg-green-500/20 text-green-300';
    if (cor === 'branco') return 'bg-gray-200/20 text-gray-300';
    if (cor === 'vermelho') return 'bg-red-500/20 text-red-300';
    if (cor === 'roxo') return 'bg-purple-500/20 text-purple-300';
    return 'bg-pink-500/20 text-pink-300';
  };

  if (loading) return (
    <div className="min-h-screen flex items-center justify-center bg-gray-50">
      <div className="text-center">
        <div className="animate-spin rounded-full h-12 w-12 border-b-2 border-blue-600 mx-auto mb-4"></div>
        <p className="text-gray-600">Verificando autenticação...</p>
      </div>
    </div>
  );

  if (!isAuthenticated) return null;

  const menuItems = [
    { id: 'carrossel-home', label: 'Carrossel', icon: Image, count: fotosCarrossel.filter(f => f.ativo).length },
    { id: 'popup', label: 'Popup', icon: Bell, count: popups.filter(p => p.ativo).length },
    { id: 'momentos-liturgicos', label: 'Momentos', icon: Calendar, count: eventosLiturgicos.filter(e => e.ativo).length },
    { id: 'recados', label: 'Recados', icon: AlertCircle, count: recados.filter(r => r.ativo).length },
    { id: 'horarios-missas', label: 'Horários de Missas', icon: Clock, count: horariosMissas.filter(d => d.ativo).length },
    { id: 'youtube-live', label: 'YouTube AO VIVO', icon: Radio, count: youtubeLiveData?.isLiveNow ? 1 : 0 },
    { id: 'gestao-downloads', label: 'Gestão Downloads', icon: Download, count: arquivosDownload.filter(a => a.ativo).length }
  ];

  return (
    <div className="min-h-screen flex overflow-hidden"
      style={{
        background: perfilAdmin.imagemFundo 
          ? `url('${perfilAdmin.imagemFundo}') center/cover no-repeat fixed`
          : perfilAdmin.corFundo || '#0d2a5c',
        backgroundAttachment: 'fixed'
      }}>
      <div className="fixed inset-0 bg-black/40 z-0"></div>

      {syncing && (
        <div className="fixed top-4 right-4 z-50 bg-blue-600 text-white px-4 py-2 rounded-lg shadow-lg flex items-center gap-2">
          <RefreshCw size={16} className="animate-spin" /> Sincronizando...
        </div>
      )}

      <div className={`${sidebarOpen ? 'w-72' : 'w-16'} bg-gradient-to-b from-[#05142b] to-[#0d2a5c] border-r border-blue-800/30 shadow-xl transition-all duration-300 flex flex-col fixed h-[calc(100vh-4rem)] top-16 left-0 z-40 overflow-y-auto overflow-x-hidden`}>
        <button onClick={() => setSidebarOpen(!sidebarOpen)} className="absolute top-8 right-4 z-50 p-2 rounded-full hover:bg-white/10 transition-colors">
          <ArrowLeft size={20} className={`text-white transition-transform duration-300 ${sidebarOpen ? '' : 'rotate-180'}`} />
        </button>
        
        {sidebarOpen ? (
          <div className="flex items-center gap-2 px-6 pb-4 flex-shrink-0">
            <div className="w-8 h-8 bg-blue-500 rounded-lg flex items-center justify-center"><Settings size={18} className="text-white" /></div>
            <span className="text-white font-bold text-lg">Admin</span>
          </div>
        ) : (
          <div className="w-8 h-8 bg-blue-500 rounded-lg flex items-center justify-center mx-auto mb-4 flex-shrink-0"><Settings size={18} className="text-white" /></div>
        )}
        
        <div className="flex-1 min-h-0">
          <div className="p-5 flex flex-col items-center">
            <div className="relative group mb-4 flex-shrink-0">
              <div className="w-20 h-20 rounded-full bg-gradient-to-br from-blue-400 to-purple-500 flex items-center justify-center text-white text-2xl font-bold shadow-lg overflow-hidden border-4 border-white/20">
                {perfilAdmin.avatar ? <img src={perfilAdmin.avatar} alt={perfilAdmin.nome} className="w-full h-full object-cover" /> : perfilAdmin.nome.split(' ').map(n => n[0]).join('').substring(0, 2).toUpperCase()}
              </div>
              <label className="absolute -bottom-1 -right-1 bg-blue-500 rounded-full p-1.5 cursor-pointer hover:bg-blue-400 transition-colors shadow-lg opacity-0 group-hover:opacity-100">
                <Camera size={12} className="text-white" />
                <input type="file" accept="image/*" onChange={handleAvatarUpload} className="hidden" />
              </label>
            </div>
            
            {sidebarOpen && (
              <div className="text-center w-full mb-4">
                <p className="font-semibold text-white truncate text-lg">{perfilAdmin.nome}</p>
                <p className="text-sm text-blue-300 mb-1">{userProfile.cargo}</p>
                <p className="text-xs text-blue-400 truncate mb-4">{perfilAdmin.email}</p>
                <div className="flex flex-wrap items-center justify-center gap-2 text-sm text-blue-200">
                  <button onClick={() => { setEditProfileForm({ nome: perfilAdmin.nome, email: perfilAdmin.email }); setShowEditProfileModal(true); }} className="hover:text-white transition-colors">Editar Perfil</button>
                  <span className="text-blue-400">/</span>
                  <button onClick={() => setShowChangePasswordModal(true)} className="hover:text-white transition-colors">Alterar Senha</button>
                </div>
                <p className="text-xs text-blue-400/60 mt-2">Última sync: {lastSyncTime}</p>
              </div>
            )}
          </div>
          
          {sidebarOpen && <div className="border-t border-blue-700/50 mx-4 mb-4"></div>}
          
          <nav className="px-4 pb-4 space-y-1">
            {menuItems.map((item, index) => (
              <div key={item.id}>
                <button onClick={() => setActiveTab(item.id as any)}
                  className={`w-full flex items-center gap-3 px-4 py-3 rounded-xl transition-all ${activeTab === item.id ? 'bg-blue-600/30 text-white shadow-lg border border-blue-500/30' : 'text-blue-200 hover:bg-blue-500/20 hover:text-white'} ${!sidebarOpen && 'justify-center px-2'}`}>
                  <div className={`p-2 rounded-lg ${activeTab === item.id ? 'bg-blue-500/40' : 'bg-blue-500/20'}`}>
                    <item.icon size={sidebarOpen ? 18 : 20} className={activeTab === item.id ? 'text-white' : 'text-blue-300'} />
                  </div>
                  {sidebarOpen && (<><span className="flex-1 text-left text-sm font-medium">{item.label}</span><span className="text-xs px-2 py-1 rounded-full bg-blue-500/30 text-white">{item.count}</span></>)}
                </button>
                {sidebarOpen && index < menuItems.length - 1 && <div className="border-t border-blue-700/30 my-1"></div>}
              </div>
            ))}
            <div className="border-t border-blue-700/30 my-1"></div>
            <button onClick={handleLogout}
              className={`w-full flex items-center gap-3 px-4 py-3 rounded-xl transition-all text-red-300 hover:bg-red-500/20 hover:text-red-200 ${!sidebarOpen && 'justify-center px-2'}`}>
              <div className={`p-2 rounded-lg bg-red-500/20`}>
                <LogOut size={sidebarOpen ? 18 : 20} className="text-red-300" />
              </div>
              {sidebarOpen && <span className="flex-1 text-left text-sm font-medium">Sair</span>}
            </button>
          </nav>
        </div>
      </div>

      <div className={`flex-1 transition-all duration-300 ${sidebarOpen ? 'ml-72' : 'ml-16'} relative z-10 overflow-y-auto h-screen`}>
        <main className="container mx-auto px-4 pt-24 pb-32">
          {/* ============================================ */}
          {/* 📸 INSTAGRAM TOKEN CARD - CONTAGEM REGRESSIVA */}
          {/* ============================================ */}
          <div className="bg-gradient-to-r from-purple-900/80 via-pink-900/80 to-red-900/80 backdrop-blur-sm rounded-2xl shadow-xl border border-purple-400/30 p-5 mb-6">
            <div className="flex flex-col md:flex-row md:items-center md:justify-between gap-4">
              <div className="flex items-center gap-3">
                <div className="bg-gradient-to-br from-purple-500 to-pink-500 p-3 rounded-xl shadow-lg">
                  <Instagram size={28} className="text-white" />
                </div>
                <div>
                  <h3 className="text-white font-bold text-lg">Instagram Business</h3>
                  <p className="text-purple-200 text-sm">Token de acesso - renovação automática</p>
                </div>
              </div>
              
              {/* CONTAGEM REGRESSIVA CENTRAL */}
              <div className="text-center bg-black/40 backdrop-blur-sm rounded-xl px-6 py-3 border border-purple-400/30">
                <p className="text-purple-300 text-xs uppercase tracking-wider mb-1">Expira em</p>
                <p className={`text-3xl md:text-4xl font-bold ${diasRestantesContagem !== null && diasRestantesContagem <= 10 ? 'text-red-400 animate-pulse' : 'text-white'}`}>
                  {diasRestantesContagem !== null ? `${diasRestantesContagem} dias` : 'Carregando...'}
                </p>
                <p className="text-purple-300/70 text-xs mt-1">
                  Base: {TOKEN_ACTIVATION_DATE.toLocaleDateString('pt-BR')} → +60 dias
                </p>
              </div>
              
              <div className="flex flex-col items-end gap-2">
                <button
                  onClick={handleRenovarToken}
                  disabled={renovandoToken}
                  className="flex items-center gap-2 px-5 py-2.5 bg-gradient-to-r from-green-600 to-emerald-600 hover:from-green-700 hover:to-emerald-700 text-white rounded-xl font-medium transition-all shadow-lg disabled:opacity-50"
                >
                  {renovandoToken ? (
                    <><RefreshCw size={18} className="animate-spin" /> Renovando...</>
                  ) : (
                    <><RefreshCw size={18} /> Renovar Token Agora</>
                  )}
                </button>
                {tokenMessage && (
                  <div className={`text-sm px-3 py-1.5 rounded-lg ${tokenMessage.type === 'success' ? 'bg-green-500/30 text-green-200' : 'bg-red-500/30 text-red-200'}`}>
                    {tokenMessage.text}
                  </div>
                )}
              </div>
            </div>
            
            {/* Barra de progresso visual */}
            <div className="mt-4">
              <div className="w-full bg-gray-700/50 rounded-full h-2 overflow-hidden">
                <div 
                  className={`h-2 rounded-full transition-all duration-500 ${
                    diasRestantesContagem !== null && diasRestantesContagem <= 10 
                      ? 'bg-red-500' 
                      : diasRestantesContagem !== null && diasRestantesContagem <= 30 
                        ? 'bg-yellow-500' 
                        : 'bg-gradient-to-r from-purple-500 to-pink-500'
                  }`}
                  style={{ width: `${diasRestantesContagem !== null ? (diasRestantesContagem / 60) * 100 : 0}%` }}
                />
              </div>
              <div className="flex justify-between text-xs text-purple-300/70 mt-1">
                <span>Ativado: 22/04/2026</span>
                <span>Próxima renovação automática: ~45 dias</span>
                <span>Expira: 21/06/2026</span>
              </div>
            </div>
          </div>

          <div className="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-7 gap-3 mb-4 mt-2">
            {[
              { label: 'Carrossel Home', count: fotosCarrossel.filter(f => f.ativo).length, total: fotosCarrossel.length },
              { label: 'Popups Ativos', count: popups.filter(p => p.ativo).length, total: popups.length },
              { label: 'Momentos Litúrgicos', count: eventosLiturgicos.filter(e => e.ativo).length, total: eventosLiturgicos.length },
              { label: 'Recados', count: recados.filter(r => r.ativo).length, total: recados.length },
              { label: 'Horários Missas', count: horariosMissas.filter(d => d.ativo).length, total: horariosMissas.length },
              { label: 'YouTube Live', count: youtubeLiveData?.isLiveNow ? 1 : 0, total: 1 },
              { label: 'Downloads', count: arquivosDownload.filter(a => a.ativo).length, total: arquivosDownload.length }
            ].map(card => (
              <div key={card.label} className="bg-white/95 backdrop-blur-sm rounded-lg shadow p-3 border border-white/20">
                <div className="flex flex-col">
                  <p className="text-xs text-gray-500 font-medium truncate">{card.label}</p>
                  <p className="text-xl font-bold text-gray-800">{card.count}<span className="text-xs font-normal text-gray-500 ml-1">/ {card.total}</span></p>
                  <p className="text-[10px] text-gray-500">{card.count} ativo(s)</p>
                </div>
              </div>
            ))}
          </div>

          <div className="bg-white/95 backdrop-blur-sm rounded-xl shadow-lg border-2 border-red-300 p-4 mb-6">
            <div className="flex items-start gap-4">
              <div className="bg-red-50 p-3 rounded-lg flex-shrink-0"><Shield className="text-red-600" size={28} /></div>
              <div className="flex-1">
                <p className="text-red-900 text-sm font-extrabold mb-2 flex items-center gap-2">
                  <span className="w-2 h-2 bg-red-500 rounded-full animate-pulse"></span> LGPD - ATENÇÃO
                </p>
                <p className="text-red-800 text-sm leading-relaxed">
                  Ao publicar fotos no portal, atentar para que não haja exposição indevida de pessoas, em conformidade com a LGPD (Lei nº 13.709/2018, art. 5º, I e art. 6º).
                </p>
              </div>
            </div>
          </div>

          <div className="bg-blue-500/20 border border-blue-400/40 rounded-xl p-4 mb-6 text-white/80 text-sm flex items-start gap-3">
            <Globe size={20} className="text-blue-300 flex-shrink-0 mt-0.5" />
            <span>As alterações são publicadas no servidor ao clicar em <strong>"Salvar e Publicar"</strong>.</span>
          </div>

          <div className="bg-white/10 backdrop-blur-md rounded-xl shadow-lg border border-white/20 p-4 sm:p-8 mb-8">
            {activeTab === 'carrossel-home' && (
              <div>
                <div className="flex justify-between items-center mb-4">
                  <h2 className="text-xl font-bold text-white">Gerenciar Carrossel da Home</h2>
                  <div className={`px-3 py-1 rounded-full text-sm ${fotosCarrossel.length >= LIMITES.CARROSSEL_MAX ? 'bg-red-500/20 text-red-300' : 'bg-green-500/20 text-green-300'}`}>{fotosCarrossel.length}/{LIMITES.CARROSSEL_MAX}</div>
                </div>
                
                <div className="mb-6">
                  <div className="border-2 border-dashed border-blue-300/50 rounded-xl p-6 text-center hover:border-blue-400 bg-blue-500/10">
                    <Upload className="w-5 h-5 text-blue-300 mx-auto mb-3" />
                    <label className={`inline-flex items-center gap-2 px-5 py-2.5 rounded-lg text-sm cursor-pointer transition-colors text-white ${fotosCarrossel.length >= LIMITES.CARROSSEL_MAX ? 'bg-gray-500 cursor-not-allowed opacity-50' : 'bg-blue-600 hover:bg-blue-700'}`}>
                      <Plus size={16} /> Adicionar Imagens ({fotosCarrossel.length}/{LIMITES.CARROSSEL_MAX})
                      <input type="file" multiple accept="image/*" onChange={handleUploadCarrossel} className="hidden" disabled={fotosCarrossel.length >= LIMITES.CARROSSEL_MAX} />
                    </label>
                  </div>
                </div>

                <div className="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-4 gap-4">
                  {fotosCarrossel.map((item, index) => (
                    <div key={item.id} className="border border-white/20 rounded-lg overflow-hidden bg-white/10 group">
                      <div className="relative">
                        <img src={item.imagem} alt={item.titulo} className="w-full h-40 object-cover bg-gray-100" />
                        <div className="absolute top-2 right-2 flex gap-1">
                          <button onClick={() => handleToggleAtivoCarrossel(item.id)} className={`p-1 rounded-full ${item.ativo ? 'bg-green-500' : 'bg-red-500'}`}><Eye size={12} className="text-white" /></button>
                          <button onClick={() => handleDeleteCarrossel(item.id)} className="p-1 bg-red-500 rounded-full"><Trash2 size={12} className="text-white" /></button>
                        </div>
                        <div className="absolute bottom-2 left-2 flex gap-1 opacity-0 group-hover:opacity-100 transition-opacity">
                          {index > 0 && <button onClick={() => handleReorderCarrossel(index, index - 1)} className="p-1 bg-blue-600 rounded text-white"><ChevronLeft size={10} /></button>}
                          {index < fotosCarrossel.length - 1 && <button onClick={() => handleReorderCarrossel(index, index + 1)} className="p-1 bg-blue-600 rounded text-white"><ChevronRight size={10} /></button>}
                        </div>
                      </div>
                      <div className="p-3">
                        <input type="text" value={item.titulo || ''} onChange={(e) => setFotosCarrossel(fotosCarrossel.map(i => i.id === item.id ? { ...i, titulo: e.target.value } : i))}
                          className="w-full text-sm border border-white/20 rounded px-2 py-1 mb-1 bg-white/10 text-white placeholder-white/50" placeholder="Título" />
                        <div className="flex justify-between text-xs text-white/60">
                          <span>Pos: {item.ordem + 1}</span>
                          <span className={item.ativo ? 'text-green-400' : 'text-red-400'}>{item.ativo ? 'Ativo' : 'Inativo'}</span>
                        </div>
                      </div>
                    </div>
                  ))}
                </div>
              </div>
            )}

            {activeTab === 'popup' && (
              <div>
                <div className="flex justify-between items-center mb-4">
                  <h2 className="text-xl font-bold text-white">Gerenciar Popups</h2>
                  <div className={`px-3 py-1 rounded-full text-sm ${popups.length >= LIMITES.POPUP_MAX ? 'bg-red-500/20 text-red-300' : 'bg-green-500/20 text-green-300'}`}>{popups.length}/{LIMITES.POPUP_MAX}</div>
                </div>
                
                <div className="mb-6">
                  <div className="border-2 border-dashed border-blue-300/50 rounded-xl p-8 text-center bg-blue-500/10 max-w-md mx-auto">
                    <Upload className="w-8 h-8 text-blue-300 mx-auto mb-3" />
                    <label className={`inline-flex items-center gap-2 px-6 py-3 rounded-lg text-sm cursor-pointer transition-colors text-white ${popups.length >= LIMITES.POPUP_MAX ? 'bg-gray-500 cursor-not-allowed opacity-50' : 'bg-blue-600 hover:bg-blue-700'}`}>
                      <Plus size={18} /> Upload ({popups.length}/{LIMITES.POPUP_MAX})
                      <input type="file" multiple accept="image/*" onChange={handleUploadPopups} className="hidden" disabled={popups.length >= LIMITES.POPUP_MAX} />
                    </label>
                  </div>
                </div>

                <div className="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
                  {popups.map((popup, index) => (
                    <div key={popup.id} className="border border-white/20 rounded-xl overflow-hidden bg-white/10">
                      <div className="relative h-48 bg-gray-100">
                        <img src={popup.imagem} alt="Popup" className="w-full h-full object-contain" />
                        <div className="absolute top-2 right-2 flex gap-1">
                          <button onClick={() => setEditingPopupId(popup.id === editingPopupId ? null : popup.id)} className="p-1.5 bg-blue-500 rounded-full text-white" title="Editar URL da imagem"><Edit2 size={14} /></button>
                          <button onClick={() => handleToggleAtivoPopup(popup.id)} className={`p-1.5 rounded-full ${popup.ativo ? 'bg-green-500' : 'bg-red-500'} text-white`} title={popup.ativo ? "Desativar Popup" : "Ativar Popup"}>{popup.ativo ? <Eye size={14} /> : <X size={14} />}</button>
                          <button onClick={() => handleDeletePopup(popup.id)} className="p-1.5 bg-red-500 rounded-full text-white" title="Excluir Popup"><Trash2 size={14} /></button>
                        </div>
                        <div className="absolute bottom-2 left-2 flex gap-1">
                          {index > 0 && <button onClick={() => handleReorderPopup(popup.id, 'up')} className="p-1 bg-gray-800/70 rounded text-white" title="Mover para cima"><ChevronLeft size={12} /></button>}
                          {index < popups.length - 1 && <button onClick={() => handleReorderPopup(popup.id, 'down')} className="p-1 bg-gray-800/70 rounded text-white" title="Mover para baixo"><ChevronRight size={12} /></button>}
                        </div>
                        {popup.ativo && <div className="absolute top-2 left-2"><span className="px-2 py-1 bg-green-500 text-white text-xs rounded-full">Ativo</span></div>}
                      </div>
                      <div className="p-4">
                        <div className="flex gap-1 mb-2">
                          {temposExibicao.map(t => (
                            <button key={t.segundos} onClick={() => handleTempoExibicao(popup.id, t.segundos)}
                              className={`flex-1 py-2 text-xs rounded ${popup.tempoExibicao === t.segundos ? 'bg-blue-600 text-white' : 'bg-white/10 text-white/70'}`} title={`Tempo de exibição: ${t.label}`}>{t.label}</button>
                          ))}
                        </div>
                        {editingPopupId === popup.id && (
                          <div className="p-3 bg-blue-500/20 rounded-lg border border-blue-400/30">
                            <input type="text" value={popup.imagem} onChange={(e) => handleSavePopupEdit(popup.id, 'imagem', e.target.value)}
                              className="w-full text-sm border border-white/20 rounded px-2 py-1 mb-2 bg-white/10 text-white" placeholder="URL da imagem" />
                            <button onClick={() => setEditingPopupId(null)} className="w-full py-1.5 bg-blue-600 text-white text-xs rounded">Fechar</button>
                          </div>
                        )}
                      </div>
                    </div>
                  ))}
                </div>
              </div>
            )}

            {activeTab === 'momentos-liturgicos' && (
              <div>
                <div className="bg-white/5 rounded-lg p-4 mb-6 border border-white/10">
                  <h3 className="font-bold text-white/90 mb-3">Novo Momento Litúrgico</h3>
                  <div className="space-y-3">
                    <input type="text" value={novoEventoLiturgico.periodo}
                      onChange={(e) => setNovoEventoLiturgico({ ...novoEventoLiturgico, periodo: e.target.value })}
                      placeholder="Período (ex: Quaresma 2026)"
                      className="w-full p-3 border border-white/20 rounded-lg bg-white/10 text-white placeholder-white/50" />
                    <input type="text" value={novoEventoLiturgico.tituloFaixa}
                      onChange={(e) => setNovoEventoLiturgico({ ...novoEventoLiturgico, tituloFaixa: e.target.value })}
                      placeholder="Título da faixa"
                      className="w-full p-3 border border-white/20 rounded-lg bg-white/10 text-white placeholder-white/50 uppercase"
                      style={{ textTransform: 'uppercase' }} />
                    <div>
                      <label className="block text-sm text-white/70 mb-2">Cor Litúrgica</label>
                      <div className="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-5 gap-2">
                        {coresLiturgicas.map((cor) => (
                          <button key={cor.id} onClick={() => setNovoEventoLiturgico({ ...novoEventoLiturgico, cor: cor.id as any })}
                            className={`flex flex-col items-center gap-1.5 p-2.5 rounded-lg border transition-all ${novoEventoLiturgico.cor === cor.id ? 'ring-2 ring-blue-400 border-blue-300 bg-blue-500/20' : 'border-white/20 hover:bg-white/5'}`}>
                            <div className={`w-full h-2.5 rounded ${corClass(cor.id)}`} />
                            <span className="text-xs text-white/80 text-center leading-tight">{cor.nome}</span>
                          </button>
                        ))}
                      </div>
                    </div>
                    
                    <div className="mt-4 p-4 bg-gradient-to-r from-blue-500/10 to-indigo-500/10 rounded-xl border border-blue-400/30">
                      <div className="flex items-center justify-between mb-3">
                        <div className="flex items-center gap-2">
                          <div className="bg-blue-500/20 rounded-lg p-2">
                            <img src="https://upload.wikimedia.org/wikipedia/commons/1/12/Google_Drive_icon_%282020%29.svg" alt="Drive" className="w-6 h-6" />
                          </div>
                          <div>
                            <label className="text-white/90 font-medium">Google Drive - Mais Fotos</label>
                            <p className="text-xs text-blue-300/60">Ative para mostrar o box "Veja mais fotos" no canto direito da faixa</p>
                          </div>
                        </div>
                        <button
                          onClick={() => setNovoEventoLiturgico({ ...novoEventoLiturgico, mostrarBotaoDrive: !novoEventoLiturgico.mostrarBotaoDrive })}
                          className={`relative inline-flex h-6 w-11 items-center rounded-full transition-colors focus:outline-none ${novoEventoLiturgico.mostrarBotaoDrive ? 'bg-blue-600' : 'bg-gray-600'}`}>
                          <span className={`inline-block h-4 w-4 transform rounded-full bg-white transition-transform ${novoEventoLiturgico.mostrarBotaoDrive ? 'translate-x-6' : 'translate-x-1'}`} />
                        </button>
                      </div>
                      
                      {novoEventoLiturgico.mostrarBotaoDrive && (
                        <div className="mt-3 space-y-2 animate-fadeIn">
                          <label className="block text-xs text-blue-300/80 font-mono">Link da pasta do Google Drive:</label>
                          <div className="flex items-center gap-2">
                            <input
                              type="text"
                              value={novoEventoLiturgico.googleDriveLink || ''}
                              onChange={(e) => setNovoEventoLiturgico({ ...novoEventoLiturgico, googleDriveLink: e.target.value })}
                              placeholder="https://drive.google.com/drive/folders/..."
                              className="flex-1 p-2.5 text-sm bg-white/10 border border-blue-400/30 rounded-xl text-white placeholder-white/40 focus:ring-2 focus:ring-blue-500/50 outline-none"
                            />
                            {novoEventoLiturgico.googleDriveLink && (
                              <a href={novoEventoLiturgico.googleDriveLink} target="_blank" rel="noopener noreferrer" className="p-2.5 bg-blue-500/20 hover:bg-blue-500/30 rounded-xl transition-colors" title="Abrir link no Google Drive">
                                <ExternalLink size={18} className="text-blue-300" />
                              </a>
                            )}
                          </div>
                          <p className="text-xs text-blue-300/60">🔗 Cole o link completo da pasta do Google Drive</p>
                        </div>
                      )}
                    </div>
                    
                    <div className="mt-5 pt-3 border-t border-blue-400/20">
                      <p className="text-xs text-blue-300/60 mb-3 uppercase tracking-wider font-mono flex items-center gap-2">
                        <span className="w-2 h-2 bg-blue-400 rounded-full animate-pulse"></span>
                        👁 PREVIEW — como ficará no site:
                      </p>
                      <FaixaPreview
                        titulo={novoEventoLiturgico.tituloFaixa || 'TÍTULO DA FAIXA'}
                        periodo={novoEventoLiturgico.periodo || 'Período do momento'}
                        cor={novoEventoLiturgico.cor}
                        mostrarDrive={novoEventoLiturgico.mostrarBotaoDrive}
                        driveLink={novoEventoLiturgico.googleDriveLink}
                      />
                    </div>
                    
                    <button onClick={handleAddMomento} className="w-full py-3 bg-blue-600 text-white rounded-lg font-medium hover:bg-blue-700 flex items-center justify-center gap-2">
                      <Plus size={18} /> Adicionar Momento Litúrgico
                    </button>
                  </div>
                </div>

                <h3 className="font-bold text-white/90 mb-3">Momentos ({eventosLiturgicos.length})</h3>

                <div className="space-y-6">
                  {eventosLiturgicos.map((evento) => {
                    const ano = extrairAno(evento.periodo);
                    return (
                      <div key={evento.id} className="border border-white/20 rounded-lg p-4 bg-white/5">
                        <div className="flex justify-between items-start mb-3">
                          <div className="flex-1">
                            <div className="flex justify-between items-center mb-1">
                              <h4 className="font-bold text-white uppercase">{evento.tituloFaixa}</h4>
                              <span className={`text-xs px-2 py-1 rounded-full ${evento.imagens.length >= LIMITES.MOMENTOS_LITURGICOS_MAX_FOTOS ? 'bg-red-500/20 text-red-300' : 'bg-blue-500/20 text-blue-300'}`}>
                                {evento.imagens.length}/{LIMITES.MOMENTOS_LITURGICOS_MAX_FOTOS} fotos
                              </span>
                            </div>
                            <p className="text-sm text-white/70 mb-1">{evento.periodo}</p>
                            <div className="flex items-center gap-2 flex-wrap">
                              <span className={`text-xs px-2 py-1 rounded-full ${evento.ativo ? 'bg-green-500/20 text-green-300' : 'bg-red-500/20 text-red-300'}`}>{evento.ativo ? 'Ativo' : 'Inativo'}</span>
                              <span className={`text-xs px-2 py-1 rounded-full ${corBadgeClass(evento.cor)}`}>Cor: {evento.cor}</span>
                              <span className="text-xs px-2 py-1 rounded-full bg-blue-500/20 text-blue-300">Ano: {ano}</span>
                              {evento.mostrarBotaoDrive && (
                                <span className="text-xs px-2 py-1 rounded-full bg-indigo-500/20 text-indigo-300 flex items-center gap-1">
                                  <img src="https://upload.wikimedia.org/wikipedia/commons/1/12/Google_Drive_icon_%282020%29.svg" alt="" className="w-3 h-3 object-contain" />
                                  Drive ativo
                                </span>
                              )}
                            </div>
                          </div>
                          <div className="flex gap-2 ml-3">
                            {editingDriveId === evento.id ? (
                              <div className="flex gap-1">
                                <button onClick={() => handleSaveDriveEdit(evento.id)} className="p-1.5 bg-green-500 text-white rounded" title="Salvar alterações"><Check size={14} /></button>
                                <button onClick={handleCancelDriveEdit} className="p-1.5 bg-gray-500 text-white rounded" title="Cancelar edição"><X size={14} /></button>
                              </div>
                            ) : (
                              <button onClick={() => handleOpenDriveEdit(evento)} className="p-2 bg-green-500/20 text-green-300 rounded hover:bg-green-500/30" title="Configurar Google Drive">
                                <img src="https://upload.wikimedia.org/wikipedia/commons/1/12/Google_Drive_icon_%282020%29.svg" alt="Drive" className="w-4 h-4" />
                              </button>
                            )}
                            <button onClick={() => { setEditingMomentoId(evento.id); setEditMomentoForm({ periodo: evento.periodo || '', tituloFaixa: evento.tituloFaixa, cor: evento.cor }); }}
                              className="p-2 bg-blue-500/20 text-blue-300 rounded hover:bg-blue-500/30" title="Editar momento"><Edit2 size={16} /></button>
                            <button onClick={() => handleToggleAtivoMomento(evento.id)} className="p-2 bg-blue-500/20 text-blue-300 rounded hover:bg-blue-500/30" title={evento.ativo ? "Desativar momento" : "Ativar momento"}><Eye size={16} /></button>
                            <button onClick={() => handleDeleteMomento(evento.id)} className="p-2 bg-red-500/20 text-red-300 rounded hover:bg-red-500/30" title="Excluir momento"><Trash2 size={16} /></button>
                          </div>
                        </div>

                        {editingDriveId === evento.id && (
                          <div className="mt-3 p-4 bg-blue-500/10 border border-blue-400/30 rounded-lg animate-fadeIn">
                            <div className="flex items-center justify-between mb-3">
                              <div className="flex items-center gap-2">
                                <img src="https://upload.wikimedia.org/wikipedia/commons/1/12/Google_Drive_icon_%282020%29.svg" alt="Drive" className="w-5 h-5" />
                                <label className="text-white/90 font-medium text-sm">Configurar Google Drive</label>
                              </div>
                              <button
                                onClick={() => setEditDriveMostrar(!editDriveMostrar)}
                                className={`relative inline-flex h-6 w-11 items-center rounded-full transition-colors focus:outline-none ${editDriveMostrar ? 'bg-blue-600' : 'bg-gray-600'}`}>
                                <span className={`inline-block h-4 w-4 transform rounded-full bg-white transition-transform ${editDriveMostrar ? 'translate-x-6' : 'translate-x-1'}`} />
                              </button>
                            </div>
                            
                            {editDriveMostrar && (
                              <div className="mt-3 space-y-2">
                                <label className="block text-xs text-blue-300/80 font-mono">Link da pasta do Google Drive:</label>
                                <div className="flex items-center gap-2">
                                  <input
                                    type="text"
                                    value={editDriveLink}
                                    onChange={(e) => setEditDriveLink(e.target.value)}
                                    placeholder="https://drive.google.com/drive/folders/..."
                                    className="flex-1 p-2 text-sm bg-white/10 border border-blue-400/30 rounded-lg text-white placeholder-white/40 focus:ring-2 focus:ring-blue-500/50 outline-none"
                                  />
                                  {editDriveLink && (
                                    <a href={editDriveLink} target="_blank" rel="noopener noreferrer" className="p-2 bg-blue-500/20 hover:bg-blue-500/30 rounded-lg transition-colors" title="Abrir link">
                                      <ExternalLink size={16} className="text-blue-300" />
                                    </a>
                                  )}
                                </div>
                                <p className="text-xs text-blue-300/60">🔗 Cole o link completo da pasta do Google Drive</p>
                              </div>
                            )}
                            <div className="flex justify-end gap-2 mt-3">
                              <button onClick={handleCancelDriveEdit} className="px-3 py-1 bg-gray-600 text-white text-xs rounded hover:bg-gray-500">Cancelar</button>
                              <button onClick={() => handleSaveDriveEdit(evento.id)} className="px-3 py-1 bg-green-600 text-white text-xs rounded hover:bg-green-700">Salvar</button>
                            </div>
                          </div>
                        )}

                        <div className="mb-4">
                          <p className="text-xs text-blue-300/60 mb-2 uppercase tracking-wider font-mono flex items-center gap-2">
                            <span className="w-2 h-2 bg-blue-400 rounded-full animate-pulse"></span>
                            👁 PREVIEW — como aparece no site:
                          </p>
                          <FaixaPreview
                            titulo={evento.tituloFaixa}
                            periodo={evento.periodo}
                            cor={evento.cor}
                            mostrarDrive={evento.mostrarBotaoDrive === true}
                            driveLink={evento.googleDriveLink}
                          />
                        </div>

                        {editingMomentoId === evento.id && (
                          <div className="mt-3 p-4 bg-blue-500/10 border border-blue-400/30 rounded-lg">
                            <div className="grid grid-cols-1 md:grid-cols-2 gap-3 mb-3">
                              <input type="text" value={editMomentoForm.periodo} onChange={(e) => setEditMomentoForm({ ...editMomentoForm, periodo: e.target.value })}
                                className="w-full text-sm border border-white/20 rounded px-2 py-2 bg-white/10 text-white" placeholder="Período" />
                              <input type="text" value={editMomentoForm.tituloFaixa} onChange={(e) => setEditMomentoForm({ ...editMomentoForm, tituloFaixa: e.target.value.toUpperCase() })}
                                className="w-full text-sm border border-white/20 rounded px-2 py-2 bg-white/10 text-white uppercase" placeholder="Título" style={{ textTransform: 'uppercase' }} />
                            </div>
                            <div className="grid grid-cols-3 sm:grid-cols-5 gap-2 mb-3">
                              {coresLiturgicas.map((cor) => (
                                <button key={cor.id} onClick={() => setEditMomentoForm({ ...editMomentoForm, cor: cor.id as any })}
                                  className={`px-3 py-1 rounded-full text-xs font-medium transition-colors ${editMomentoForm.cor === cor.id ? corBadgeClass(cor.id).replace('500/20', '600').replace('300', '100') : 'bg-gray-600 text-gray-300 hover:bg-gray-500'}`}>
                                  {cor.nome}
                                </button>
                              ))}
                            </div>
                            <div className="flex justify-end gap-2">
                              <button onClick={() => setEditingMomentoId(null)} className="px-4 py-2 bg-gray-600 text-white rounded-lg text-sm hover:bg-gray-500">Cancelar</button>
                              <button onClick={handleSalvarEdicaoMomento} className="px-4 py-2 bg-blue-600 text-white rounded-lg text-sm hover:bg-blue-700">Salvar</button>
                            </div>
                          </div>
                        )}

                        <div className="mt-3 p-3 bg-blue-500/10 rounded-lg border border-blue-400/30">
                          <label className="block text-sm text-white/80 mb-2">Adicionar imagens (upload para R2)</label>
                          <div className="border-2 border-dashed border-blue-300/50 rounded-lg p-3 text-center bg-white/5">
                            <label className="cursor-pointer flex flex-col items-center gap-2">
                              <Upload size={20} className="text-blue-300" />
                              <span className="text-sm text-blue-300">Clique para adicionar ao R2</span>
                              <input type="file" multiple accept="image/*" onChange={(e) => handleAddImagemMomento(evento.id, e)} className="hidden" disabled={evento.imagens.length >= LIMITES.MOMENTOS_LITURGICOS_MAX_FOTOS} />
                            </label>
                          </div>
                        </div>

                        {evento.imagens.length > 0 && (
                          <div className="mt-3">
                            <p className="text-sm text-white/80 mb-2">Imagens ({evento.imagens.length}):</p>
                            <div className="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-5 gap-2">
                              {evento.imagens.map((imagem, idx) => (
                                <div key={idx} className="relative border border-white/20 rounded overflow-hidden group">
                                  <img src={imagem} alt={`img ${idx}`} className="w-full h-24 object-cover bg-gray-100" />
                                  <button onClick={() => handleDeleteImagemMomento(evento.id, idx)}
                                    className="absolute top-1 right-1 bg-red-500 text-white rounded-full w-5 h-5 flex items-center justify-center text-xs opacity-0 group-hover:opacity-100 transition-opacity" title="Excluir imagem">×</button>
                                  <div className="absolute bottom-0 left-0 right-0 bg-black/60 text-white text-xs p-1 text-center">{idx + 1}</div>
                                </div>
                              ))}
                            </div>
                          </div>
                        )}
                      </div>
                    );
                  })}
                </div>
              </div>
            )}

            {activeTab === 'recados' && (
              <div>
                <div className="flex justify-between items-center mb-4">
                  <h2 className="text-xl font-bold text-white">Gerenciar Recados</h2>
                  <div className={`px-3 py-1 rounded-full text-sm ${recados.length >= LIMITES.RECADOS_MAX ? 'bg-red-500/20 text-red-300' : 'bg-green-500/20 text-green-300'}`}>{recados.length}/{LIMITES.RECADOS_MAX}</div>
                </div>
                <div className="bg-white/5 rounded-lg p-4 mb-4 border border-white/10">
                  <h3 className="font-bold text-white/90 mb-3">Tempo de exibição padrão</h3>
                  <div className="flex items-center gap-4">
                    <div className="flex gap-2">
                      {[5,10].map(tempo => (
                        <button key={tempo} onClick={() => setTempoExibicaoRecados(tempo)}
                          className={`px-3 py-1 rounded-lg text-sm transition-colors ${tempoExibicaoRecados === tempo ? 'bg-blue-600 text-white' : 'bg-white/10 text-white/70 hover:bg-white/20'}`}>{tempo}s</button>
                      ))}
                    </div>
                  </div>
                </div>
                <div className="bg-white/5 rounded-lg p-4 mb-6 border border-white/10">
                  <h3 className="font-bold text-white/90 mb-3">Novo Recado</h3>
                  <div className="space-y-3">
                    <input type="text" value={novoRecado.titulo} onChange={(e) => setNovoRecado({ ...novoRecado, titulo: e.target.value })}
                      placeholder="Título do recado" className="w-full p-3 border border-white/20 rounded-lg bg-white/10 text-white placeholder-white/50" />
                    <textarea value={novoRecado.conteudo} onChange={(e) => setNovoRecado({ ...novoRecado, conteudo: e.target.value })}
                      placeholder="Conteúdo..." rows={4} className="w-full p-3 border border-white/20 rounded-lg bg-white/10 text-white placeholder-white/50" />
                    <div className="bg-blue-500/20 p-3 rounded-lg border border-blue-400/30">
                      <p className="text-sm text-blue-300 mb-2">📢 Modelo rápido:</p>
                      <button onClick={() => setNovoRecado({ titulo: "Aviso Importante", conteudo: "Missas de Terça à Sexta, a partir de 10/03/2026, serão celebradas as 19hs", avisoimportante: true })}
                        className="text-xs bg-blue-600 hover:bg-blue-700 text-white px-3 py-1.5 rounded transition-colors">Usar este modelo</button>
                    </div>
                    <div className="flex items-center gap-2">
                      <input type="checkbox" id="avisoimportante" checked={novoRecado.avisoimportante || false}
                        onChange={(e) => setNovoRecado({ ...novoRecado, avisoimportante: e.target.checked })} className="w-4 h-4" />
                      <label htmlFor="avisoimportante" className="text-sm text-white/80">
                        <AlertCircle size={14} className="inline mr-1 text-red-400" />
                        Marcar como aviso importante
                      </label>
                    </div>
                    <button onClick={handleAddRecado} disabled={recados.length >= LIMITES.RECADOS_MAX}
                      className={`w-full py-3 rounded-lg font-medium flex items-center justify-center gap-2 ${recados.length >= LIMITES.RECADOS_MAX ? 'bg-gray-500 cursor-not-allowed opacity-50' : 'bg-blue-600 hover:bg-blue-700 text-white'}`}>
                      <Plus size={18} /> Adicionar ({recados.length}/{LIMITES.RECADOS_MAX})
                    </button>
                  </div>
                </div>
                <div className="space-y-4">
                  {recados.map((recado) => (
                    <div key={recado.id} className={`border rounded-lg p-4 ${recado.avisoimportante ? 'bg-red-500/10 border-red-400/30' : 'bg-white/5 border-white/20'}`}>
                      <div className="flex justify-between items-start mb-2">
                        <div>
                          <div className="flex items-center gap-2">
                            <h4 className="font-bold text-white">{recado.titulo}</h4>
                            {recado.avisoimportante && <span className="px-2 py-0.5 bg-red-500 text-white text-xs rounded-full animate-pulse">⚠️ AVISO</span>}
                          </div>
                          <div className="flex items-center gap-2 mt-1">
                            <span className={`text-xs px-2 py-1 rounded-full ${recado.ativo ? 'bg-green-500/20 text-green-300' : 'bg-red-500/20 text-red-300'}`}>{recado.ativo ? 'Ativo' : 'Inativo'}</span>
                            <span className="text-xs text-white/50 flex items-center gap-1"><Clock size={10} />{recado.dataCriacao}</span>
                            <span className="text-xs bg-blue-500/20 text-blue-300 px-2 py-1 rounded-full">{recado.tempoExibicao || 5}s</span>
                          </div>
                        </div>
                        <div className="flex gap-2">
                          <div className="flex gap-1 mr-2">
                            {[5,10].map(t => (
                              <button key={t} onClick={() => handleTempoExibicaoRecado(recado.id, t)}
                                className={`px-1.5 py-0.5 text-xs rounded ${(recado.tempoExibicao || 5) === t ? 'bg-blue-600 text-white' : 'bg-white/10 text-white/60 hover:bg-white/20'}`} title={`Tempo de exibição: ${t}s`}>{t}s</button>
                            ))}
                          </div>
                          {editingRecadoId === recado.id ? (
                            <div className="flex gap-1">
                              <button onClick={handleSaveEditRecado} className="p-1.5 bg-green-500 text-white rounded" title="Salvar edição"><Check size={14} /></button>
                              <button onClick={handleCancelEditRecado} className="p-1.5 bg-gray-500 text-white rounded" title="Cancelar edição"><X size={14} /></button>
                            </div>
                          ) : (
                            <button onClick={() => handleStartEditRecado(recado)} className="p-2 bg-blue-500/20 text-blue-300 rounded hover:bg-blue-500/30" title="Editar recado"><Edit2 size={16} /></button>
                          )}
                          <button onClick={() => handleToggleAvisoImportanteRecado(recado.id)} className={`p-2 rounded ${recado.avisoimportante ? 'bg-blue-500/20 text-blue-300' : 'bg-white/10 text-white/60'}`} title={recado.avisoimportante ? "Remover aviso importante" : "Marcar como aviso importante"}><AlertCircle size={16} /></button>
                          <button onClick={() => handleToggleAtivoRecado(recado.id)} className={`p-2 rounded ${recado.ativo ? 'bg-red-500/20 text-red-300' : 'bg-green-500/20 text-green-300'}`} title={recado.ativo ? "Desativar recado" : "Ativar recado"}><Eye size={16} /></button>
                          <button onClick={() => handleDeleteRecado(recado.id)} className="p-2 bg-red-500/20 text-red-300 rounded" title="Excluir recado"><Trash2 size={16} /></button>
                        </div>
                      </div>
                      {editingRecadoId === recado.id ? (
                        <div className="mt-3 space-y-2">
                          <input
                            type="text"
                            value={editRecadoForm.titulo}
                            onChange={(e) => setEditRecadoForm({ ...editRecadoForm, titulo: e.target.value })}
                            className="w-full p-2 text-sm bg-white/10 border border-blue-400/30 rounded-lg text-white placeholder-white/40"
                            placeholder="Título do recado"
                          />
                          <textarea
                            value={editRecadoForm.conteudo}
                            onChange={(e) => setEditRecadoForm({ ...editRecadoForm, conteudo: e.target.value })}
                            rows={3}
                            className="w-full p-2 text-sm bg-white/10 border border-blue-400/30 rounded-lg text-white placeholder-white/40"
                            placeholder="Conteúdo do recado"
                          />
                        </div>
                      ) : (
                        <p className="text-white/70 text-sm whitespace-pre-line">{recado.conteudo}</p>
                      )}
                    </div>
                  ))}
                  {recados.length === 0 && <p className="text-white/50 text-center py-6">Nenhum recado cadastrado</p>}
                </div>
              </div>
            )}

            {activeTab === 'horarios-missas' && (
              <div className="space-y-6">
                <div className="flex justify-between items-center mb-4">
                  <h2 className="text-xl font-bold text-white flex items-center gap-2"><Clock className="text-blue-400" size={24} /> Horários de Missas</h2>
                  <button onClick={handleResetHorarios} className="px-4 py-2 bg-yellow-600/50 hover:bg-yellow-600/70 text-white rounded-lg text-sm flex items-center gap-2 transition-colors" title="Restaurar horários padrão">
                    <RefreshCw size={16} /> Restaurar Padrão
                  </button>
                </div>
                <div className="grid grid-cols-1 lg:grid-cols-2 gap-4">
                  {DIAS_SEMANA.map((nomeDia) => {
                    const getIdByDia = (dia: string) => {
                      const mapa: Record<string, string> = {
                        'Segunda-Feira': 'segunda',
                        'Terça-Feira': 'terca',
                        'Quarta-Feira': 'quarta',
                        'Quinta-Feira': 'quinta',
                        'Sexta-Feira': 'sexta',
                        'Sábado': 'sabado',
                        'Domingo': 'domingo'
                      };
                      return mapa[dia] || dia.toLowerCase().replace('-feira', '');
                    };
                    
                    const dia = horariosMissas.find(d => d.dia === nomeDia) 
                      || { id: getIdByDia(nomeDia), dia: nomeDia, missas: [], ativo: true };
                    
                    return (
                      <div key={dia.id} className="bg-white/5 rounded-xl border border-white/20 overflow-hidden">
                        <div className="bg-gradient-to-r from-blue-900/50 to-blue-800/30 p-4 flex justify-between items-center">
                          <div className="flex items-center gap-3">
                            <h3 className="text-white font-bold text-lg">{nomeDia}</h3>
                            <button onClick={() => handleToggleAtivoDia(dia.id)} className={`px-2 py-1 rounded-full text-xs ${dia.ativo ? 'bg-green-500/20 text-green-300' : 'bg-red-500/20 text-red-300'}`} title={dia.ativo ? "Desativar este dia" : "Ativar este dia"}>{dia.ativo ? 'Ativo' : 'Inativo'}</button>
                          </div>
                          <button onClick={() => handleAdicionarHorario(dia.id)} className="p-2 bg-blue-600/50 hover:bg-blue-600/70 text-white rounded-lg transition-colors" title="Adicionar horário"><Plus size={16} /></button>
                        </div>
                        <div className="p-4 space-y-3">
                          {dia.missas.length === 0 ? (
                            <p className="text-white/40 text-center py-4 text-sm">Nenhum horário cadastrado</p>
                          ) : (
                            dia.missas.map((missa, idx) => (
                              <div key={missa.id} className="bg-white/10 rounded-lg p-3 border border-white/10">
                                <div className="flex justify-between items-start mb-2">
                                  <div className="flex-1 space-y-2">
                                    <div className="flex items-center gap-2">
                                      <Clock size={14} className="text-blue-400" />
                                      <input type="text" value={missa.hora} onChange={(e) => handleEditarHorario(dia.id, missa.id, 'hora', e.target.value)}
                                        className="bg-white/10 border border-white/20 rounded px-2 py-1 text-white text-sm w-24" placeholder="00h00" title="Horário da missa" />
                                    </div>
                                    <input type="text" value={missa.tipo || ''} onChange={(e) => handleEditarHorario(dia.id, missa.id, 'tipo', e.target.value)}
                                      className="w-full bg-white/10 border border-white/20 rounded px-2 py-1 text-white text-sm"
                                      placeholder={missa.youtube ? "Tema da missa" : "Descrição (opcional)"} title="Descrição do horário" />
                                    <label className="flex items-center gap-2 text-sm text-white/70 cursor-pointer">
                                      <input type="checkbox" checked={missa.youtube || false} onChange={(e) => {
                                        handleEditarHorario(dia.id, missa.id, 'youtube', e.target.checked);
                                        if (!e.target.checked) handleEditarHorario(dia.id, missa.id, 'youtubeLink', '');
                                      }} className="w-4 h-4" />
                                      <span className="flex items-center gap-1">É transmissão ao vivo? <Radio size={14} className="text-red-400" /></span>
                                    </label>
                                    {missa.youtube && (
                                      <div className="flex items-center gap-2">
                                        <Radio size={16} className="text-red-400 flex-shrink-0" />
                                        <input type="text" value={missa.youtubeLink || ''} onChange={(e) => handleEditarHorario(dia.id, missa.id, 'youtubeLink', e.target.value)}
                                          className="w-full bg-white/10 border border-blue-500/30 rounded px-2 py-1 text-white text-sm" placeholder="Link do YouTube" title="Link da transmissão ao vivo" />
                                      </div>
                                    )}
                                  </div>
                                  <button onClick={() => handleRemoverHorario(dia.id, missa.id)} className="p-1.5 bg-red-500/20 hover:bg-red-500/40 text-red-300 rounded-lg transition-colors ml-2" title="Remover horário"><Trash2 size={14} /></button>
                                </div>
                                {idx < dia.missas.length - 1 && <div className="border-t border-white/10 my-2"></div>}
                              </div>
                            ))
                          )}
                        </div>
                      </div>
                    );
                  })}
                </div>
              </div>
            )}

            {activeTab === 'youtube-live' && (
              <div className="space-y-6">
                <div className="flex justify-between items-center mb-4">
                  <h2 className="text-xl font-bold text-white flex items-center gap-2"><Radio className="text-red-400" size={24} /> YouTube AO VIVO</h2>
                  <div className={`px-3 py-1 rounded-full text-sm ${youtubeLiveData?.isLiveNow ? 'bg-green-500/20 text-green-300 animate-pulse' : 'bg-gray-500/20 text-gray-300'}`}>
                    {youtubeLiveData?.isLiveNow ? '🔴 LIVE ATIVA' : 'Sem live'}
                  </div>
                </div>
                {youtubeLiveData?.isLiveNow && (
                  <div className="bg-gradient-to-r from-red-900/40 to-red-800/20 rounded-xl p-6 border border-red-500/30">
                    <h3 className="text-white font-bold mb-4 flex items-center gap-2"><span className="w-2 h-2 bg-red-500 rounded-full animate-pulse"></span> LIVE ATIVA</h3>
                    
                    {isEditingLive ? (
                      <div className="bg-black/40 rounded-xl p-5 mb-4 border border-yellow-500/30">
                        <div className="flex items-center gap-2 mb-3">
                          <Edit2 size={18} className="text-yellow-400" />
                          <span className="text-yellow-400 font-medium">Editando link da live</span>
                        </div>
                        <input
                          type="text"
                          value={editingLiveUrl}
                          onChange={(e) => setEditingLiveUrl(e.target.value)}
                          placeholder="https://youtube.com/live/VIDEO_ID ou https://youtu.be/VIDEO_ID"
                          className="w-full p-3 bg-white/10 border border-yellow-500/30 rounded-lg text-white placeholder-white/40 focus:ring-2 focus:ring-yellow-500 outline-none mb-3"
                        />
                        <div className="flex gap-3">
                          <button
                            onClick={handleSaveLiveEdit}
                            disabled={youtubeLiveLoading}
                            className="px-5 py-2 bg-green-600 hover:bg-green-700 text-white rounded-lg font-medium transition-colors flex items-center gap-2"
                          >
                            {youtubeLiveLoading ? (<><div className="animate-spin rounded-full h-4 w-4 border-2 border-white border-t-transparent" />Salvando...</>) : (<><Check size={18} />Salvar Alterações</>)}
                          </button>
                          <button
                            onClick={handleCancelLiveEdit}
                            className="px-5 py-2 bg-gray-600 hover:bg-gray-700 text-white rounded-lg font-medium transition-colors flex items-center gap-2"
                          >
                            <X size={18} /> Cancelar
                          </button>
                        </div>
                      </div>
                    ) : (
                      <div className="flex flex-col lg:flex-row gap-6">
                        <div className="lg:w-64 flex-shrink-0">
                          <img src={youtubeLiveData.thumbnail} alt={youtubeLiveData.title} className="w-full rounded-lg shadow-lg border-2 border-red-500/50"
                            onError={(e) => { (e.target as HTMLImageElement).src = `https://img.youtube.com/vi/${youtubeLiveData.videoId}/mqdefault.jpg`; }} />
                        </div>
                        <div className="flex-1 space-y-3">
                          <div><p className="text-red-300 text-xs mb-1">TÍTULO</p><p className="text-white font-medium">{youtubeLiveData.title}</p></div>
                          <div><p className="text-red-300 text-xs mb-1">ID DO VÍDEO</p><p className="text-white font-mono text-sm bg-black/30 px-3 py-1.5 rounded-lg inline-block">{youtubeLiveData.videoId}</p></div>
                          <div><p className="text-red-300 text-xs mb-1">LINK</p><a href={youtubeLiveData.link} target="_blank" rel="noopener noreferrer" className="text-blue-400 hover:text-blue-300 underline text-sm break-all">{youtubeLiveData.link}</a></div>
                          <div className="flex gap-3 pt-2">
                            <button onClick={handleEditLive} className="px-5 py-2.5 bg-yellow-600 hover:bg-yellow-700 text-white rounded-lg font-medium transition-colors flex items-center gap-2" title="Editar link da live">
                              <Edit2 size={18} /> Editar Live
                            </button>
                            <button onClick={handleRemoverLive} className="px-5 py-2.5 bg-red-600 hover:bg-red-700 text-white rounded-lg font-medium transition-colors flex items-center gap-2" title="Remover live atual">
                              <X size={18} /> Remover Live
                            </button>
                          </div>
                        </div>
                      </div>
                    )}
                  </div>
                )}
                <div className="bg-white/5 rounded-xl p-6 border border-white/10">
                  <h3 className="text-white font-bold mb-4">{youtubeLiveData?.isLiveNow ? 'Substituir live existente' : 'Ativar nova live'}</h3>
                  <div className="space-y-4">
                    <input 
                      type="text" 
                      value={youtubeLiveUrl} 
                      onChange={(e) => setYoutubeLiveUrl(e.target.value)}
                      placeholder="https://youtube.com/live/VIDEO_ID ou https://youtu.be/VIDEO_ID"
                      className="w-full p-3 bg-white/10 border border-white/20 rounded-lg text-white placeholder-white/40 focus:ring-2 focus:ring-blue-500 outline-none" 
                    />
                    <div className="flex gap-3">
                      <button 
                        onClick={handleSalvarLive} 
                        disabled={youtubeLiveLoading || !youtubeLiveUrl}
                        className="px-6 py-2.5 bg-gradient-to-r from-green-600 to-emerald-600 hover:from-green-700 hover:to-emerald-700 text-white rounded-lg font-medium transition-colors disabled:opacity-50 flex items-center gap-2" 
                        title="Ativar live no site"
                      >
                        {youtubeLiveLoading ? (<><div className="animate-spin rounded-full h-4 w-4 border-2 border-white border-t-transparent" />Ativando...</>) : (<><Radio size={18} />{youtubeLiveData?.isLiveNow ? 'Substituir Live' : 'Ativar Live'}</>)}
                      </button>
                    </div>
                    <p className="text-xs text-blue-300/60 mt-2">
                      💡 Dica: Cole o link completo da live (ex: https://youtube.com/live/VIDEO_ID ou https://youtu.be/VIDEO_ID)
                    </p>
                  </div>
                </div>
              </div>
            )}

            {activeTab === 'gestao-downloads' && (
              <div className="space-y-8">
                <div className="flex justify-between items-center mb-4">
                  <h2 className="text-xl font-bold text-white flex items-center gap-2"><Download size={24} className="text-green-400" /> Gestão de Downloads</h2>
                  <div className="px-3 py-1 rounded-full text-sm bg-green-500/20 text-green-300">{arquivosDownload.filter(a => a.ativo).length}/{arquivosDownload.length} ativos</div>
                </div>

                <div className="bg-blue-500/10 border border-blue-400/30 rounded-lg p-4 mb-4">
                  <p className="text-white/80 text-sm flex items-center gap-2">
                    <FolderOpen size={18} className="text-blue-400" />
                    Gerencie os arquivos disponíveis para download nas páginas <strong>Pastorais</strong> e <strong>Secretaria</strong>. 
                    Faça upload de novos arquivos, edite os títulos e ative/desative conforme necessário.
                  </p>
                </div>

                {categoriasDownload.map(categoria => {
                  const arquivosCategoria = arquivosDownload.filter(a => a.categoria === categoria.id);
                  const IconCat = categoria.icone;
                  
                  return (
                    <div key={categoria.id} className="bg-white/5 rounded-xl border border-white/20 overflow-hidden">
                      <div className={`bg-gradient-to-r ${categoria.cor} p-4`}>
                        <div className="flex items-center justify-between flex-wrap gap-3">
                          <div className="flex items-center gap-3">
                            <div className="p-2 bg-white/20 rounded-lg">
                              <IconCat size={20} className="text-white" />
                            </div>
                            <h3 className="text-white font-bold text-lg">{categoria.nome}</h3>
                            <span className="px-2 py-1 bg-white/20 text-white text-xs rounded-full">{arquivosCategoria.length} arquivo(s)</span>
                          </div>
                          <div className="relative">
                            <label className={`inline-flex items-center gap-2 px-4 py-2 rounded-lg text-sm cursor-pointer transition-colors text-white ${uploadingArquivo ? 'bg-gray-500 opacity-50' : 'bg-white/20 hover:bg-white/30'}`}>
                              <Upload size={16} /> Upload
                              <input 
                                type="file" 
                                multiple 
                                accept=".pdf,.doc,.docx,.xls,.xlsx" 
                                onChange={(e) => handleUploadArquivo(e, categoria.id as ArquivoDownload['categoria'])} 
                                className="hidden" 
                                disabled={uploadingArquivo}
                              />
                            </label>
                          </div>
                        </div>
                      </div>
                      
                      <div className="p-4">
                        {arquivosCategoria.length === 0 ? (
                          <p className="text-white/40 text-center py-6 text-sm">Nenhum arquivo cadastrado nesta categoria.</p>
                        ) : (
                          <div className="space-y-3">
                            {arquivosCategoria.map(arquivo => (
                              <div key={arquivo.id} className="bg-white/10 rounded-lg p-4 border border-white/10">
                                <div className="flex flex-col sm:flex-row justify-between items-start gap-3">
                                  <div className="flex-1 min-w-0">
                                    {editingArquivoId === arquivo.id ? (
                                      <div className="space-y-2">
                                        <input
                                          type="text"
                                          value={editArquivoForm.tituloExibicao}
                                          onChange={(e) => setEditArquivoForm({ ...editArquivoForm, tituloExibicao: e.target.value })}
                                          className="w-full p-2 text-sm bg-white/20 border border-blue-400/30 rounded-lg text-white placeholder-white/40"
                                          placeholder="Título para exibição"
                                        />
                                        <input
                                          type="text"
                                          value={editArquivoForm.descricao}
                                          onChange={(e) => setEditArquivoForm({ ...editArquivoForm, descricao: e.target.value })}
                                          className="w-full p-2 text-sm bg-white/20 border border-blue-400/30 rounded-lg text-white placeholder-white/40"
                                          placeholder="Descrição (opcional)"
                                        />
                                        <div className="flex gap-2">
                                          <button onClick={handleSaveEditArquivo} className="px-3 py-1.5 bg-green-600 text-white text-xs rounded-lg hover:bg-green-700">Salvar</button>
                                          <button onClick={handleCancelEditArquivo} className="px-3 py-1.5 bg-gray-600 text-white text-xs rounded-lg hover:bg-gray-700">Cancelar</button>
                                        </div>
                                      </div>
                                    ) : (
                                      <>
                                        <p className="text-white font-medium truncate">{arquivo.tituloExibicao}</p>
                                        {arquivo.descricao && <p className="text-white/50 text-xs truncate">{arquivo.descricao}</p>}
                                        <p className="text-white/30 text-xs mt-1 font-mono truncate">{arquivo.nome}</p>
                                        <p className="text-white/30 text-xs">Upload: {new Date(arquivo.dataUpload).toLocaleDateString('pt-BR')}</p>
                                      </>
                                    )}
                                  </div>
                                  <div className="flex items-center gap-2 flex-shrink-0">
                                    <a 
                                      href={arquivo.url} 
                                      target="_blank" 
                                      rel="noopener noreferrer"
                                      className="p-2 bg-blue-500/20 text-blue-300 rounded-lg hover:bg-blue-500/30 transition-colors"
                                      title="Visualizar/Testar download"
                                    >
                                      <Download size={16} />
                                    </a>
                                    <button 
                                      onClick={() => handleStartEditArquivo(arquivo)}
                                      className="p-2 bg-yellow-500/20 text-yellow-300 rounded-lg hover:bg-yellow-500/30 transition-colors"
                                      title="Editar informações"
                                    >
                                      <Edit2 size={16} />
                                    </button>
                                    <button 
                                      onClick={() => handleToggleAtivoArquivo(arquivo.id)}
                                      className={`p-2 rounded-lg transition-colors ${arquivo.ativo ? 'bg-green-500/20 text-green-300 hover:bg-green-500/30' : 'bg-red-500/20 text-red-300 hover:bg-red-500/30'}`}
                                      title={arquivo.ativo ? "Desativar download" : "Ativar download"}
                                    >
                                      {arquivo.ativo ? <Eye size={16} /> : <EyeOff size={16} />}
                                    </button>
                                    <button 
                                      onClick={() => handleDeleteArquivo(arquivo.id)}
                                      className="p-2 bg-red-500/20 text-red-300 rounded-lg hover:bg-red-500/30 transition-colors"
                                      title="Excluir arquivo"
                                    >
                                      <Trash2 size={16} />
                                    </button>
                                  </div>
                                </div>
                                <div className="mt-2 flex items-center gap-2">
                                  <span className={`text-xs px-2 py-0.5 rounded-full ${arquivo.ativo ? 'bg-green-500/20 text-green-300' : 'bg-red-500/20 text-red-300'}`}>
                                    {arquivo.ativo ? 'Ativo' : 'Inativo'}
                                  </span>
                                  {!arquivo.ativo && (
                                    <span className="text-xs text-yellow-400/70">Este arquivo não aparece no site</span>
                                  )}
                                </div>
                              </div>
                            ))}
                          </div>
                        )}
                      </div>
                    </div>
                  );
                })}

                <div className="bg-yellow-500/10 border border-yellow-500/30 rounded-lg p-4">
                  <p className="text-yellow-300 text-sm flex items-center gap-2">
                    <AlertCircle size={18} />
                    <strong>Importante:</strong> Após adicionar, editar ou remover arquivos, clique em <strong>"Salvar e Publicar"</strong> para que as alterações sejam aplicadas no site.
                  </p>
                </div>
              </div>
            )}
          </div>
        </main>

        <div className="fixed bottom-0 left-0 right-0 bg-transparent p-4 z-30" style={{ marginLeft: sidebarOpen ? '18rem' : '4rem' }}>
          <div className="container mx-auto flex items-center justify-center gap-4">
            <button onClick={salvarEPublicar} disabled={saveStatus === 'saving'}
              className="inline-flex items-center gap-3 px-8 py-3 bg-gradient-to-r from-green-600 to-emerald-600 text-white rounded-lg font-bold hover:from-green-700 hover:to-emerald-700 transition-all shadow-lg disabled:opacity-70">
              {saveStatus === 'saving' ? (<><div className="animate-spin rounded-full h-5 w-5 border-b-2 border-white"></div>Publicando...</>)
                : saveStatus === 'published' ? (<><Check size={20} />Publicado!</>)
                : (<><Globe size={20} />Salvar e Publicar no Site</>)}
            </button>
            {saveError && <span className="text-red-300 text-sm">{saveError}</span>}
          </div>
        </div>

        <div className="h-20"></div>

        {/* MODAL Editar Perfil */}
        {showEditProfileModal && (
          <div className="fixed inset-0 z-50 flex items-center justify-center p-4 bg-black/80 backdrop-blur-sm">
            <div className="bg-gradient-to-r from-gray-900 to-[#0d2a5c] rounded-2xl max-w-md w-full p-6 border border-blue-500/30 shadow-xl">
              <div className="flex justify-between items-center mb-4">
                <h3 className="text-xl font-bold text-white">Editar Perfil</h3>
                <button onClick={() => setShowEditProfileModal(false)}><X size={24} className="text-white/60 hover:text-white" /></button>
              </div>
              <div className="space-y-4">
                <input type="text" value={editProfileForm.nome} onChange={(e) => setEditProfileForm({ ...editProfileForm, nome: e.target.value })} placeholder="Nome" className="w-full p-3 bg-white/10 border border-white/20 rounded-lg text-white placeholder-white/50" />
                <input type="email" value={editProfileForm.email} onChange={(e) => setEditProfileForm({ ...editProfileForm, email: e.target.value })} placeholder="Email" className="w-full p-3 bg-white/10 border border-white/20 rounded-lg text-white placeholder-white/50" />
                <button onClick={handleSaveProfile} className="w-full py-3 bg-blue-600 hover:bg-blue-700 text-white rounded-lg font-medium transition-colors">Salvar Alterações</button>
              </div>
            </div>
          </div>
        )}

        {/* MODAL Alterar Senha */}
        {showChangePasswordModal && (
          <div className="fixed inset-0 z-50 flex items-center justify-center p-4 bg-black/80 backdrop-blur-sm">
            <div className="bg-gradient-to-r from-gray-900 to-[#0d2a5c] rounded-2xl max-w-md w-full p-6 border border-blue-500/30 shadow-xl">
              <div className="flex justify-between items-center mb-4">
                <h3 className="text-xl font-bold text-white">Alterar Senha</h3>
                <button onClick={() => setShowChangePasswordModal(false)}><X size={24} className="text-white/60 hover:text-white" /></button>
              </div>
              <div className="space-y-4">
                <div className="relative">
                  <input type={showCurrentPassword ? "text" : "password"} value={passwordForm.current} onChange={(e) => setPasswordForm({ ...passwordForm, current: e.target.value })} placeholder="Senha atual" className="w-full p-3 pr-12 bg-white/10 border border-white/20 rounded-lg text-white placeholder-white/50" />
                  <button type="button" onClick={() => setShowCurrentPassword(!showCurrentPassword)} className="absolute right-3 top-1/2 -translate-y-1/2 text-white/60 hover:text-white"><Eye size={20} /></button>
                </div>
                <div className="relative">
                  <input type={showNewPassword ? "text" : "password"} value={passwordForm.new} onChange={(e) => setPasswordForm({ ...passwordForm, new: e.target.value })} placeholder="Nova senha" className="w-full p-3 pr-12 bg-white/10 border border-white/20 rounded-lg text-white placeholder-white/50" />
                  <button type="button" onClick={() => setShowNewPassword(!showNewPassword)} className="absolute right-3 top-1/2 -translate-y-1/2 text-white/60 hover:text-white"><Eye size={20} /></button>
                </div>
                <div className="relative">
                  <input type={showConfirmPassword ? "text" : "password"} value={passwordForm.confirm} onChange={(e) => setPasswordForm({ ...passwordForm, confirm: e.target.value })} placeholder="Confirmar nova senha" className="w-full p-3 pr-12 bg-white/10 border border-white/20 rounded-lg text-white placeholder-white/50" />
                  <button type="button" onClick={() => setShowConfirmPassword(!showConfirmPassword)} className="absolute right-3 top-1/2 -translate-y-1/2 text-white/60 hover:text-white"><Eye size={20} /></button>
                </div>
                <button onClick={handleChangePassword} className="w-full py-3 bg-blue-600 hover:bg-blue-700 text-white rounded-lg font-medium transition-colors">Alterar Senha</button>
              </div>
            </div>
          </div>
        )}

        <footer className="border-t border-white/20 bg-white/5 backdrop-blur-sm py-4 relative z-10 mb-20">
          <div className="container mx-auto px-4 text-center text-white/60 text-sm">
            <p>© {new Date().getFullYear()} Santuário de Fátima — Sistema Administrativo</p>
            <p className="text-xs text-white/40 mt-1">Acessado por: {perfilAdmin.nome} | Última sync: {lastSyncTime}</p>
          </div>
        </footer>
      </div>

      <style>{`
        @keyframes fadeIn {
          from { opacity: 0; transform: translateY(-5px); }
          to { opacity: 1; transform: translateY(0); }
        }
        .animate-fadeIn {
          animation: fadeIn 0.2s ease-out;
        }
        ::-webkit-scrollbar { width: 8px; height: 8px; }
        ::-webkit-scrollbar-track { background: rgba(255,255,255,0.1); border-radius: 4px; }
        ::-webkit-scrollbar-thumb { background: rgba(59,130,246,0.5); border-radius: 4px; }
        ::-webkit-scrollbar-thumb:hover { background: rgba(59,130,246,0.7); }
        * { scrollbar-width: thin; scrollbar-color: rgba(59,130,246,0.5) rgba(255,255,255,0.1); }
      `}</style>
    </div>
  );
}