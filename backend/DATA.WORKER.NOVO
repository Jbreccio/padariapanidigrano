function getHorarioSecretariaAviso() {
  const hoje = /* @__PURE__ */ new Date();
  const diaSemana = hoje.getDay();
  const horaAtual = hoje.getHours();
  const feriados = [
    "01-01",
    "25-01",
    "21-04",
    "01-05",
    "09-07",
    "07-09",
    "12-10",
    "02-11",
    "15-11",
    "20-11",
    "25-12"
  ];
  const hojeStr = `${String(hoje.getDate()).padStart(2, "0")}-${String(hoje.getMonth() + 1).padStart(2, "0")}`;
  if (diaSemana === 0 || diaSemana === 1 || feriados.includes(hojeStr)) {
    return {
      ativo: true,
      mensagem: "A Secretaria Paroquial n\xE3o funciona \xE0s segundas-feiras, domingos e feriados. Os e-mails s\xE3o respondidos de ter\xE7a a s\xE1bado."
    };
  }
  if (horaAtual < 9 || horaAtual >= 17) {
    return {
      ativo: true,
      mensagem: "Fora do hor\xE1rio de funcionamento (9h \xE0s 17h, ter\xE7a a s\xE1bado). Sua mensagem ser\xE1 respondida no pr\xF3ximo dia \xFAtil."
    };
  }
  return { ativo: false };
}
__name(getHorarioSecretariaAviso, "getHorarioSecretariaAviso");

// src/routes/auth/login.js
async function loginUser(usuario, senha, env, ctx) {
  try {
    const user = await env.DB.prepare(
      "SELECT id, nome, email, senha_hash, twofa_enabled, role FROM users WHERE email = ?"
    ).bind(usuario).first();
    if (!user) return { success: false, error: "Usu\xE1rio n\xE3o encontrado" };
    if (senha !== user.senha_hash) return { success: false, error: "Senha incorreta" };
    if (user.role === "fiel") {
      const token = btoa(JSON.stringify({
        id: user.id,
        nome: user.nome,
        email: user.email,
        role: user.role,
        exp: Date.now() + 24 * 60 * 60 * 1e3
      }));
      return { success: true, token, user: { id: user.id, nome: user.nome, email: user.email, role: user.role } };
    }
    if (user.twofa_enabled === 1) {
      const codigo2FA = Math.floor(1e5 + Math.random() * 9e5).toString();
      const expiraEm2 = Date.now() + 5 * 60 * 1e3;
      await env.AUTH_KV.put(`2fa:${user.id}`, JSON.stringify({ codigo: codigo2FA, expira: expiraEm2 }), { expirationTtl: 300 });
      await send2FAEmail(env, user.email, codigo2FA, user.nome);
      return { success: true, step: "2fa", userId: user.id, message: "C\xF3digo 2FA enviado" };
    }
    const pinEmail = Math.floor(1e3 + Math.random() * 9e3).toString();
    const expiraEm = Date.now() + 5 * 60 * 1e3;
    await env.AUTH_KV.put(`pin:${user.id}`, JSON.stringify({ pin: pinEmail, expira: expiraEm }), { expirationTtl: 300 });
    ctx.waitUntil(sendPINEmail(env, user.email, pinEmail, user.nome));
    return { success: true, step: "pin", userId: user.id, message: "PIN enviado" };
  } catch (error) {
    console.error("Erro em loginUser:", error);
    return { success: false, error: "Erro interno" };
  }
}
__name(loginUser, "loginUser");
async function verify2FAUser(userId, codigo2FA, env, ctx) {
  try {
    const stored = await env.AUTH_KV.get(`2fa:${userId}`, "json");
    if (!stored) return { success: false, error: "C\xF3digo 2FA n\xE3o encontrado" };
    if (stored.codigo !== codigo2FA) return { success: false, error: "C\xF3digo 2FA inv\xE1lido" };
    if (stored.expira < Date.now()) return { success: false, error: "C\xF3digo 2FA expirado" };
    const pinEmail = Math.floor(1e3 + Math.random() * 9e3).toString();
    const expiraEm = Date.now() + 5 * 60 * 1e3;
    await env.AUTH_KV.put(`pin:${userId}`, JSON.stringify({ pin: pinEmail, expira: expiraEm }), { expirationTtl: 300 });
    const user = await env.DB.prepare("SELECT id, nome, email FROM users WHERE id = ?").bind(userId).first();
    await sendPINEmail(env, user.email, pinEmail, user.nome);
    await env.AUTH_KV.delete(`2fa:${userId}`);
    return { success: true, step: "pin", userId, message: "PIN enviado" };
  } catch (error) {
    return { success: false, error: "Erro na verifica\xE7\xE3o 2FA" };
  }
}
__name(verify2FAUser, "verify2FAUser");
async function verifyPINUser(userId, pin, env) {
  try {
    const stored = await env.AUTH_KV.get(`pin:${userId}`, "json");
    if (!stored) return { success: false, error: "PIN n\xE3o encontrado" };
    if (stored.pin !== pin) return { success: false, error: "PIN inv\xE1lido" };
    if (stored.expira < Date.now()) return { success: false, error: "PIN expirado" };
    const user = await env.DB.prepare("SELECT id, nome, email, role FROM users WHERE id = ?").bind(userId).first();
    const token = btoa(JSON.stringify({
      id: user.id,
      nome: user.nome,
      email: user.email,
      role: user.role,
      exp: Date.now() + 24 * 60 * 60 * 1e3
    }));
    await env.AUTH_KV.delete(`pin:${userId}`);
    return { success: true, token, user: { id: user.id, nome: user.nome, email: user.email, role: user.role } };
  } catch (error) {
    return { success: false, error: "Erro na verifica\xE7\xE3o PIN" };
  }
}
__name(verifyPINUser, "verifyPINUser");
async function registerUser(userData, env, ctx) {
  try {
    const { nome, email, senha } = userData;
    const existing = await env.DB.prepare("SELECT id FROM users WHERE email = ?").bind(email).first();
    if (existing) return { success: false, error: "Email j\xE1 cadastrado" };
    const id = crypto.randomUUID();
    await env.DB.prepare(`
      INSERT INTO users (id, nome, email, senha_hash, role, status, created_at)
      VALUES (?, ?, ?, ?, 'fiel', 'ativo', datetime('now'))
    `).bind(id, nome, email, senha).run();
    return { success: true, message: "Cadastro realizado com sucesso!" };
  } catch (error) {
    return { success: false, error: "Erro no registro" };
  }
}
