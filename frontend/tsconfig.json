{
  "compilerOptions": {
    "target": "ES2020",
    "useDefineForClassclienteds": true,

    "lib": ["ES2020", "DOM", "DOM.Iterable"],

    "module": "ESNext",
    "moduleResolution": "bundler",

    "jsx": "react-jsx",

    "strict": true,
    "noImplicitAny": false,

    "skipLibCheck": true,
    "isolatedModules": true,
    "resolveJsonModule": true,

    "noEmit": true,

    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"]
    }
  },
  "include": ["src"]
}